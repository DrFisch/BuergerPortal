{
  "ConnectionStrings": {
    "DefaultConnection": "Server=buergerportal-sql,1433;Database=AuthServerDb;User Id=sa;Password=<aus-der-Umgebung>;TrustServerCertificate=True;"
  },
  {
    "OpenIddict": {
      "Issuer": "https://auth.gortisbuergerportal.de",
      "Clients": {
        "mvc_web": {
          "ClientSecret": "<WEB_CLIENT_SECRET-aus-der-Umgebung>",
          "RedirectUris": [
            "https://portal.gortisbuergerportal.de/signin-oidc"
          ],
          "PostLogoutRedirectUris": [
            "https://portal.gortisbuergerportal.de/signout-callback-oidc"
          ]
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
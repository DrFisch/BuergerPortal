@using AuthenticationServer.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @* Konto-Verwaltung gibt es nicht mehr (Anmeldung nur über BundID); Name aus der BundID-Sitzung *@
    var displayName = string.Join(" ", new[] { User.FindFirst("given_name")?.Value, User.FindFirst("family_name")?.Value }
        .Where(s => !string.IsNullOrEmpty(s)));
    <li class="nav-item">
        <span class="nav-link text-dark">Angemeldet: @(displayName.Length > 0 ? displayName : User.Identity?.Name)</span>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Mit BundID anmelden</a>
    </li>
}
</ul>

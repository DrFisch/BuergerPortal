<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BürgerPortal Auth</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        /* Zentriert alles absolut in der Mitte */
        body {
            background-color: #f0f2f5; /* Helles Grau wie bei modernen Apps */
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }
        .auth-card {
            width: 100%;
            max-width: 450px; /* Breite der Karte */
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        /* breite Karte für Seiten mit Tabellen (SAML-Inspektor) */
        .auth-card.auth-card-breit {
            max-width: 1140px;
        }
        .inspektor-tabelle th, .inspektor-tabelle td {
            min-width: 7rem;
        }
        .inspektor-xml {
            white-space: pre-wrap;
            word-break: break-all;
            max-height: 36rem;
            overflow: auto;
        }
        /* Schalter „Zeilen umbrechen“ aus: lange Zeilen bleiben ganz, waagrecht scrollen (Plan A6) */
        .inspektor-xml-rahmen:has(#inspektor-umbruch:not(:checked)) .inspektor-xml {
            white-space: pre;
            word-break: normal;
        }
        /* SAML-Inspektor auf dem Handy: jede Zeile als Karte, Werte mit Beschriftung aus data-label (Plan A6) */
        @@media (max-width: 767.98px) {
            .inspektor-tabelle thead {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0 0 0 0);
                white-space: nowrap;
            }
            .inspektor-tabelle, .inspektor-tabelle tbody {
                display: block;
            }
            .inspektor-tabelle tr {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: .35rem .75rem;
                padding: .75rem;
                margin-bottom: .75rem;
                border: 1px solid var(--bs-border-color);
                border-radius: .75rem;
            }
            .table.inspektor-tabelle > :not(caption) > * > * {
                display: block;
                min-width: 0;
                padding: 0;
                border-bottom-width: 0;
                box-shadow: none;
            }
            .inspektor-tabelle td:not(.inspektor-haken), .inspektor-tabelle tr > th:first-child {
                grid-column: 1 / -1;
            }
            .inspektor-tabelle td[data-label]::before {
                content: attr(data-label);
                display: block;
                font-size: .75rem;
                font-weight: 600;
                color: var(--bs-secondary-color);
            }
            .inspektor-tabelle tbody tr > th:first-child {
                font-weight: 600 !important;
            }
        }
        /* schmale Handys: weniger Rand um die Karte, mehr Platz für Inhalt */
        @@media (max-width: 575.98px) {
            body {
                padding: 8px;
            }
        }
        .auth-header {
            background-color: #fff;
            padding: 20px 20px 0 20px;
        }
        .nav-pills .nav-link {
            color: #6c757d;
            font-weight: 500;
            border-radius: 0;
            border-bottom: 3px solid transparent;
        }
        .nav-pills .nav-link.active {
            background-color: transparent;
            color: #0d6efd; /* Primärfarbe */
            border-bottom: 3px solid #0d6efd;
        }
    </style>
</head>
<body>
    <div class="auth-card@(ViewData["Breit"] is true ? " auth-card-breit" : "")">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
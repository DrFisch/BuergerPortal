@model BundIdErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}

<div class="auth-header">
    <h3 class="text-center mb-2">@Model.Title</h3>
</div>

<div class="p-4 pt-2">
    <div class="alert alert-warning" role="alert">@Model.Message</div>
    <a class="w-100 btn btn-lg btn-primary mb-2" href="@Model.RetryUrl">Erneut mit BundID anmelden</a>
    <a class="w-100 btn btn-outline-secondary" href="@Model.CancelUrl">Abbrechen und zurück</a>
</div>

@page
@model LoginModel

@{
    ViewData["Title"] = "Anmelden";
}

<div class="auth-header">
    <h3 class="text-center mb-4">BürgerPortal</h3>
    
    <ul class="nav nav-pills nav-fill mb-3">
        <li class="nav-item">
            <a class="nav-link active" href="#">Anmelden</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrieren</a>
        </li>
    </ul>
</div>

<div class="p-4 pt-2">
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email">E-Mail Adresse</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
            <label asp-for="Input.Password">Passwort</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Angemeldet bleiben
                </label>
            </div>
            <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">Passwort vergessen?</a>
        </div>

        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">Einloggen</button>
        
        <div class="text-center">
             <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small text-muted">Bestätigungs-E-Mail erneut senden</a>
        </div>
    </form>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <hr class="my-4">
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="text-center">
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="btn btn-outline-secondary w-100 mb-2" name="provider" value="@provider.Name">
                    Mit @provider.DisplayName anmelden
                </button>
            }
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model LoginModel

@{
    ViewData["Title"] = "Anmelden";
}

<div class="auth-header">
    <h3 class="text-center mb-4">BürgerPortal</h3>
</div>

<div class="p-4 pt-2">
    <p class="text-muted">
        Die Anmeldung erfolgt über die <strong>BundID</strong>, das zentrale Nutzerkonto des Bundes.
        Ein eigenes Passwort für das BürgerPortal brauchen Sie nicht. Beim ersten Login wird Ihr Konto
        automatisch angelegt.
    </p>
    <a id="bundid-login" class="w-100 btn btn-lg btn-primary mb-3"
       href="/bundid/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">Mit BundID anmelden</a>
    <p class="small text-muted mb-0">
        Hinweis: In dieser Studienumgebung übernimmt ein BundID-Simulator mit fiktiven Testpersonen die Rolle der BundID.
    </p>
</div>

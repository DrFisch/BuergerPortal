# Reverse Proxy für das BürgerPortal mit BundID-Simulator (Studienprojekt).
# Basis-Domain aus BPSIM_DOMAIN, z. B. bpsimulation.gortisbuergerportal.de (lokal: bpsimulation.localhost).
# Zertifikate holt Caddy automatisch: öffentlich bei Let's Encrypt, für *.localhost von seiner internen CA.
{
	email {$ACME_EMAIL}
}

(sicherheit) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Portal (Web)
{$BPSIM_DOMAIN} {
	import sicherheit
	reverse_proxy web:8080
}

# Auth-Server: OIDC für das Portal, SAML-Service-Provider gegenüber der BundID (/bundid/acs, /bundid/metadata)
auth.{$BPSIM_DOMAIN} {
	import sicherheit
	reverse_proxy auth:8080
}

# BundID-Simulator (Identity Provider) und unter /postfach das BundID-Postfach (Simulation) – wie bei der echten
# BundID ist das Postfach Teil des BundID-Auftritts. Je nach BPSIM_POSTFACH antwortet das Postfach im Simulator
# (postfach-simulator) oder der eigene Postfach-Dienst (postfach-dienst); Ziel aus BPSIM_POSTFACH_UPSTREAM.
bundid.{$BPSIM_DOMAIN} {
	import sicherheit
	@actuator path /actuator /actuator/*
	@api path /api /api/*
	@postfachapi path /postfach/api /postfach/api/*
	@postfach path /postfach /postfach/*
	# route: Reihenfolge wie geschrieben – erst sperren, dann Postfach, sonst Simulator.
	route {
		# Der Spring-Actuator des Simulators ist ungeschützt (env, beans, loggers sogar schreibbar) – von außen sperren.
		respond @actuator 404
		# Nachrichten einliefern (POST /api/v1/messages) nur im internen Netz – beim Simulator wie beim Postfach-Dienst
		respond @api 404
		respond @postfachapi 404
		reverse_proxy @postfach {$BPSIM_POSTFACH_UPSTREAM}
		reverse_proxy bundid-simulator:8080
	}
}

# Frühere Adresse des Postfachs: dauerhaft auf die Startadresse des Postfachs umleiten. Ohne den alten Pfad – den
# kennt nur der Postfach-Dienst, nicht das Postfach im Simulator (Standard).
postkorb.{$BPSIM_DOMAIN} {
	import sicherheit
	redir https://bundid.{$BPSIM_DOMAIN}/postfach/ permanent
}

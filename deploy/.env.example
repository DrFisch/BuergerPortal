# Vorlage für deploy/.env – Werte für den Betrieb. Die echte .env gehört NIE ins Repository (siehe .gitignore).
# Zufallswerte z. B. mit:  openssl rand -base64 32   bzw. in PowerShell:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))

# Basis-Domain; daraus entstehen auth.<domain>, bundid.<domain>, postkorb.<domain>
BPSIM_DOMAIN=bpsimulation.gortisbuergerportal.de
# Kontaktadresse für Let's Encrypt (Ablaufwarnungen der Zertifikate)
ACME_EMAIL=

# Image-Versionen (deploy.ps1 setzt den Tag)
BPSIM_TAG=latest
BUNDID_SIM_IMAGE=bpsim-bundid-simulator:latest

# SQL Server (Benutzer sa): mind. 8 Zeichen mit Groß-, Kleinbuchstaben und Ziffern; kein Semikolon
# (das Passwort steht in Verbindungszeichenfolgen)
SQL_SA_PASSWORD=
# Puffer-Cache von SQL Server in MB und Speicherlimit des Containers
SQL_MEMORY_LIMIT_MB=1024
SQL_MEM_LIMIT=2g

# Passwort des Signaturschlüssels des BundID-Simulators (mind. 6 Zeichen; Schlüssel entsteht beim ersten Start)
BUNDID_SIM_KEYSTORE_PASSWORD=

# Passwort der OpenIddict-Zertifikate in secrets/oidc/signing.pfx und encryption.pfx
OIDC_CERT_PASSWORD=

# Gemeinsames Geheimnis zwischen Portal (Web) und Auth-Server für den OIDC-Client mvc_web
WEB_CLIENT_SECRET=

# Schlüssel, mit dem die API Nachrichten in die Postkorb-Simulation einliefert (mind. 32 Zeichen)
POSTKORB_API_KEY=
# Postfach-Variante: "simulator" = Postfach im simulierten BundID-Konto (BundID-Simulator, Standard),
# "dienst" = eigener Postfach-Dienst (zweiter SAML-SP mit Single Sign-on). Umschalten: deploy/postfach-modus.ps1
BPSIM_POSTFACH=simulator

# Content-Security-Policy (Schutz vor eingeschleusten Skripten, Clickjacking): "Content-Security-Policy" setzt die Regeln
# durch (Standard), "Content-Security-Policy-Report-Only" meldet Verstöße nur in der Browser-Konsole. Gilt für alle Hosts.
BPSIM_CSP_HEADER=Content-Security-Policy

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Simulation für ein Studienprojekt: nicht in Suchmaschinen aufnehmen. *@
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] – Mein BundID-Postfach (Simulation)</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="~/">Mein BundID-Postfach <span class="badge bg-warning text-dark ms-1">Simulation</span></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="d-flex align-items-center gap-3" method="post" asp-controller="BundId" asp-action="Logout">
                    <span class="navbar-text">@User.Identity.Name</span>
                    <button type="submit" class="btn btn-sm btn-outline-light">Abmelden</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-light" asp-controller="BundId" asp-action="Login" asp-route-returnUrl="~/Postfach">Mit BundID anmelden</a>
            }
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <footer class="container border-top py-3 small text-muted">
        Simulation für ein Studienprojekt – kein echtes Postfach der BundID. Alle Personen sind fiktive Testpersonen
        des BundID-Simulators; bitte keine echten Daten verwenden.
        <a asp-controller="Home" asp-action="Hinweise">Hinweise zu Simulation und Datenschutz</a>
    </footer>
</body>
</html>

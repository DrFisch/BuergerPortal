@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    ViewData["Title"] = T["Title"];
}


<div class="py-4">
    <div class="row align-items-center g-3 mb-4">
        <div class="col-12 col-lg">
            <h1 class="h3 mb-2">@T["AppTitle"]</h1>
            <p class="text-muted mb-0">@T["AppLead"]</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <!-- Termine -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_Appointments"]</h5>
                        <i class="bi bi-calendar3-range fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">@T["Card_Appointments_Text"]</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Termine" asp-action="Buchen" class="btn btn-primary">
                            <i class="bi bi-calendar-plus me-1"></i> @T["BookAppointment"]
                        </a>
                        <a asp-controller="Termine" asp-action="Index" class="btn btn-outline-secondary">
                            @T["Overview"]
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-transparent small text-muted">@T["Card_NotifyPwa_Foot"]</div>
            </div>
        </div>

        <!-- Anträge -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_Applications"]</h5>
                        <i class="bi bi-file-earmark-text fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted mb-3">@T["Card_Applications_Text"]</p>
                    <a asp-controller="Antraege" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-right-circle me-1"></i> @T["GoToMyApplications"]
                    </a>
                </div>
                <div class="card-footer bg-transparent small text-muted">@T["Card_Applications_Foot"]</div>
            </div>
        </div>

        <!-- Benachrichtigungen / PWA -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_NotifyPwa"]</h5>
                        <i class="bi bi-bell fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">@T["Card_NotifyPwa_Text"]</p>
                    <button id="enablePush" class="btn btn-success w-100 mb-2">@T["EnablePush"]</button>
                    <div id="pushStatus" class="small text-muted mb-3"></div>
                    <button id="btnInstall" class="btn btn-primary w-100 d-none" onclick="installApp()">
                        @T["InstallApp"]
                    </button>
                    <div id="installStatus" class="small text-muted mt-2"></div>
                </div>
                <div class="card-footer bg-transparent small text-muted">@T["Card_NotifyPwa_Foot"]</div>
            </div>
        </div>

        <!-- Dokumente -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_Documents"]</h5>
                        <i class="bi bi-files fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">@T["Card_Documents_Text"]</p>
                    <a href="#" class="btn btn-outline-secondary">@T["ShowChecklists"]</a>
                </div>
            </div>
        </div>

        <!-- Einstellungen -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_Settings"]</h5>
                        <i class="bi bi-sliders2 fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">@T["Card_Settings_Text"]</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">@T["GoToSettings"]</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hinweise -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">@T["Card_Hints"]</h5>
                        <i class="bi bi-info-circle fs-4 opacity-50"></i>
                    </div>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li>@T["Hint_Peak"]</li>
                        <li>@T["Hint_Documents"]</li>
                        <li>@T["Hint_Access"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


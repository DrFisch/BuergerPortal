@{
    ViewData["Title"] = "Startseite";
}

<div class="py-4">
    <div class="row align-items-center g-3 mb-4">
        <div class="col-12 col-lg">
            <h1 class="h3 mb-2">Bürgerportal</h1>
            <p class="text-muted mb-0">Termine buchen, Antragsstatus prüfen, Benachrichtigungen verwalten und mehr.</p>
        </div>
        <div class="col-12 col-lg-auto">
            <form method="get" action="#" class="d-flex gap-2">
                <input class="form-control" type="search" placeholder="Suche nach Dienst, Vorgangsnummer …" aria-label="Suche">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Suchen</button>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <!-- Termine -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Termine</h5>
                        <i class="bi bi-calendar3-range fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">Freie Zeitfenster finden, buchen, umbuchen oder absagen.</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Home" asp-action="Termine" class="btn btn-primary">Termin buchen</a>
                        <a href="#" class="btn btn-outline-secondary">Übersicht</a>
                    </div>
                </div>
                <div class="card-footer bg-transparent small text-muted">Nächste freie Slots heute und morgen</div>
            </div>
        </div>

        <!-- Antragsstatus -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Antragsstatus</h5>
                        <span class="badge bg-info">Neu</span>
                    </div>
                    <p class="card-text text-muted">Status mit Vorgangsnummer oder E-Mail prüfen.</p>
                    <form class="d-flex gap-2" onsubmit="return false;">
                        <input class="form-control" placeholder="Vorgangsnummer" />
                        <button class="btn btn-outline-secondary">Prüfen</button>
                    </form>
                </div>
                <div class="card-footer bg-transparent small text-muted">Letzte Aktualisierung wird angezeigt</div>
            </div>
        </div>

        <!-- Benachrichtigungen -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Benachrichtigungen</h5>
                        <i class="bi bi-bell fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">Termin-Erinnerungen per Push aktivieren.</p>
                    <button id="enablePush" class="btn btn-success">Push-Benachrichtigungen aktivieren</button>
                    <div id="pushStatus" class="small text-muted mt-2"></div>
                </div>
                <div class="card-footer bg-transparent small text-muted">Erinnert vor Terminen und bei Statusänderungen</div>
            </div>
        </div>

        <!-- Dokumente -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Dokumente</h5>
                        <i class="bi bi-files fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">Benötigte Unterlagen je Dienst als Checkliste.</p>
                    <a href="#" class="btn btn-outline-secondary">Checklisten ansehen</a>
                </div>
            </div>
        </div>

        <!-- Einstellungen (nur Link auf Settings-Seite) -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Einstellungen</h5>
                        <i class="bi bi-sliders2 fs-4 opacity-50"></i>
                    </div>
                    <p class="card-text text-muted">Sprache, Designmodus und Datenschutz verwalten.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <!-- nur Weiterleitung -->
                        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">Zur Settings-Seite</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hinweise -->
        <div class="col">
            <div class="card feature-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="card-title mb-0">Hinweise</h5>
                        <i class="bi bi-info-circle fs-4 opacity-50"></i>
                    </div>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li>• Spitzenzeiten: 8–10 Uhr</li>
                        <li>• Bitte Ausweis und Unterlagen mitbringen</li>
                        <li>• Barrierefreier Zugang vorhanden</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


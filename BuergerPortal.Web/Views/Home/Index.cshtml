                @* <div class="d-flex flex-wrap gap-2 mb-4">
                    <a asp-controller="Termine" asp-action="Buchen" class="btn btn-primary btn-lg">
                        <i class="bi bi-calendar-plus me-1"></i> @T["BookAppointment"]
                    </a>
                    <a asp-controller="Antraege" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-file-earmark-text me-1"></i> @T["GoToMyApplications"]
                    </a>
                </div> *@

                <div class="d-flex flex-wrap gap-3 small text-muted">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>@T["Hero_PrivacyShort"]</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-phone"></i>
                        <span>@T["Hero_PwaShort"]</span>

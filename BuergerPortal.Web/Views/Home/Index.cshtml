@model BuergerPortal.Web.Features.Home.ViewModels.HomeIndexVm
@using BuergerPortal.Web.Extensions
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LF
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = T["Title"];
    var postfachUrl = Config["Postkorb:PostfachUrl"];
}

@* Kein zweiter .container: _Layout setzt schon einen (doppelter Rand auf dem Handy, Plan A5) *@
<div class="pb-2">

    @* Hinweis „als App installieren“ als schmale Leiste: Text, Knopf, Schließen = „Später“ (wwwroot/pwa-install.js) *@
    <div id="pwaInlineInstallAlert" class="d-none alert alert-info border-0 rounded-4 shadow-sm mb-3 py-2 px-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-phone-vibrate text-primary" aria-hidden="true"></i>
            <span class="fw-medium small flex-grow-1">@T["PWA_Inline_Short"]</span>
            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-pwa-install>
                @T["PWA_Install_Short"]
            </button>
            <button type="button" class="btn-close" data-pwa-spaeter aria-label="@T["PWA_Later"]"></button>
        </div>
    </div>

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 p-1">

                <div class="d-flex align-items-center gap-3 text-center text-md-start flex-column flex-md-row">
                    <div class="bg-warning bg-opacity-25 text-warning-emphasis rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading h6 fw-bold mb-1 text-warning-emphasis">
                            @T["Alert_LoginRequired_Title"]
                        </h5>
                        <p class="mb-0 small text-muted">
                            @T["Alert_LoginRequired_Text"]
                        </p>
                    </div>
                </div>

                <div class="w-100 w-md-auto">
                    <a class="btn btn-primary d-block d-md-inline-block rounded-pill px-4 fw-semibold shadow-sm"
                       asp-controller="Account"
                       asp-action="Login">
                        <i class="bi bi-shield-lock me-2"></i> @T["Login"]
                    </a>
                </div>

            </div>
        </div>
    }

    <!-- HERO-BEREICH -->
    <section class="hero rounded-4 shadow-sm mb-4 p-3 p-md-5 position-relative overflow-hidden">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">

                <p class="text-uppercase fw-semibold small text-primary mb-1">
                    @T["CityNameShort"] · @T["DigitalServices"]
                </p>

                <h1 class="display-6 fw-semibold mb-2">
                    @T["AppTitle"]
                </h1>

                @* Auf dem Handy nur Titel und nächster Termin – die Schnellzugriffe sollen ohne Scrollen sichtbar sein (Plan A5) *@
                <p class="lead mb-4 text-muted d-none d-md-block">
                    @T["AppLead"]
                </p>

                @* <div class="d-flex flex-wrap gap-2 mb-4">
                    <a asp-controller="Termine" asp-action="Buchen" class="btn btn-primary btn-lg">
                        <i class="bi bi-calendar-plus me-1"></i> @T["BookAppointment"]
                    </a>
                    <a asp-controller="Antraege" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-file-earmark-text me-1"></i> @T["GoToMyApplications"]
                    </a>
                </div> *@

                <div class="d-none d-md-flex flex-wrap gap-3 small text-muted">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>@T["Hero_PrivacyShort"]</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-phone"></i>
                        <span>@T["Hero_PwaShort"]</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-stats rounded-4 p-3">
                    <!-- Nächster Termin -->
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="small text-muted">
                                @T["Hero_Stat_NextAppointment"]
                            </div>

                            @if (Model?.NextAppointment is not null)
                            {
                                <div class="fw-semibold">
                                    @T["Hero_NextAppointment_When", Model.NextAppointment.Datum.ToString("dd.MM.yyyy"), Model.NextAppointment.Uhrzeit]
                                </div>
                                @if (!string.IsNullOrEmpty(Model.NextAppointment.Uhrzeit))
                                {
                                    <div class="small">
                                    </div>
                                }
                                <div class="small text-muted">
                                    @T["Hero_NextAppointment_Location", Model.NextAppointment.Location.ToDisplay()]<br />
                                    @T["Hero_NextAppointment_Service", Model.NextAppointment.Service.ToDisplayName(LF)]
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted">
                                    @T["Hero_Stat_NextAppointment_None"]
                                </div>
                            }
                        </div>

                        <i class="bi bi-calendar3-range fs-3 opacity-50"></i>
                    </div>
                    <a asp-controller="Termine" asp-action="Index" class="small d-inline-block py-1">@T["Hero_Stat_AllAppointments"] →</a>

                    @*<hr />

                     <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            @T["Hero_Stat_NextAppointment_Hint"]
                        </div>
                        <a asp-controller="Termine" asp-action="Index" class="small">
                            @T["Hero_Stat_NextAppointment_Link"]
                        </a>
                    </div> *@
                </div>
            </div>
        </div>
    </section>

    @* Handy: Schnellzugriffe als Raster direkt unter dem Kopfbereich (Plan A5). „Mangel melden“ steht vorn, weil es seit
       E-022 keinen eigenen Tab mehr hat. Am Computer übernehmen die Karten weiter unten. *@
    <section class="d-md-none mb-4" aria-labelledby="schnellzugriffeHandy">
        <h2 class="h6 text-uppercase text-body-secondary mb-2" id="schnellzugriffeHandy">@T["Section_Shortcuts"]</h2>
        <div class="row row-cols-3 g-2">
            <div class="col">
                <a class="bp-schnellzugriff" asp-controller="Maengel" asp-action="Create">
                    <i class="bi bi-exclamation-octagon text-danger" aria-hidden="true"></i><span>@T["Quick_ReportIssue"]</span>
                </a>
            </div>
            <div class="col">
                <a class="bp-schnellzugriff" asp-controller="Termine" asp-action="Buchen">
                    <i class="bi bi-calendar-plus text-primary" aria-hidden="true"></i><span>@T["Quick_BookAppointment"]</span>
                </a>
            </div>
            <div class="col">
                <a class="bp-schnellzugriff" asp-controller="Antraege" asp-action="Index">
                    <i class="bi bi-file-earmark-plus text-success" aria-hidden="true"></i><span>@T["Quick_Apply"]</span>
                </a>
            </div>
            <div class="col">
                <a class="bp-schnellzugriff" asp-controller="MeineDaten" asp-action="Index">
                    <i class="bi bi-person-vcard text-primary" aria-hidden="true"></i><span>@T["Quick_MyData"]</span>
                </a>
            </div>
            <div class="col">
                @if (!string.IsNullOrWhiteSpace(postfachUrl))
                {
                    <a class="bp-schnellzugriff" href="@postfachUrl" data-sim-hinweis="postfach">
                        <i class="bi bi-envelope-paper text-primary" aria-hidden="true"></i><span>@T["Quick_Mailbox"]</span>
                    </a>
                }
                else
                {
                    <a class="bp-schnellzugriff" asp-controller="Maengel" asp-action="Index">
                        <i class="bi bi-card-checklist text-primary" aria-hidden="true"></i><span>@T["Quick_MyReports"]</span>
                    </a>
                }
            </div>
            <div class="col">
                <a class="bp-schnellzugriff" asp-controller="Entdecken" asp-action="Index">
                    <i class="bi bi-compass text-info" aria-hidden="true"></i><span>@T["Quick_Discover"]</span>
                </a>
            </div>
        </div>
    </section>

    @* <!-- LETZTE AKTIVITÄTEN (nur wenn eingeloggt) -->
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <section class="mb-4">
            <div class="card recent-card border-0 rounded-4 shadow-sm">

                <!-- Header mit Toggle -->
                <div class="recent-header d-flex justify-content-between align-items-center px-3 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history"></i>
                        <span class="fw-semibold">@T["Section_Recent"]</span>
                    </div>

                    <button class="btn btn-sm btn-outline-light recent-toggle-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#recentCollapse"
                            aria-expanded="true"
                            aria-controls="recentCollapse">
                        <span class="me-1">@T["Toggle"]</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>

                <!-- Inhalt -->
                <div class="collapse show" id="recentCollapse">
                    <div class="card-body">

                        <ul class="list-unstyled mb-0 small">

                            <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <div class="fw-semibold">@T["Recent_Item_Passport"]</div>
                                    <div class="text-muted">@T["Recent_Item_Passport_Sub"]</div>
                                </div>
                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis">
                                    @T["Status_InProgress"]
                                </span>
                            </li>

                            <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <div class="fw-semibold">@T["Recent_Item_BulkWaste"]</div>
                                    <div class="text-muted">@T["Recent_Item_BulkWaste_Sub"]</div>
                                </div>
                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                    @T["Status_Completed"]
                                </span>
                            </li>

                            <li class="d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold">@T["Recent_Item_Appointment"]</div>
                                    <div class="text-muted">@T["Recent_Item_Appointment_Sub"]</div>
                                </div>
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                    @T["Status_Upcoming"]
                                </span>
                            </li>

                        </ul>

                        <div class="text-end mt-3">
                            <a asp-controller="Antraege" asp-action="Status" class="small">
                                @T["ShowAll"]
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    } *@


    <!-- FEATURE-KARTEN / SCHNELLZUGRIFFE -->
    <section>
        @* Überschrift und Untertitel auf dem Handy untereinander (stießen vorher zusammen, Befund B5); auf dem Handy
           heißt der Bereich „Mehr für Sie“, weil die Schnellzugriffe schon oben stehen *@
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-1 mb-3">
            <h2 class="h5 mb-0">
                <span class="d-none d-md-inline">@T["Section_Shortcuts"]</span><span class="d-md-none">@T["Section_More"]</span>
            </h2>
            <span class="small text-muted d-none d-md-inline">@T["Section_Shortcuts_Lead"]</span>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

            @* Termine, Anträge, Mängelmelder und Entdecken: auf dem Handy schon in den Schnellzugriffen oben *@
            <!-- Termine -->
            <div class="col d-none d-md-block">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-primary-subtle text-primary mb-3">
                            <i class="bi bi-calendar3-range"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Appointments"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_Appointments_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Termine" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                @T["Overview"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Anträge -->
            <div class="col d-none d-md-block">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-success-subtle text-success mb-3">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Applications"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_Applications_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Antraege" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                @T["GoToMyApplications"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mängelmelder -->
            <div class="col d-none d-md-block">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-danger-subtle text-danger mb-3">
                            <i class="bi bi-exclamation-octagon"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_ReportIssue"]</h5>
                        <p class="card-text text-muted mb-0">
                            @T["Card_ReportIssue_Text"]
                        </p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Maengel" asp-action="Create" class="btn btn-outline-primary btn-sm">
                                @T["Card_ReportIssue_Button"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Stadt entdecken -->
            <div class="col d-none d-md-block">
                <div class="card feature-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-info-subtle text-info mb-3">
                            <i class="bi bi-compass"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Explore_Title"]</h5>
                        <p class="card-text text-muted mb-0">
                            @T["Card_Explore_Description"]
                        </p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Entdecken" asp-action="Index" class="btn btn-outline-info btn-sm">
                                @T["Card_Explore_Button"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Benachrichtigungen / PWA -->
            <div class="col" id="pwaInstallCard" style="display: none;">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-success-subtle text-success mb-3">
                            <i class="bi bi-download"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Install_Title"]</h5>
                        <p class="card-text text-muted mb-3">@T["Card_Install_Description"]</p>

                        <div class="mt-auto">
                            <button class="btn btn-success btn-sm w-100 rounded-pill fw-semibold shadow-sm"
                                    type="button"
                                    data-pwa-install>
                                <i class="bi bi-plus-circle me-1"></i> @T["Settings_Install_Button"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dokumente -->
            @* <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-info-subtle text-info mb-3">
                            <i class="bi bi-files"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Documents"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_Documents_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a href="#" class="btn btn-outline-primary btn-sm">@T["ShowChecklists"]</a>
                        </div>
                    </div>
                </div>
            </div> *@


            <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-warning-subtle text-warning mb-3">
                            <i class="bi bi-cloud-sun"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Weather_Title"]</h5>

                        @if (Model.Weather != null)
                        {
                            <div class="d-flex align-items-center gap-3 my-2">
                                <i class="bi @Model.Weather.IconClass fs-1 text-primary"></i>
                                <div>
                                    <span class="display-6 fw-bold">@Model.Weather.Temperature°C</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="card-text text-muted mb-0">@T["Weather_Unavailable"]</p>
                        }

                        <div class="mt-auto pt-3">
                            <span class="small text-muted">
                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i> @T["Weather_Source"]
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stadtplan -->
            @* <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-primary-subtle text-primary mb-3">
                            <i class="bi bi-compass"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Cityplan"]</h5>
                        <p class="card-text text-muted mb-0">@T["Cityplan_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="Stadtplan" class="btn btn-outline-primary btn-sm">
                                @T["Show_Cityplan"]
                            </a>
                        </div>
                    </div>
                </div>
            </div> *@

            <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-info-subtle text-info mb-3">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Locations_Title"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_Locations_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="Standorte" class="btn btn-outline-primary btn-sm">
                                @T["Show_Opening_Hours"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-success-subtle text-success mb-3">
                            <i class="bi bi-newspaper"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_News_Title"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_News_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="News" class="btn btn-outline-primary btn-sm">
                                @T["Show_News"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- BundID: Meine Daten und Postfach -->
            <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-primary-subtle text-primary mb-3">
                            @await Html.PartialAsync("_BundIdSymbol", new ViewDataDictionary(ViewData) { ["Size"] = 22 })
                        </div>
                        <h5 class="card-title mb-1">@T["Card_BundId_Title"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_BundId_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="MeineDaten" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                @T["Card_BundId_MyData"]
                            </a>
                            @if (!string.IsNullOrWhiteSpace(postfachUrl))
                            {
                                <a href="@postfachUrl" data-sim-hinweis="postfach" class="btn btn-outline-primary btn-sm">
                                    @T["Card_BundId_Mailbox"]
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- Einstellungen -->
            <div class="col">
                <div class="card feature-card h-100 border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="feature-icon bg-secondary-subtle text-secondary mb-3">
                            <i class="bi bi-sliders2"></i>
                        </div>
                        <h5 class="card-title mb-1">@T["Card_Settings"]</h5>
                        <p class="card-text text-muted mb-0">@T["Card_Settings_Text"]</p>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                @T["GoToSettings"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>



</div>

@section Styles {
    <style>
        .hero {
            background: radial-gradient(circle at top left, rgba(13,110,253,0.16), transparent 55%), radial-gradient(circle at bottom right, rgba(32,201,151,0.18), transparent 55%);
            background-color: var(--bs-body-bg);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .hero-stats {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0,0,0,0.04);
        }

        [data-bs-theme="dark"] .hero-stats {
            background: rgba(15,23,42,0.85);
            border-color: rgba(148,163,184,0.25);
        }

        /* Feature Cards */
        .feature-card {
            position: relative;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(15,23,42,0.06);
            transition: transform .15s ease-out, box-shadow .15s ease-out, border-color .15s ease-out, background-color .15s ease-out;
            border-top: 3px solid transparent;
        }

            .feature-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 18px 40px rgba(15,23,42,0.14);
            }

        /* kleiner Icon-Container oben */
        .feature-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 999px;
            font-size: 1.25rem;
        }
        /* Pfeil beim Aufklappen drehen */
        .card-header [data-bs-toggle="collapse"] .bi-chevron-down {
            transition: transform .2s ease;
        }

        .card-header [data-bs-toggle="collapse"][aria-expanded="true"] .bi-chevron-down {
            transform: rotate(180deg);
        }

        /* Letzte Aktivitäten Card */
        .recent-card {
            background: rgba(var(--bs-primary-rgb), 0.03); /* sehr zarter Farbakzent */
            border: 1px solid rgba(0,0,0,0.04);
            transition: background .2s ease, border-color .2s ease;
        }

        /* Dark Mode */
        [data-bs-theme="dark"] .recent-card {
            background: rgba(13,110,253,0.10);
            border-color: rgba(255,255,255,0.07);
        }

        /* Optionale leichte Hoverwirkung */
        .recent-card:hover {
            border-color: rgba(var(--bs-primary-rgb), 0.25);
        }

    </style>
}


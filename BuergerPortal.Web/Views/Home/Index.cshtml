@section Styles {
        <style>
    .hero {
        background: radial-gradient(circle at top left, rgba(13,110,253,0.16), transparent 55%), radial-gradient(circle at bottom right, rgba(32,201,151,0.18), transparent 55%);
        background-color: var(--bs-body-bg);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .hero-stats {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.04);
    }

    [data-bs-theme="dark"] .hero-stats {
        background: rgba(15,23,42,0.85);
        border-color: rgba(148,163,184,0.25);
    }

    /* Feature Cards */
    .feature-card {
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(15,23,42,0.06);
        transition: transform .15s ease-out, box-shadow .15s ease-out, border-color .15s ease-out, background-color .15s ease-out;
        border-top: 3px solid transparent;
    }

        .feature-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 40px rgba(15,23,42,0.14);
        }

    /* kleiner Icon-Container oben */
    .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 999px;
        font-size: 1.25rem;
    }
        /* Pfeil beim Aufklappen drehen */
        .card-header [data-bs-toggle="collapse"] .bi-chevron-down {
            transition: transform .2s ease;
        }

        .card-header [data-bs-toggle="collapse"][aria-expanded="true"] .bi-chevron-down {
            transform: rotate(180deg);
        }

    /* Letzte Aktivitäten Card */
        .recent-card {
            background: rgba(var(--bs-primary-rgb), 0.03); /* sehr zarter Farbakzent */
            border: 1px solid rgba(0,0,0,0.04);
            transition: background .2s ease, border-color .2s ease;
        }

        /* Dark Mode */
        [data-bs-theme="dark"] .recent-card {
            background: rgba(13,110,253,0.10);
            border-color: rgba(255,255,255,0.07);
        }

        /* Optionale leichte Hoverwirkung */
        .recent-card:hover {
            border-color: rgba(var(--bs-primary-rgb), 0.25);
        }

        </style>}

@section Scripts {
    <script>
        let deferredPrompt;
        const installCard = document.getElementById('pwaInstallCard');

        // Event abfangen, wenn die App installierbar ist
        window.addEventListener('beforeinstallprompt', (e) => {
            // Verhindern, dass der Standard-Banner des Browsers erscheint
            e.preventDefault();
            // Event speichern
            deferredPrompt = e;
            // Die Karte auf der Homepage einblenden
            if (installCard) {
                installCard.style.display = 'block';
            }
        });

        async function installApp() {
            if (!deferredPrompt) return;
            try {
                // Den Installations-Dialog anzeigen
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                console.log(`User response to install prompt: ${outcome}`);

                // Prompt löschen, da er nur einmal verwendet werden kann
                deferredPrompt = null;

                // Karte wieder ausblenden
                if (installCard) {
                    installCard.style.display = 'none';
                }
            } catch (err) {
                console.error('installApp error', err);
            }
        }

        // Optional: Verstecken, wenn die App bereits installiert wurde
        window.addEventListener('appinstalled', () => {
            deferredPrompt = null;
            if (installCard) {
                installCard.style.display = 'none';
            }
            console.log('PWA wurde erfolgreich installiert');
        });
    </script>
}
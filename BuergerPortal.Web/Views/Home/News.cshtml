@{
    ViewData["Title"] = "Aktuelles & News";
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-5">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 fw-bold">Aktuelle Meldungen</h1>
    </div>

    <div class="row g-4">
        @foreach (var news in new[] {
                new { T = "Neubau der Stadtbrücke verzögert sich", D = "05.01.2026", C = "Verkehr", B = "bg-danger" },
                new { T = "Bürgerfest 2026: Jetzt als Helfer anmelden", D = "03.01.2026", C = "Event", B = "bg-success" },
                new { T = "Neue digitale Services im BürgerPortal verfügbar", D = "01.01.2026", C = "Digital", B = "bg-primary" }
                })
        {
            <div class="col-12">
                <div class="card border shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge @news.B mb-2">@news.C</span>
                            <h5 class="fw-bold mb-1">@news.T</h5>
                            <p class="small text-muted mb-0">Veröffentlicht am @news.D</p>
                        </div>
                        <i class="bi bi-chevron-right fs-4 text-muted"></i>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    ViewData["Title"] = T["Title"];
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-5">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm" aria-label="@T["Back"]">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <h1 class="h3 mb-0 fw-bold">@T["Heading"]</h1>
    </div>

    <div class="row g-4">
        @* Beispielmeldungen (Studienprojekt); Texte in Resources/Views/Home/News(.en).resx *@
        @foreach (var news in new[] {
                new { T = "News1_Title", D = "05.01.2026", C = "News1_Category", B = "bg-danger" },
                new { T = "News2_Title", D = "03.01.2026", C = "News2_Category", B = "bg-success" },
                new { T = "News3_Title", D = "01.01.2026", C = "News3_Category", B = "bg-primary" }
                })
        {
            <div class="col-12">
                <div class="card border shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge @news.B mb-2">@T[news.C]</span>
                            <h2 class="h5 fw-bold mb-1">@T[news.T]</h2>
                            <p class="small text-muted mb-0">@T["PublishedOn", news.D]</p>
                        </div>
                        <i class="bi bi-chevron-right fs-4 text-muted" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@using Microsoft.AspNetCore.Mvc.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    ViewData["Title"] = T["Standorte & Öffnungszeiten"];
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 fw-bold">Unsere Bürgerämter</h1>
    </div>

    <div class="row g-4">
        @{
            var standorte = new[] {
                new { Name = "Bürgeramt Mitte", Icon = "bi-building-fill", Adresse = "Rathausplatz 1, 12345 Hof" },
                new { Name = "Bürgeramt Nord", Icon = "bi-building", Adresse = "Nordpark Allee 42, 12347 Hof" },
                new { Name = "Bürgeramt Süd", Icon = "bi-house-gear", Adresse = "Südkai 12, 12349 Hof" }
                };
        }

        @foreach (var loc in standorte)
        {
            <div class="col-md-4">
                @* Änderung: 'border' hinzugefügt und 'bg-body-tertiary' für leichte Abhebung.
                   Im Dark Mode sorgt 'shadow-lg' für Tiefe.
                *@
                <div class="card border shadow-sm rounded-4 h-100 bg-body-tertiary">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="feature-icon bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                                <i class="bi @loc.Icon fs-4"></i>
                            </div>
                            <h5 class="card-title fw-bold mb-0">@loc.Name</h5>
                        </div>

                        <div class="mb-3 p-2 rounded-3 bg-body shadow-sm border border-light-subtle">
                            <h6 class="small fw-bold text-uppercase text-muted mb-1">Anschrift</h6>
                            <p class="small mb-0 text-secondary">
                                <i class="bi bi-geo-alt-fill me-1"></i> @loc.Adresse
                            </p>
                        </div>

                        <div class="mb-3">
                            <h6 class="small fw-bold text-uppercase text-muted">@T["Locations_Consultation_Title"]</h6>
                            <p class="mb-0">Werktags: <span class="fw-semibold">08:00 – 12:00 Uhr</span></p>
                            <small class="text-muted text-italic">@T["Locations_Consultation_Note"]</small>
                        </div>

                        <div class="mb-4 flex-grow-1">
                            <h6 class="small fw-bold text-uppercase text-muted">@T["Locations_Gate_Title"]</h6>
                            <div class="d-flex justify-content-between border-bottom border-secondary-subtle py-1">
                                <span>Mo, Di, Do</span>
                                <span class="fw-semibold text-success">08:00 – 16:00 Uhr</span>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom border-secondary-subtle">
                                <span>Mittwoch</span>
                                <span class="fw-semibold">08:00 – 12:00 Uhr</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span>Freitag</span>
                                <span class="fw-semibold">08:00 – 12:00 Uhr</span>
                            </div>
                        </div>

                        <a asp-controller="Termine" asp-action="Index" class="btn btn-primary w-100 rounded-pill shadow-sm py-2 fw-bold mt-auto">
                            <i class="bi bi-calendar-plus me-2"></i>@T["Locations_Book_Appointment"]
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5 p-4 rounded-4 border shadow-sm"
         style="background-color: var(--bs-tertiary-bg); border-color: var(--bs-border-color) !important;">
        <div class="d-flex gap-3 align-items-center">
            <div class="feature-icon bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                <i class="bi bi-info-circle-fill fs-4"></i>
            </div>
            <div>
                <h6 class="mb-1 fw-bold text-emphasis">@T["Locations_Holiday_Title"]</h6>
                <p class="mb-0 small text-secondary">
                    @T["Locations_Holiday_Hint"]
                </p>
            </div>
        </div>
    </div>
</div>
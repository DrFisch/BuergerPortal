@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T
@{
    ViewData["Title"] = T["Cityplan_Title"];
}

<div class="container py-4 py-md-5">
    <div class="d-flex align-items-center gap-3 mb-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-0 fw-bold">@T["Cityplan_Title"]</h1>
            <p class="text-muted mb-0">@T["Cityplan_Subtitle"]</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-body-tertiary">
                <div class="d-flex flex-column align-items-center justify-content-center text-center p-5" style="min-height: 300px; background-image: radial-gradient(var(--bs-border-color) 1px, transparent 1px); background-size: 20px 20px;">
                    <div class="feature-icon bg-secondary bg-opacity-10 text-secondary mb-3" style="width: 64px; height: 64px; display: flex; align-items:center; justify-content:center; border-radius: 50%;">
                        <i class="bi bi-map fs-1"></i>
                    </div>
                    <h5 class="fw-bold">@T["Cityplan_Placeholder_Title"]</h5>
                    <p class="text-muted small mx-auto" style="max-width: 400px;">
                        @T["Cityplan_Placeholder_Hint"]
                    </p>
                </div>
            </div>

            <h5 class="fw-bold mb-4">Interessante Orte & Adressen</h5>
            <div class="row g-3">
                @{
                    var pois = new[] {
                                new { Name = "Bürgeramt Mitte", Addr = "Rathausplatz 1, 12345 Beispielstadt", Icon = "bi-building-fill", Color = "text-primary" },
                                new { Name = "Residenzschloss", Addr = "Schloßgarten 4, 12345 Beispielstadt", Icon = "bi-bank", Color = "text-warning" },
                                new { Name = "Stadtbibliothek", Addr = "Leseweg 12, 12347 Beispielstadt", Icon = "bi-book-half", Color = "text-info" },
                                new { Name = "Hauptbahnhof", Addr = "Bahnhofstraße 1, 12345 Beispielstadt", Icon = "bi-train-front", Color = "text-secondary" },
                                new { Name = "Städtisches Museum", Addr = "Kulturmeile 12, 12345 Beispielstadt", Icon = "bi-palette", Color = "text-danger" },
                                new { Name = "Zentralpark", Addr = "Grüngürtel 1, 12349 Beispielstadt", Icon = "bi-tree", Color = "text-success" }
                                };
                }

                @foreach (var poi in pois)
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-body">
                            <div class="card-body d-flex align-items-start gap-3">
                                <div class="fs-4 @poi.Color">
                                    <i class="bi @poi.Icon"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">@poi.Name</h6>
                                    <p class="small text-muted mb-0">@poi.Addr</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white mb-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Touristen-Info</h6>
                <p class="small opacity-75">
                    Besuchen Sie unser Informationszentrum am Marktplatz für kostenlose Broschüren und persönliche Beratung zu Ihrem Aufenthalt.
                </p>
                <hr class="opacity-25">
                <div class="small">
                    <div class="mb-2"><i class="bi bi-telephone me-2"></i> +49 123 456789</div>
                    <div><i class="bi bi-envelope me-2"></i> info@@buergerstadt.de</div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body">
                <h6 class="fw-bold mb-2">Anreise</h6>
                <p class="small text-muted mb-0">
                    Beispielstadt ist ideal an das regionale Schienennetz angebunden. Alle Sehenswürdigkeiten im Zentrum sind fußläufig in max. 15 Minuten erreichbar.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    /* Dezenter Hover für die Kacheln */
    .card.bg-body:hover {
        transform: translateY(-3px);
        transition: transform 0.2s ease-in-out;
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
    }
</style>
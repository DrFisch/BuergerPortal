@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<BuergerPortal.Web.Services.ModernTexte> M
@using BuergerPortal.Web.Services
@*
    Portal 2 – Einstiegsseite ohne Anmeldung (P2-13): eine klare Seite „Mit BundID anmelden“, der Ablauf in drei Schritten
    (Portal → BundID → zurück) und was man danach erledigen kann. Texte der bisherigen Einstiegsseite
    (Resources/Views/Home/Start) plus Ablauf aus ModernTexte. Der Hinweis vor dem Wechsel zur BundID-Simulation
    erscheint wie bisher beim Klick auf den Anmeldeknopf; zusätzlich steht er ruhig als Banner auf der Seite.
*@
@{
    var L = F.Fuer("Home/Start");
    ViewData["Title"] = L["Start_Title"].Value;
    ViewData["M_EigenerKopf"] = true;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";

    var leistungen = new[]
    {
        ("calendar", "Service_Appointments", ""),
        ("passport", "Service_Passport", ""),
        ("truck", "Service_BulkyWaste", "m-kachel--hinweis"),
        ("octagon-alert", "Service_Issues", "m-kachel--warnung"),
        ("map", "Service_Discover", "m-kachel--hinweis"),
        ("mail", "Service_Mailbox", ""),
        ("id-card", "Service_MyData", "m-kachel--grau"),
    };
    var ablauf = new[] { ("home-doc", 1), ("shield-check", 2), ("circle-check", 3) };
}

@if (ViewData["SessionExpired"] is true)
{
    <div class="m-hinweis m-hinweis--warnung m-einstieg__meldung" role="status">
        <m-icon name="hourglass" />
        <div><strong>@L["Start_SessionExpired_Title"]</strong> @L["Start_SessionExpired_Text"]</div>
    </div>
}
else if (Context.Request.Query.ContainsKey("signedout"))
{
    <div class="m-hinweis m-hinweis--erfolg m-einstieg__meldung" role="status"><m-icon name="circle-check" /><div>@L["Start_SignedOut"]</div></div>
}

<section class="m-einstieg" aria-labelledby="start-heading">
    <div class="m-einstieg__text">
        <span class="m-chip m-chip--sim"><m-icon name="info" />@L["Start_SimulationBadge"]</span>
        <h1 id="start-heading" class="m-einstieg__titel">@L["Start_Heading"]</h1>
        <p class="m-einstieg__lead">@L["Start_Lead"]</p>
    </div>

    <div class="m-karte m-einstieg__anmelden">
        <h2 class="m-karte__titel">@L["Start_LoginTitle"]</h2>
        <p class="m-klein m-neben">@L["Start_LoginText"]</p>
        <a class="m-knopf m-knopf--bundid m-knopf--breit m-einstieg__knopf"
           asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
            @await Html.PartialAsync("_BundIdSymbol", new ViewDataDictionary(ViewData) { ["Size"] = 28 })
            <span>@L["Start_LoginButton"]</span>
        </a>
        <p class="m-einstieg__sicher m-klein"><m-icon name="lock" />@M["Einstieg_Sicher"]</p>
        <p class="m-klein m-neben">
            @L["Start_WhatIsBundId"]
            <a href="https://id.bund.de" rel="noopener" target="_blank">id.bund.de</a>
        </p>
        <p class="m-klein" data-pwa-install-item>
            <button type="button" class="m-knopf m-knopf--text m-knopf--klein" data-pwa-install>
                <m-icon name="smartphone" />@L["Start_InstallApp"]
            </button>
        </p>
    </div>
</section>

<section class="m-abschnitt" aria-labelledby="ablauf-heading">
    <h2 id="ablauf-heading" class="m-abschnitt-titel">@M["Einstieg_Ablauf_Titel"]</h2>
    <ol class="m-ablauf" role="list">
        @foreach (var (symbol, nr) in ablauf)
        {
            <li class="m-ablauf__schritt">
                <span class="m-ablauf__nr" aria-hidden="true">@nr</span>
                <span class="m-kachel @(nr == 2 ? "m-kachel--hinweis" : nr == 3 ? "m-kachel--erfolg" : "")"><m-icon name="@symbol" /></span>
                <div>
                    <h3 class="m-ablauf__titel">@M[$"Einstieg_Ablauf_{nr}_Titel"]</h3>
                    <p class="m-klein m-neben">@M[$"Einstieg_Ablauf_{nr}_Text"]</p>
                </div>
            </li>
        }
    </ol>
    <p class="m-hinweis m-hinweis--warnung m-klein"><m-icon name="info" /><span>@M["Einstieg_Sim_Banner"]</span></p>
</section>

<section class="m-abschnitt" aria-labelledby="services-heading">
    <h2 id="services-heading" class="m-abschnitt-titel">@L["Start_ServicesHeading"]</h2>
    <ul class="m-raster m-raster--2 m-einstieg__leistungen" role="list">
        @foreach (var (symbol, key, ton) in leistungen)
        {
            <li class="m-zeile m-karte--flach m-einstieg__leistung">
                <span class="m-kachel @ton"><m-icon name="@symbol" /></span>
                <span class="m-zeile__text">
                    <span class="m-zeile__titel">@L[$"{key}_Title"]</span>
                    <span class="m-zeile__neben">@L[$"{key}_Text"]</span>
                </span>
            </li>
        }
    </ul>
    <p class="m-klein m-neben m-einstieg__hinweis">@L["Start_ServicesNote"]</p>
</section>

@using BuergerPortal.Web.Extensions
@using BuergerPortal.Web.Features.Termine.ViewModels
@using BuergerPortal.Web.Services
@model TerminDetailsVm
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LF
@*
    Portal 2 – Termin im Detail: dieselbe Ticket-Karte wie auf „Heute“ mit QR-Code zum Einchecken (#checkinQr, data-url),
    „Zum Kalender“ (#kalenderLink), Standort ändern (gleiches Formular wie bisher: UpdateLocation, Feld Location),
    Hinweis bei stornierten Terminen, verknüpfter Antrag. Texte aus Resources/Views/Termine/Details.
*@
@{
    var L = F.Fuer("Termine/Details");
    var de = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de";
    ViewData["Title"] = L["Details_Title"].Value;
    ViewData["M_ZurueckUrl"] = Url.Action("Index");
    ViewData["M_ZurueckText"] = L["Back_To_List"].Value;
}

<div class="m-raster m-raster--haupt">
    <div class="m-stapel m-stapel--weit">
        <article class="m-ticket@(Model.Storniert ? " m-ticket--storniert" : "")" aria-labelledby="ticketLeistung">
            <div class="m-ticket__haupt">
                <p class="m-ticket__leistung">@L["Appointment_Info"]</p>
                <h2 class="m-ticket__datum" id="ticketLeistung">@Model.Service.ToDisplayName(LF)</h2>
                <p class="m-ticket__zeit m-zahl">@Model.Uhrzeit @L["Clock"]</p>
                <p class="m-ticket__ort"><m-icon name="calendar" />@Model.Datum.ToString(de ? "dddd, d. MMMM yyyy" : "dddd, d MMMM yyyy")</p>
                <p class="m-ticket__ort"><m-icon name="map-pin" />@Model.Location.ToDisplay()</p>
                @if (Model.Storniert)
                {
                    <p><span class="m-chip m-chip--fehler">@L["Termine_Status_Cancelled"]</span></p>
                }
                else
                {
                    <div class="m-knopfreihe m-ticket__aktionen">
                        <a asp-action="Kalender" asp-route-id="@Model.Id" class="m-knopf m-knopf--klein m-ticket__knopf" id="kalenderLink" data-m-kein-vorladen>
                            <m-icon name="calendar-plus" />@L["Action_Add_To_Calendar"]
                        </a>
                    </div>
                    <p class="m-mini m-ticket__hinweis">@L["Add_To_Calendar_Hint"]</p>
                }
            </div>
            @if (Model.CheckinQrSvg != null)
            {
                <div class="m-ticket__abriss" id="checkinQr" data-url="@Model.CheckinUrl">
                    @* Vom eigenen Server erzeugtes SVG (QRCoder), kein Benutzereingabe-Inhalt *@
                    <div class="m-ticket__qr checkin-qr" role="img" aria-label="@L["Checkin_Qr_Title"]">@Html.Raw(Model.CheckinQrSvg)</div>
                    <div class="m-stapel m-stapel--eng">
                        <p class="m-fett"><m-icon name="qr-code" /> @L["Checkin_Qr_Title"]</p>
                        <p class="m-mini m-neben">@L["Checkin_Qr_Hint"]</p>
                    </div>
                </div>
            }
        </article>

        @if (Model.AntragId.HasValue)
        {
            <a class="m-zeile m-karte--flach m-termin__antrag" asp-controller="Antraege" asp-action="Antrag" asp-route-id="@Model.AntragId">
                <span class="m-kachel m-kachel--klein m-kachel--hinweis"><m-icon name="file-text" /></span>
                <span class="m-zeile__text">
                    <span class="m-zeile__neben">@L["Details_Linked_Application"]</span>
                    <span class="m-zeile__titel m-mono">#@Model.AntragId.Value.ToString().Substring(0, 8)</span>
                </span>
                <span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a>
        }
    </div>

    <div class="m-stapel">
        @if (!Model.Storniert)
        {
            <form asp-action="UpdateLocation" method="post" class="m-karte">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="m-feld">
                    <label asp-for="Location"><m-icon name="map-pin" /> @L["Field_Location_Change"]</label>
                    <select asp-for="Location" asp-items="Html.GetEnumSelectList<LocationType>()"></select>
                    <p class="m-hilfe"><m-icon name="info" /> @L["Location_Change_Hint"]</p>
                </div>
                <button type="submit" class="m-knopf m-knopf--breit">@L["Action_Save_Location"]</button>
            </form>
        }
        else
        {
            <div class="m-hinweis"><m-icon name="info" /><p>@L["Details_Cancelled_Notice"]</p></div>
        }
    </div>
</div>

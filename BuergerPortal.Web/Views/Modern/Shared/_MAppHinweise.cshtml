@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@using BuergerPortal.Web.Services
@*
    Hinweise der App in Portal 2 (neue Version verfügbar – wwwroot/pwa-install.js; keine Verbindung – js/site.js),
    gleiche IDs und Attribute wie Views/Shared/_AppHinweise.cshtml.
*@
@{
    var L = F.Fuer("Shared/_AppHinweise");
}
<div class="m-app-hinweise" aria-live="polite">
    <div id="pwaUpdateBanner" class="m-hinweis" role="status" hidden>
        <m-icon name="refresh" />
        <span class="m-klein m-wachsen">@L["Update_Text"]</span>
        <button type="button" class="m-knopf m-knopf--text m-knopf--klein" data-pwa-update-spaeter>@L["Later"]</button>
        <button type="button" class="m-knopf m-knopf--klein" data-pwa-update>@L["Update_Now"]</button>
    </div>
    <div id="offlineBanner" class="m-hinweis m-hinweis--warnung" role="status" hidden>
        <m-icon name="wifi-off" />
        <span class="m-klein">@L["Offline_Text"]</span>
    </div>
</div>

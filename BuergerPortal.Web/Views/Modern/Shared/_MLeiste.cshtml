@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<BuergerPortal.Web.Services.ModernTexte> M
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject BuergerPortal.Web.Services.HttpCurrentUserService CurrentUser
@using BuergerPortal.Web.Services
@*
    Navigation links am Computer (ab 1024 px, wwwroot/modern/rahmen.css): Hauptbereiche wie die Tab-Leiste, darunter
    „Mehr“ (was am Handy im Konto-Blatt steht) und unten die angemeldete Person mit BundID-Niveau, Hell/Dunkel, App
    installieren und Abmelden.
*@
@{
    var Tab = F.Fuer("Shared/_TabLeiste");
    var Nav = F.Fuer("Shared/_Navbar");
    var postfachUrl = Config["Postkorb:PostfachUrl"];
    var person = CurrentUser.GetBundIdUser();
    string? Aktuell(params string[] b) => ModernNavigation.Aktuell(ViewContext, b);
}
<nav class="m-leiste" aria-label="@M["Nav_Label"]">
    <a class="m-marke m-leiste__marke" asp-controller="Home" asp-action="Index">
        <span class="m-marke__zeichen"><m-icon name="home-doc" /></span><span>@Nav["BrandTitle"]</span>
    </a>

    <div class="m-leiste__nav">
        <a class="m-leiste__eintrag" asp-controller="Home" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Start)">
            <m-icon name="home" />@Tab["Home"]
        </a>
        <a class="m-leiste__eintrag" asp-controller="Termine" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Termine)">
            <m-icon name="calendar" />@Tab["Appointments"]
        </a>
        <a class="m-leiste__eintrag" asp-controller="Antraege" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Antraege)">
            <m-icon name="file-text" />@Tab["Applications"]
        </a>
        @if (!string.IsNullOrWhiteSpace(postfachUrl))
        {
            <a class="m-leiste__eintrag" href="@postfachUrl" data-sim-hinweis="postfach">
                <m-icon name="mail" />@Tab["Mailbox"]
            </a>
        }
        <a class="m-leiste__eintrag" asp-controller="MeineDaten" asp-action="Index" aria-current="@Aktuell(ModernNavigation.MeineDaten)">
            <m-icon name="id-card" />@Tab["MyData"]
        </a>
    </div>

    <p class="m-leiste__abschnitt">@M["Nav_More"]</p>
    <div class="m-leiste__nav">
        <a class="m-leiste__eintrag" asp-controller="Maengel" asp-action="Create" aria-current="@Aktuell(ModernNavigation.MangelMelden)">
            <m-icon name="octagon-alert" />@Tab["ReportIssue"]
        </a>
        <a class="m-leiste__eintrag" asp-controller="Maengel" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Meldungen)">
            <m-icon name="list-checks" />@Tab["MyReports"]
        </a>
        <a class="m-leiste__eintrag" asp-controller="Entdecken" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Entdecken)">
            <m-icon name="compass" />@Tab["Discover"]
        </a>
        <a class="m-leiste__eintrag" asp-controller="Settings" asp-action="Index" aria-current="@Aktuell(ModernNavigation.Einstellungen)">
            <m-icon name="sliders" />@Tab["Settings"]
        </a>
    </div>

    <div class="m-leiste__person">
        <div class="m-zeile m-leiste__wer">
            <span class="m-avatar" aria-hidden="true">@ModernNavigation.Initialen(person)</span>
            <span class="m-zeile__text">
                <span class="m-zeile__titel">@(person?.DisplayName)</span>
                @if (person is { TrustLevel: > 0 })
                {
                    <span class="m-zeile__neben"><m-icon name="shield-check" /> @Tab[$"Level_{person.TrustLevel}_Name"]</span>
                }
            </span>
        </div>
        <button type="button" class="m-leiste__eintrag js-theme-toggle"
                aria-pressed="false" aria-label="@Tab["ThemeToggleAria"]" data-text-light="@Tab["ThemeLight"]" data-text-dark="@Tab["ThemeDark"]">
            <m-icon name="moon" class="m-symbol-mond" /><m-icon name="sun" class="m-symbol-sonne" /><span class="js-theme-text">@Tab["ThemeLight"]</span>
        </button>
        <button type="button" class="m-leiste__eintrag" data-pwa-install>
            <m-icon name="download" />@Tab["InstallApp"]
        </button>
        <a class="m-leiste__eintrag m-leiste__eintrag--gefahr" asp-controller="Account" asp-action="Logout">
            <m-icon name="log-out" />@Tab["Logout"]
        </a>
    </div>
</nav>

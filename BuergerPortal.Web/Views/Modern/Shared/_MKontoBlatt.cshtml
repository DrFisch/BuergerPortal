@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<BuergerPortal.Web.Services.ModernTexte> M
@inject BuergerPortal.Web.Services.HttpCurrentUserService CurrentUser
@using BuergerPortal.Web.Services
@*
    Blatt „Konto“ (Tab-Leiste, nur Handy/Tablet): Person mit BundID-Niveau, dann alles, was am Computer in der Leiste
    links unter „Mehr“ steht, Hell/Dunkel, App installieren und Abmelden – gruppierte Listen wie in den Einstellungen.
*@
@{
    var Tab = F.Fuer("Shared/_TabLeiste");
    var person = CurrentUser.GetBundIdUser();
}
<dialog class="m-blatt" id="mKontoBlatt" aria-labelledby="mKontoBlattTitel">
    <div class="m-blatt__griff" aria-hidden="true"></div>
    <div class="m-blatt__kopf">
        <span class="m-avatar" aria-hidden="true">@ModernNavigation.Initialen(person)</span>
        <div class="m-blatt__titel">
            <h2 id="mKontoBlattTitel">@(person?.DisplayName ?? Tab["Account"].Value)</h2>
            @if (person is { IsBundIdLogin: true })
            {
                <p class="m-klein m-neben">
                    @Tab["SignedInWithBundId"]
                    @if (person.TrustLevel > 0)
                    {
                        <span class="m-chip @(person.TrustLevel >= 3 ? "m-chip--erfolg" : "m-chip--rand")"><m-icon name="shield-check" />@Tab[$"Level_{person.TrustLevel}_Name"]</span>
                    }
                </p>
            }
        </div>
        <button type="button" class="m-rund" data-m-zu aria-label="@Tab["Close"]"><m-icon name="x" /></button>
    </div>
    <div class="m-blatt__inhalt m-stapel">
        <ul class="m-liste m-liste--symbole" role="list">
            <li><a class="m-zeile" asp-controller="MeineDaten" asp-action="Index">
                <span class="m-kachel m-kachel--klein"><m-icon name="id-card" /></span><span class="m-zeile__text">@Tab["MyData"]</span><span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a></li>
            <li><a class="m-zeile" asp-controller="Maengel" asp-action="Create">
                <span class="m-kachel m-kachel--klein m-kachel--warnung"><m-icon name="octagon-alert" /></span><span class="m-zeile__text">@Tab["ReportIssue"]</span><span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a></li>
            <li><a class="m-zeile" asp-controller="Maengel" asp-action="Index">
                <span class="m-kachel m-kachel--klein m-kachel--grau"><m-icon name="list-checks" /></span><span class="m-zeile__text">@Tab["MyReports"]</span><span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a></li>
            <li><a class="m-zeile" asp-controller="Entdecken" asp-action="Index">
                <span class="m-kachel m-kachel--klein m-kachel--hinweis"><m-icon name="compass" /></span><span class="m-zeile__text">@Tab["Discover"]</span><span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a></li>
            <li><a class="m-zeile" asp-controller="Settings" asp-action="Index">
                <span class="m-kachel m-kachel--klein m-kachel--grau"><m-icon name="sliders" /></span><span class="m-zeile__text">@Tab["Settings"]</span><span class="m-zeile__pfeil"><m-icon name="chevron-right" /></span>
            </a></li>
        </ul>
        <ul class="m-liste m-liste--symbole" role="list">
            <li><button type="button" class="m-zeile js-theme-toggle" aria-pressed="false" aria-label="@Tab["ThemeToggleAria"]"
                        data-text-light="@Tab["ThemeLight"]" data-text-dark="@Tab["ThemeDark"]">
                <span class="m-kachel m-kachel--klein m-kachel--grau"><m-icon name="moon" class="m-symbol-mond" /><m-icon name="sun" class="m-symbol-sonne" /></span>
                <span class="m-zeile__text js-theme-text">@Tab["ThemeLight"]</span>
            </button></li>
            <li><button type="button" class="m-zeile" data-pwa-install>
                <span class="m-kachel m-kachel--klein m-kachel--grau"><m-icon name="download" /></span><span class="m-zeile__text">@Tab["InstallApp"]</span>
            </button></li>
        </ul>
        <ul class="m-liste" role="list">
            <li><a class="m-zeile m-zeile--gefahr" asp-controller="Account" asp-action="Logout">
                <m-icon name="log-out" /><span class="m-zeile__text">@Tab["Logout"]</span>
            </a></li>
        </ul>
    </div>
</dialog>

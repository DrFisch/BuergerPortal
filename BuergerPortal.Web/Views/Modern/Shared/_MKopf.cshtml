@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<BuergerPortal.Web.Services.ModernTexte> M
@inject BuergerPortal.Web.Services.HttpCurrentUserService CurrentUser
@using BuergerPortal.Web.Services
@*
    Kopfzeile von Portal 2: links Marke bzw. „Zurück“ (ViewData M_ZurueckUrl), in der Mitte der kleine Titel (erscheint
    beim Scrollen, wwwroot/modern/app.js), rechts Sprachwahl (immer sichtbar) und – angemeldet – das erreichte
    BundID-Niveau, ohne Anmeldung Hell/Dunkel und „Mit BundID anmelden“.
*@
@{
    var Nav = F.Fuer("Shared/_Navbar");
    var bundIdUser = CurrentUser.GetBundIdUser();
    var titel = ViewData["Title"]?.ToString();
    var zurueckUrl = ViewData["M_ZurueckUrl"] as string;
    var zurueckText = ViewData["M_ZurueckText"]?.ToString() ?? M["Back"].Value;
}
<header class="m-kopf" data-m-kopf>
    @* Links: Marke bzw. „Zurück“; der kleine Titel blendet beim Scrollen an derselben Stelle ein (wwwroot/modern/app.js) *@
    <div class="m-kopf__links@(string.IsNullOrEmpty(zurueckUrl) ? "" : " m-kopf__links--zurueck")">
        @if (!string.IsNullOrEmpty(zurueckUrl))
        {
            <a class="m-zurueck" href="@zurueckUrl"><m-icon name="chevron-left" /><span class="m-zurueck__text">@zurueckText</span></a>
        }
        else
        {
            <a class="m-marke" asp-controller="Home" asp-action="Index">
                <span class="m-marke__zeichen"><m-icon name="home-doc" /></span><span>@Nav["BrandTitle"]</span>
            </a>
        }
        @if (!string.IsNullOrEmpty(titel) && ViewData["M_EigenerKopf"] is not true)
        {
            <div class="m-kopf__titel" aria-hidden="true">@titel</div>
        }
    </div>
    <div class="m-kopf__rechts">
        <partial name="_MSprachwahl" />
        @if (bundIdUser == null)
        {
            <button type="button" class="m-rund m-nur-breit js-theme-toggle" aria-pressed="false" aria-label="@Nav["ThemeToggleAria"]"
                    data-text-light="@Nav["ThemeLight"]" data-text-dark="@Nav["ThemeDark"]">
                <m-icon name="moon" class="m-symbol-mond" /><m-icon name="sun" class="m-symbol-sonne" />
            </button>
            <a class="m-knopf m-knopf--bundid m-knopf--klein" asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@(ViewData["ReturnUrl"] as string ?? "/")">
                @await Html.PartialAsync("_BundIdSymbol", new ViewDataDictionary(ViewData) { ["Size"] = 20 })
                <span>@Nav["LoginShort"]</span>
            </a>
        }
        else if (bundIdUser.TrustLevel > 0)
        {
            <span class="m-chip @(bundIdUser.TrustLevel >= 3 ? "m-chip--erfolg" : "m-chip--rand")" title="@Nav["SignedInWithBundId"]">
                <m-icon name="shield-check" />@Nav[$"Level_{bundIdUser.TrustLevel}_Name"]
            </span>
        }
    </div>
</header>

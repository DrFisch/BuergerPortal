@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizerFactory F
@using BuergerPortal.Web.Services
@*
    „App installieren“ in Portal 2 – Anleitung je Gerät wie Views/Shared/_AppInstallieren.cshtml (gleiche Texte,
    data-pwa-plattform/data-pwa-qr für wwwroot/pwa-install.js), als <dialog>.
*@
@{
    var L = F.Fuer("Shared/_AppInstallieren");
}
<dialog class="m-blatt" id="appInstallModal" aria-labelledby="appInstallTitel">
    <div class="m-blatt__griff" aria-hidden="true"></div>
    <div class="m-blatt__kopf">
        <span class="m-kachel"><m-icon name="smartphone" /></span>
        <h2 class="m-blatt__titel" id="appInstallTitel">@L["Title"]</h2>
        <button type="button" class="m-rund" data-bs-dismiss="modal" aria-label="@L["Close"]"><m-icon name="x" /></button>
    </div>
    <div class="m-blatt__inhalt m-stapel">
        <p class="m-klein m-neben">@L["Why"]</p>

        <div data-pwa-plattform="ios" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["Ios_Title"]</p>
            <ol class="m-schritte-liste">
                <li>@L["Ios_Step1"]</li>
                <li>@L["Ios_Step2"]</li>
                <li>@L["Ios_Step3"]</li>
            </ol>
            <p class="m-klein m-neben">@L["Ios_Note"]</p>
        </div>

        <div data-pwa-plattform="android" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["Android_Title"]</p>
            <ol class="m-schritte-liste">
                <li>@L["Android_Step1"]</li>
                <li>@L["Android_Step2"]</li>
            </ol>
        </div>

        <div data-pwa-plattform="android-firefox" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["AndroidFirefox_Title"]</p>
            <ol class="m-schritte-liste">
                <li>@L["Android_Step1"]</li>
                <li>@L["AndroidFirefox_Step2"]</li>
            </ol>
        </div>

        <div data-pwa-plattform="desktop" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["Desktop_Title"]</p>
            <ol class="m-schritte-liste">
                <li>@L["Desktop_Step1"]</li>
                <li>@L["Desktop_Step2"]</li>
            </ol>
        </div>

        <div data-pwa-plattform="firefox" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["Firefox_Title"]</p>
            <p>@L["Firefox_Text"]</p>
        </div>

        <div data-pwa-plattform="safari-mac" class="m-stapel m-stapel--eng">
            <p class="m-fett">@L["SafariMac_Title"]</p>
            <p>@L["SafariMac_Text"]</p>
        </div>

        <div data-pwa-qr hidden class="m-karte m-karte--flach">
            <p class="m-fett">@L["Qr_Title"]</p>
            <div class="m-qr-zeile">
                <img class="m-qr" width="132" height="132" alt="@L["Qr_Alt"]" data-pwa-qr-bild />
                <p class="m-klein m-neben">@L["Qr_Text"]</p>
            </div>
        </div>
    </div>
    <div class="m-blatt__fuss">
        <button type="button" class="m-knopf" data-bs-dismiss="modal">@L["Ok"]</button>
    </div>
</dialog>

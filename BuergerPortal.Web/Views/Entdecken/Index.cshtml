@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L

@{
    ViewData["Title"] = "Interessante Orte";
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">Interessante Orte</h1>
            <p class="text-secondary mb-0 small">Entdecken Sie Sehenswürdigkeiten, Spielplätze und Services in Ihrer Nähe.</p>
        </div>
    </div>

    <div class="sticky-top py-3 bg-view-header shadow-sm-bottom" style="z-index: 1020; margin-top: -1rem;">
        <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden border border-secondary-subtle">
            <span class="input-group-text bg-search-input border-0 ps-3">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input type="text" id="poiSearch" class="form-control bg-search-input border-0 py-2 shadow-none"
                   placeholder="Suche nach Namen, Kategorien oder Schlagworten...">
            <button class="btn bg-search-input border-0 text-secondary" type="button" id="clearSearch">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="d-flex gap-2 overflow-x-auto pb-2 no-scrollbar" id="filterContainer">
            <button class="btn btn-primary btn-sm rounded-pill active px-3 flex-shrink-0" data-filter="all">Alle</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Verwaltung">🏛️ Verwaltung</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Freizeit">🌳 Freizeit & Natur</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Kultur">🎨 Kultur</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Entsorgung">♻️ Entsorgung</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Bildung">🏫 Bildung</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Notfall">🏥 Notfall</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Mobilität">🚲 Mobilität</button>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-1">
        <span class="small text-secondary fw-medium"><span id="resultCount">0</span> Orte gefunden</span>
        <i class="bi bi-info-circle text-secondary opacity-50 small" title="Lokale Ergebnisse"></i>
    </div>

    <div id="poiList" class="row g-3">
    </div>

    <div id="emptyState" class="text-center py-5 d-none opacity-75">
        <div class="bg-secondary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-geo-fill fs-1 text-secondary"></i>
        </div>
        <h4 class="fw-bold">Keine Orte gefunden</h4>
        <p class="text-secondary small">Versuchen Sie es mit einem anderen Suchbegriff oder Filter.</p>
    </div>
</div>

@section Styles {
    <style>
        /* Container für Sticky-Header - Adaptiv für Dark Mode */
        .bg-view-header {
            background-color: var(--bs-body-bg);
            transition: background-color 0.3s ease;
        }

        /* Suchleiste Background Fix */
        .bg-search-input {
            background-color: var(--bs-tertiary-bg) !important;
            color: var(--bs-body-color);
        }

        /* Filter Chips Styling */
        .btn-filter-chip {
            background-color: var(--bs-secondary-bg);
            border: 1px solid var(--bs-border-color);
            color: var(--bs-body-color);
            transition: all 0.2s ease;
        }

            .btn-filter-chip:hover {
                background-color: var(--bs-secondary-bg-subtle);
                border-color: var(--bs-primary-border-subtle);
            }

            .btn-filter-chip.active {
                background-color: var(--bs-primary) !important;
                border-color: var(--bs-primary) !important;
                color: #fff !important;
            }

        /* Card Optimierung */
        .poi-card {
            background-color: var(--bs-body-bg);
            border: 1px solid var(--bs-border-color) !important;
            transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
        }

            .poi-card:hover {
                transform: translateY(-5px);
                border-color: var(--bs-primary-border-subtle) !important;
                box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
            }

        /* Kategorie Badges im Dark Mode weniger grell */
        .category-badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 800;
            background-color: var(--bs-primary-bg-subtle) !important;
            color: var(--bs-primary-text-emphasis) !important;
        }

        /* Hilfsklassen */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pois = [
                { id: 1, name: "Bürgerbüro Rathaus", cat: "Verwaltung", desc: "Zentrale Anlaufstelle für Passwesen, Anmeldungen und Beglaubigungen.", tags: "pass meldeamt ausweis rathaus verwaltung anmeldung", icon: "bi-building" },
                { id: 2, name: "Standesamt", cat: "Verwaltung", desc: "Zuständig für Eheschließungen, Geburtsurkunden und Namensänderungen.", tags: "heirat hochzeit geburt urkunde name", icon: "bi-heart-fill" },
                { id: 3, name: "Finanzamt", cat: "Verwaltung", desc: "Beratung zu Steuererklärungen und Elster-Zugängen.", tags: "steuer geld finanzen einkommen", icon: "bi-cash-stack" },
                { id: 4, name: "Kfz-Zulassungsstelle", cat: "Verwaltung", desc: "An- und Abmeldung von Fahrzeugen sowie Wunschkennzeichen.", tags: "auto kfz schild kennzeichen fahrzeug", icon: "bi-car-front" },
                { id: 5, name: "Altes Stadtschloss", cat: "Kultur", desc: "Historisches Residenzschloss mit Schlossgarten und Prunkräumen.", tags: "schloss geschichte tourismus besichtigung", icon: "bi-bank" },
                { id: 6, name: "Stadtmuseum", cat: "Kultur", desc: "Interaktive Zeitreise durch 800 Jahre Stadtgeschichte.", tags: "museum ausstellung kunst lernen", icon: "bi-image" },
                { id: 7, name: "St. Marien Kathedrale", cat: "Kultur", desc: "Gotische Kathedrale mit berühmtem Altar und Aussichtsturm.", tags: "kirche dom aussicht religion turm", icon: "bi-church" },
                { id: 8, name: "Staatstheater", cat: "Kultur", desc: "Aufführungen von Oper, Ballett und modernem Schauspiel.", tags: "theater musik bühne kultur abend", icon: "bi-masks" },
                { id: 9, name: "Denkmal der Einheit", cat: "Kultur", desc: "Zentrales Mahnmal auf dem Europaplatz.", tags: "denkmal platz statue geschichte", icon: "bi-trophy" },
                { id: 10, name: "Schlosspark", cat: "Freizeit", desc: "Großflächige Parkanlage mit Blumenrabatten und Liegewiesen.", tags: "park natur spazieren erholung grün", icon: "bi-tree" },
                { id: 11, name: "Abenteuerspielplatz Süd", cat: "Freizeit", desc: "Inklusive Matschanlage, Seilbahn und großem Kletterschiff.", tags: "kind spielplatz rutsche schaukel outdoor", icon: "bi-house-heart" },
                { id: 12, name: "Botanischer Garten", cat: "Freizeit", desc: "Exotische Pflanzenhäuser und Heilkräutergarten.", tags: "pflanzen blumen gewächshaus ruhe", icon: "bi-flower1" },
                { id: 13, name: "Städtischer Zoo", cat: "Freizeit", desc: "Heimat für über 200 Tierarten mit Streichelgehege.", tags: "tiere kinder ausflug wochenende", icon: "bi-bug" },
                { id: 14, name: "Trimm-Dich-Pfad Waldlust", cat: "Freizeit", desc: "Outdoor-Fitness-Parcours mit 12 Stationen.", tags: "sport fitness wald gesundheit", icon: "bi-bicycle" },
                { id: 15, name: "Wertstoffhof Nord", cat: "Entsorgung", desc: "Annahme von Elektroschrott, Sperrmüll und Problemstoffen.", tags: "müll recycling schrott entsorgung", icon: "bi-trash" },
                { id: 16, name: "Grünschnitt-Sammelstelle", cat: "Entsorgung", desc: "Abgabe von Gartenabfällen, Laub und Astwerk.", tags: "garten laub holz kompost", icon: "bi-leaf" },
                { id: 17, name: "Altglas-Containerpark West", cat: "Entsorgung", desc: "Sammelstelle für Weiß-, Braun- und Grünglas.", tags: "glas flaschen recycling umwelt", icon: "bi-box-seam" },
                { id: 18, name: "Zentralbibliothek", cat: "Bildung", desc: "Medienverleih, Arbeitsplätze und Kinderleseecke.", tags: "buch lernen lesen schule wlan", icon: "bi-book" },
                { id: 19, name: "Volkshochschule (VHS)", cat: "Bildung", desc: "Weiterbildung in Sprachen, Technik und Kreativität.", tags: "kurs lernen erwachsene bildung", icon: "bi-mortarboard" },
                { id: 20, name: "Sternwarte", cat: "Bildung", desc: "Öffentliche Himmelsbeobachtungen und Astronomie-Vorträge.", tags: "sterne weltraum teleskop wissenschaft", icon: "bi-stars" },
                { id: 21, name: "E-Ladehub Bahnhof", cat: "Mobilität", desc: "Schnellladestationen für E-Autos und E-Bikes.", tags: "strom auto laden elektro mobil", icon: "bi-lightning-charge" },
                { id: 22, name: "Fahrradparkhaus", cat: "Mobilität", desc: "Sicheres Parken und kleine Reparaturstation für Räder.", tags: "bike fahrrad parken rad", icon: "bi-p-circle" },
                { id: 23, name: "Stadtklinikum", cat: "Notfall", desc: "Zentralkrankenhaus mit 24h Notaufnahme.", tags: "arzt krankenhaus hilfe unfall", icon: "bi-hospital" },
                { id: 24, name: "Defibrillator (AED) Marktplatz", cat: "Notfall", desc: "Rund um die Uhr zugänglich an der Fassade der Apotheke.", tags: "herz erste hilfe aed leben rettung", icon: "bi-heart-pulse" }
            ];

            const poiSearch = document.getElementById('poiSearch');
            const poiList = document.getElementById('poiList');
            const filterButtons = document.querySelectorAll('#filterContainer button');
            const resultCount = document.getElementById('resultCount');
            const emptyState = document.getElementById('emptyState');
            const clearSearch = document.getElementById('clearSearch');

            function renderPois() {
                const term = poiSearch.value.toLowerCase();
                const activeFilter = document.querySelector('#filterContainer .active').dataset.filter;

                const filtered = pois.filter(p => {
                    const matchesFilter = activeFilter === 'all' || p.cat === activeFilter;
                    const matchesSearch = p.name.toLowerCase().includes(term) ||
                                          p.desc.toLowerCase().includes(term) ||
                                          p.tags.toLowerCase().includes(term);
                    return matchesFilter && matchesSearch;
                });

                resultCount.textContent = filtered.length;

                if (filtered.length === 0) {
                    poiList.innerHTML = '';
                    emptyState.classList.remove('d-none');
                } else {
                    emptyState.classList.add('d-none');
                    poiList.innerHTML = filtered.map(p => `
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 poi-card p-2">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge category-badge px-2 py-1 rounded-pill">
                                            ${p.cat}
                                        </span>
                                        <i class="bi ${p.icon} text-primary opacity-50 fs-4"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2 h6 text-truncate">${p.name}</h5>
                                    <p class="text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        ${p.desc}
                                    </p>
                                    <div class="d-flex align-items-center text-primary fw-bold small mt-auto">
                                        Details anzeigen
                                        <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('');
                }
            }

            poiSearch.addEventListener('input', renderPois);

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterButtons.forEach(b => b.classList.remove('active', 'btn-primary'));
                    filterButtons.forEach(b => b.classList.add('btn-filter-chip'));

                    this.classList.add('active', 'btn-primary');
                    this.classList.remove('btn-filter-chip');
                    renderPois();
                });
            });

            clearSearch.addEventListener('click', () => {
                poiSearch.value = '';
                renderPois();
            });

            renderPois();
        });
    </script>
}
@using BuergerPortal.Web.Features.Entdecken
@model EntdeckenIndexVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L

@{
    ViewData["Title"] = L["Card_Explore_Title"];
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">@L["Card_Explore_Title"]</h1>
            <p class="text-secondary mb-0 small">@L["Card_Explore_Description"]</p>
        </div>
    </div>

    @* WICHTIG: z-index auf 1010 reduziert (Navbar hat standardmäßig 1020/1030).
       top: 56px (oder die Höhe deiner Navbar) sorgt dafür, dass die Suchbar UNTER der Navbar klebt.
    *@
    <div class="sticky-top py-3 bg-view-header shadow-sm-bottom" style="z-index: 1010; margin-top: -1rem; top: 56px;">
        <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden border border-secondary-subtle">
            <span class="input-group-text bg-search-input border-0 ps-3">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input type="text" id="poiSearch" class="form-control bg-search-input border-0 py-2 shadow-none"
                   placeholder="@L["Search_Placeholder"]">
            <button class="btn bg-search-input border-0 text-secondary" type="button" id="clearSearch">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="d-grid mb-3">
            <button class="btn btn-outline-primary rounded-pill shadow-sm fw-bold border-2" onclick="openGlobalMap()">
                <i class="bi bi-map-fill me-2"></i> @L["Show_Map_Overview"]
            </button>
        </div>

        <div class="d-flex gap-2 overflow-x-auto pb-2 no-scrollbar" id="filterContainer">
            <button class="btn btn-primary btn-sm rounded-pill active px-3 flex-shrink-0" data-filter="all">Alle</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Verwaltung">🏛️ @L["Cat_Administration"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Freizeit">🌳 @L["Cat_Leisure"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Kultur">🎨 @L["Cat_Culture"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Entsorgung">♻️ @L["Cat_Waste"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Bildung">🏫 @L["Cat_Education"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Notfall">🏥 @L["Cat_Emergency"]</button>
            <button class="btn btn-filter-chip btn-sm rounded-pill px-3 flex-shrink-0" data-filter="Mobilität">🚲 @L["Cat_Mobility"]</button>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-1">
        <span class="small text-secondary fw-medium"><span id="resultCount">@Model.Orte.Count</span> Orte gefunden</span>
    </div>

    <div id="poiList" class="row g-3">
        @foreach (var poi in Model.Orte)
        {
            <div class="col-12 col-md-6 col-lg-4 poi-item-wrapper"
                 data-id="@poi.Id"
                 data-name="@poi.Name.ToLower()"
                 data-cat="@poi.Cat"
                 data-tags="@poi.Tags?.ToLower()"
                 data-desc="@poi.Desc.ToLower()">
                <div class="card h-100 border-0 shadow-sm rounded-4 poi-card p-2" onclick="openPoiDetails('@poi.Id')">
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge category-badge px-2 py-1 rounded-pill">@poi.Cat</span>
                            <i class="bi @poi.Icon text-primary opacity-50 fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-2 h6 text-truncate">@poi.Name</h5>
                        <p class="text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @poi.Desc
                        </p>
                        <div class="d-flex align-items-center text-primary fw-bold small mt-auto">
                            Details anzeigen <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="emptyState" class="text-center py-5 d-none opacity-75">
        <div class="bg-secondary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-geo-fill fs-1 text-secondary"></i>
        </div>
        <h4 class="fw-bold">@L["No_Results_Found"]</h4>
    </div>
</div>

@* Modals bleiben unverändert *@
<div class="modal fade" id="poiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <div id="poiModalBody"></div>
                <div id="map" class="mt-3 border shadow-sm" style="height: 300px; width: 100%; border-radius: 1rem;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 justify-content-center">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Schließen</button>
                <a href="" id="poiMapBtn" target="_blank" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-geo-alt me-1"></i> Karte öffnen
                </a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="globalMapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-md-down modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 shadow-sm sticky-top bg-body">
                <h5 class="modal-title fw-bold"><i class="bi bi-geo-alt text-primary me-2"></i>@L["Map_Overview_Hof"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 position-relative">
                <div id="globalMap" style="height: 75vh; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        /* Der View-Header muss einen Hintergrund haben, damit der Text darunter beim Scrollen verschwindet */
        .bg-view-header {
            background-color: var(--bs-body-bg);
            transition: background-color 0.3s ease;
        }

        .bg-search-input {
            background-color: var(--bs-tertiary-bg) !important;
        }

        .btn-filter-chip {
            background-color: var(--bs-secondary-bg);
            border: 1px solid var(--bs-border-color);
            color: var(--bs-body-color);
            transition: all 0.2s ease;
        }

            .btn-filter-chip.active, .btn-primary.active {
                background-color: var(--bs-primary) !important;
                color: #fff !important;
                border-color: var(--bs-primary) !important;
            }

        .poi-card {
            background-color: var(--bs-body-bg);
            border: 1px solid var(--bs-border-color) !important;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .poi-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
                border-color: var(--bs-primary) !important;
            }

        .category-badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            font-weight: 800;
            background-color: var(--bs-primary-bg-subtle) !important;
            color: var(--bs-primary-text-emphasis) !important;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .dark-bg-subtle {
            [data-bs-theme="dark"] & {
                background-color: var(--bs-tertiary-bg) !important;
            }
        }

        .leaflet-popup-content-wrapper, .leaflet-popup-tip {
            background: var(--bs-body-bg);
            color: var(--bs-body-color);
        }

        .btn-xs {
            padding: 0.1rem 0.5rem;
            font-size: 0.75rem;
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const allPois = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Orte));
        let detailMap = null;
        let globalMap = null;

        document.addEventListener('DOMContentLoaded', function() {
            const poiModalElement = document.getElementById('poiModal');
            const poiModal = new bootstrap.Modal(poiModalElement);
            const globalMapModal = new bootstrap.Modal(document.getElementById('globalMapModal'));
            const filterContainer = document.getElementById('filterContainer');

            // Desktop Wheel Scroll Support
            filterContainer.addEventListener('wheel', (evt) => {
                evt.preventDefault();
                filterContainer.scrollLeft += evt.deltaY;
            });

            // 1. Filter-Logik
            function filterPois() {
                const term = document.getElementById('poiSearch').value.toLowerCase().trim();
                const activeBtn = document.querySelector('#filterContainer .active');
                const activeFilter = activeBtn ? activeBtn.dataset.filter : 'all';
                let count = 0;

                document.querySelectorAll('.poi-item-wrapper').forEach(item => {
                    const matchesFilter = activeFilter === 'all' || item.dataset.cat === activeFilter;
                    const matchesSearch = !term || item.dataset.name.includes(term) || item.dataset.desc.includes(term) || (item.dataset.tags && item.dataset.tags.includes(term));

                    if (matchesFilter && matchesSearch) {
                        item.classList.remove('d-none');
                        count++;
                    } else {
                        item.classList.add('d-none');
                    }
                });
                document.getElementById('resultCount').textContent = count;
                document.getElementById('emptyState').classList.toggle('d-none', count > 0);
            }

            // 2. Detail Modal Logik
            window.openPoiDetails = function(id) {
                const poi = allPois.find(p => (p.Id || p.id) === id);
                if (!poi) return;

                document.getElementById('poiModalBody').innerHTML = `
                    <div class="text-center mb-3">
                        <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                            <i class="bi ${poi.Icon || poi.icon} fs-2"></i>
                        </div>
                        <h4 class="fw-bold mb-1">${poi.Name || poi.name}</h4>
                        <span class="badge bg-primary-subtle text-primary category-badge rounded-pill px-3">${poi.Cat || poi.cat}</span>
                    </div>
                    <div class="px-2">
                        <p class="text-muted mb-3 text-center small">${poi.Desc || poi.desc}</p>
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 dark-bg-subtle border">
                            <i class="bi bi-geo-alt-fill text-primary fs-4"></i>
                            <div>
                                <small class="text-secondary d-block">Adresse</small>
                                <span class="fw-medium">${poi.Addr || poi.addr || "Stadt Hof"}</span>
                            </div>
                        </div>
                    </div>`;

                const mapQuery = encodeURIComponent(`${poi.Name || poi.name} Hof`);
                document.getElementById('poiMapBtn').href = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

                poiModalElement.dataset.currentLat = poi.Lat || poi.lat || 50.312;
                poiModalElement.dataset.currentLon = poi.Lon || poi.lon || 11.912;
                poiModalElement.dataset.currentTitle = poi.Name || poi.name;

                poiModal.show();
            };

            poiModalElement.addEventListener('shown.bs.modal', function () {
                const lat = parseFloat(this.dataset.currentLat);
                const lon = parseFloat(this.dataset.currentLon);
                if (detailMap !== null) detailMap.remove();
                detailMap = L.map('map').setView([lat, lon], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(detailMap);
                L.marker([lat, lon]).addTo(detailMap).bindPopup(`<b>${this.dataset.currentTitle}</b>`).openPopup();
                detailMap.invalidateSize();
            });

            // 3. Global Map Logik
            window.openGlobalMap = function() {
                globalMapModal.show();
            };

            document.getElementById('globalMapModal').addEventListener('shown.bs.modal', function () {
                if (globalMap !== null) globalMap.remove();
                globalMap = L.map('globalMap').setView([50.312, 11.912], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(globalMap);

                const markerGroup = [];
                allPois.forEach(poi => {
                    const lat = poi.Lat || poi.lat;
                    const lon = poi.Lon || poi.lon;
                    if (lat && lon) {
                        const m = L.marker([lat, lon]).addTo(globalMap)
                            .bindPopup(`
                                <div class="text-center">
                                    <h6 class="fw-bold mb-1">${poi.Name || poi.name}</h6>
                                    <button class="btn btn-xs btn-primary rounded-pill mt-1"
                                            onclick="bootstrap.Modal.getInstance(document.getElementById('globalMapModal')).hide(); openPoiDetails('${poi.Id || poi.id}')">
                                        Details
                                    </button>
                                </div>`);
                        markerGroup.push(m);
                    }
                });

                if (markerGroup.length > 0) {
                    const group = new L.featureGroup(markerGroup);
                    globalMap.fitBounds(group.getBounds().pad(0.1));
                }
                globalMap.invalidateSize();
            });

            // Filter Click Handler
            document.querySelectorAll('#filterContainer button').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('#filterContainer button').forEach(b => {
                        b.classList.remove('active', 'btn-primary');
                        b.classList.add('btn-filter-chip');
                    });
                    this.classList.add('active', 'btn-primary');
                    this.classList.remove('btn-filter-chip');
                    filterPois();
                });
            });

            document.getElementById('poiSearch').addEventListener('input', filterPois);
            document.getElementById('clearSearch').addEventListener('click', () => {
                document.getElementById('poiSearch').value = '';
                filterPois();
            });
        });
    </script>
}
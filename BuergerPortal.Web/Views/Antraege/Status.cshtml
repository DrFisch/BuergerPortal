@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.StatusListeVm
@using BuergerPortal.Web.Features.Termine.ViewModels
@{
    ViewData["Title"] = "Meine Anträge";
}

<div class="container py-4 status-list">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <h1 class="h4 mb-0">Meine Anträge</h1>

        <!-- Toolbar (optional GET-Filter, funktioniert auch ohne Controller-Änderung) -->
        <form method="get" class="d-flex flex-wrap gap-2">
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true">🔎</span>
                <input name="q" class="form-control" placeholder="Suche nach Name/ID…" />
            </div>
            <select name="status" class="form-select">
                <option value="">Alle Status</option>
                <option value="1">Entwurf</option>
                <option value="2">Eingereicht</option>
                <option value="3">In Prüfung</option>
                <option value="4">Genehmigt</option>
                <option value="5">Abgelehnt</option>
            </select>
            <button class="btn btn-outline-secondary">Filtern</button>
        </form>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="card border-0 bg-body-tertiary">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <div class="empty-icon" aria-hidden="true">📄</div>
                    <div>
                        <div class="fw-semibold">Noch keine Anträge</div>
                        <div class="text-secondary">Starte einen neuen Reisepassantrag über die Übersicht.</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var a in Model.Items)
            {
                var shortId = a.Id.ToString().Substring(0, 8);
                <div class="card shadow-sm border-0 status-item">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div class="d-flex align-items-start gap-3">
                                <!-- Status-Dot -->
                                <span class="status-dot @a.BadgeClass" aria-hidden="true"></span>

                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="fw-semibold">@a.Antragsteller</span>

                                        <!-- Typ-Badge dynamisch -->
                                        <span class="badge rounded-pill @a.TypBadgeClass">@a.TypText
                                        </span>

                                        <span class="badge rounded-pill @a.BadgeClass">@a.StatusText</span>

                                        <span class="text-secondary small">ID: <code>@a.Id.ToString().Substring(0, 8)</code></span>
                                    </div>

                                    <div class="text-secondary small mt-1">
                                        Angelegt: @a.Angelegt:dd.MM.yyyy
                                        @if (a.Eingereicht.HasValue)
                                        {
                                            <span> • Eingereicht: @a.Eingereicht.Value:dd.MM.yyyy</span>
                                        }
                                    </div>


                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-secondary"
                                   asp-action="Antrag" asp-route-id="@a.Id">
                                    Details
                                </a>
                                <a class="btn btn-primary"
                                   asp-controller="Termine" asp-action="Buchen"
                                   asp-route-service="@(ServiceType.AntragRueckfrage)">
                                    Termin zur Klärung
                                </a>
                            </div>
                        </div>

                        <!-- Fortschritt -->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Fortschritt</span>
                                <span>@a.ProgressPercent%</span>
                            </div>
                            <div class="progress progress-thin" role="progressbar"
                                 aria-valuenow="@a.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width:@a.ProgressPercent%"></div>
                            </div>
                            <div class="progress-steps small text-secondary mt-2">
                                <span class="step @(a.ProgressPercent >= 20 ? "done" : "")">Entwurf</span>
                                <span class="step @(a.ProgressPercent >= 40 ? "done" : "")">Eingereicht</span>
                                <span class="step @(a.ProgressPercent >= 70 ? "done" : "")">Prüfung</span>
                                <span class="step @(a.ProgressPercent >= 100 ? "done" : "")">Abschluss</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .status-list .empty-icon {
            font-size: 28px;
            line-height: 1;
            background: var(--bs-tertiary-bg);
            width: 44px;
            height: 44px;
            border-radius: .75rem;
            display: grid;
            place-items: center;
        }

        .status-item {
            position: relative;
            overflow: hidden;
        }

            .status-item::before {
                content: "";
                position: absolute;
                inset-inline-start: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: color-mix(in oklab, var(--bs-primary) 50%, transparent);
            }

        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            translate: 0 .35rem;
            background: var(--bs-secondary);
        }

            .status-dot.text-bg-secondary {
                background: var(--bs-secondary);
            }

            .status-dot.text-bg-info {
                background: var(--bs-info);
            }

            .status-dot.text-bg-warning {
                background: var(--bs-warning);
            }

            .status-dot.text-bg-success {
                background: var(--bs-success);
            }

            .status-dot.text-bg-danger {
                background: var(--bs-danger);
            }

        .progress-thin {
            height: .5rem;
        }

        .progress-steps {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
        }

            .progress-steps .step {
                opacity: .6;
            }

                .progress-steps .step.done {
                    opacity: 1;
                    font-weight: 600;
                }
    </style>
}

@model BuergerPortal.Web.Features.Antraege.AntraegeStatusVm
@using BuergerPortal.Web.Features.Antraege
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@* „Meine Anträge“ (2026-10-18): alle Antragsarten in einer Liste, Filter als Links (ohne Skript), Entwürfe sichtbar. *@
@{
    ViewData["Title"] = L["Title"];
    ViewData["Zurueck"] = "status";
    var liste = Model.Gefiltert;
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite ap-seite-schmal py-4">
    <header class="ap-kopf ap-farbe-primary">
        <span class="ap-symbol" aria-hidden="true"><i class="bi bi-list-check"></i></span>
        <div>
            <h1 class="h3 fw-bold">@L["Heading"]</h1>
            <p class="text-body-secondary mb-0">@L["Intro"]</p>
        </div>
    </header>

    <nav class="ap-filter" aria-label="@L["Filter_Label"]">
        @foreach (var f in AntraegeStatusVm.Filternamen)
        {
            <a asp-action="Status" asp-route-filter="@(f == "alle" ? null : f)" id="filter-@f"
               aria-current="@(f == Model.Filter ? "page" : null)">
                @L[$"Filter_{f}"] <span class="badge rounded-pill">@Model.Nach(f).Count()</span>
            </a>
        }
    </nav>

    @if (liste.Count == 0)
    {
        <div class="ap-karte text-center p-4 p-md-5">
            <span class="ap-symbol mb-3" aria-hidden="true"><i class="bi bi-inbox"></i></span>
            <h2 class="h5 fw-bold">@L[$"Empty_{Model.Filter}"]</h2>
            <p class="text-body-secondary">@L["Empty_Text"]</p>
            <a asp-action="Index" class="btn btn-primary">@L["Empty_Button"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
    }
    else
    {
        <div class="ap-karte" id="antragsliste">
            @foreach (var a in liste)
            {
                <partial name="_AntragZeile" model="a" />
            }
        </div>
        <p class="mt-3 small text-body-secondary"><i class="bi bi-envelope-paper me-1" aria-hidden="true"></i>@L["Postfach_Hint"]</p>
        <p class="mt-3">
            <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["New"]</a>
        </p>
    }
</div>

@section Scripts {
    <script src="~/js/antraege.js" asp-append-version="true"></script>
}

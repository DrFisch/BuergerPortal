@model BuergerPortal.Web.Features.Antraege.Sperrmuell.ViewModels.SperrmuellAntragDetailVm
@using BuergerPortal.Web.Features.Antraege
@using BuergerPortal.Web.Features.Termine.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer L
@inject IStringLocalizer<Leistungen> LK
@inject IConfiguration Config
@* Sperrmüll-Detail (2026-10-18): Kopf mit Status, „Nächste Schritte“ (Abholtag, bereitstellen), Zeitleiste, Abholung und
   Mengen, Kontakt, Postfach-Link und Druckansicht. *@
@{
    ViewData["Title"] = L["Title"];
    var leistung = Leistungen.Von(Leistungen.Sperrmuell)!;
    var nummer = Model.Id.ToString("N")[..8].ToUpperInvariant();
    var postfachUrl = Config["Postkorb:PostfachUrl"];
    var abholtag = Model.Wunschzeit.ToString("dddd, dd.MM.yyyy");
    var verlauf = new AntragVerlaufVm(Model.Status, Model.CreatedUtc, Model.SubmittedUtc, Model.InBearbeitungSeit, Model.AbgeschlossenAm);
    string Menge(int? wert, string einheit = "") => wert is > 0 ? $"{wert} {einheit}".TrimEnd() : "–";
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite py-4 ap-farbe-success">
    <p class="ap-nicht-drucken mb-2">
        <a asp-action="Status" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> @L["Back"]</a>
    </p>
    <header class="ap-kopf">
        <span class="ap-symbol" aria-hidden="true"><i class="bi @leistung.Icon"></i></span>
        <div class="flex-grow-1">
            <h1 class="h3 fw-bold">@LK["Sperrmuell_Name"]</h1>
            <p class="text-body-secondary mb-2">
                @L["Number"] <strong>@nummer</strong>
                @if (Model.SubmittedUtc is { } eingereicht)
                {
                    <span>· @L["SubmittedOn", eingereicht.ToString("d")]</span>
                }
            </p>
            <span class="ap-status ap-status-@Model.Status" id="status">@LK[$"Status_{Model.Status}"]</span>
        </div>
    </header>

    @if (TempData["AntragTerminOk"] is string bookedMsg)
    {
        <div class="alert alert-success d-flex gap-2" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><div>@bookedMsg</div></div>
    }

    <section class="ap-karte p-3 p-md-4 mb-3" aria-labelledby="hNaechste" id="naechsteSchritte">
        <h2 id="hNaechste" class="h6 fw-bold mb-2">@L["Next_Heading"]</h2>
        @switch (Model.Status)
        {
            case 1:
                <p class="mb-2">@L["Next_Draft"]</p>
                <a class="btn btn-success" asp-controller="SperrmuellAntraege" asp-action="SperrmuellStep2" asp-route-id="@Model.Id">@L["Next_Draft_Button"]</a>
                break;
            case 2:
            case 3:
                <p class="mb-0">@L["Next_Pending", abholtag]</p>
                break;
            case 4:
                <p class="mb-0">@L["Next_Confirmed", abholtag]</p>
                break;
            default:
                <p class="mb-0">@L["Next_Rejected"]</p>
                break;
        }
    </section>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <section class="ap-karte p-3 p-md-4 mb-3" aria-labelledby="hVerlauf">
                <h2 id="hVerlauf" class="h6 fw-bold mb-3">@L["Timeline_Heading"]</h2>
                <partial name="_AntragVerlauf" model="verlauf" />
            </section>

            <section class="ap-karte p-3 p-md-4 mb-3" aria-labelledby="hAbholung">
                <h2 id="hAbholung" class="h6 fw-bold mb-3">@L["Pickup_Heading"]</h2>
                <dl class="ap-angaben">
                    <dt>@L["Day"]</dt>
                    <dd class="fw-semibold">@abholtag</dd>
                    <dt>@L["Address"]</dt>
                    <dd>@Model.Strasse, @Model.PLZ @Model.Ort</dd>
                    <dt>@L["Wood"]</dt>
                    <dd>@Menge(Model.HolzKubikmeter, "m³")</dd>
                    <dt>@L["Other"]</dt>
                    <dd>@Menge(Model.SonstigesKubikmeter, "m³")</dd>
                    <dt>@L["Mattresses"]</dt>
                    <dd>@Menge(Model.Matratzen)</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Hinweis))
                    {
                        <dt>@L["Note"]</dt>
                        <dd>@Model.Hinweis</dd>
                    }
                    <dt>@L["Applicant"]</dt>
                    <dd>@Model.Antragsteller</dd>
                    <dt>@L["Fee"]</dt>
                    <dd>@LK["Sperrmuell_Gebuehr"]</dd>
                </dl>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="ap-karte p-3 p-md-4 mb-3" aria-labelledby="hKontakt">
                <h2 id="hKontakt" class="h6 fw-bold mb-3">@L["Contact_Heading"]</h2>
                <dl class="ap-angaben ap-angaben-gestapelt mb-3">
                    <dt>@L["Email"]</dt>
                    <dd>@(string.IsNullOrEmpty(Model.Email) ? "–" : Model.Email)</dd>
                    <dt>@L["Phone"]</dt>
                    <dd>@(string.IsNullOrEmpty(Model.Telefon) ? "–" : Model.Telefon)</dd>
                </dl>
                <div class="d-grid gap-2 ap-nicht-drucken">
                    @if (!string.IsNullOrWhiteSpace(postfachUrl) && Model.Status >= 2)
                    {
                        <a class="btn btn-outline-primary" href="@postfachUrl" data-sim-hinweis="postfach">
                            <i class="bi bi-envelope-paper" aria-hidden="true"></i> @L["Postfach"]
                        </a>
                    }
                    <a class="btn btn-outline-secondary" asp-controller="Termine" asp-action="Buchen"
                       asp-route-service="@(ServiceType.AntragRueckfrage)" asp-route-antragId="@Model.Id">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i> @L["Question_Button"]
                    </a>
                    @if (Model.Status >= 2)
                    {
                        <button type="button" class="btn btn-outline-secondary" data-ap-drucken>
                            <i class="bi bi-printer" aria-hidden="true"></i> @L["Print"]
                        </button>
                    }
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/antraege.js" asp-append-version="true"></script>
}

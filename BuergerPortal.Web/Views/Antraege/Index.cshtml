@model BuergerPortal.Web.Features.Antraege.AntraegeUebersichtVm
@using BuergerPortal.Web.Features.Antraege
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IViewLocalizer L
@inject IStringLocalizer<Leistungen> LK
@* Übersicht „Anträge“ (2026-10-18): eigene Anträge, angefangene Entwürfe, Leistungskatalog mit Niveau, Gebühr und Dauer,
   „So funktioniert es“. Das nötige Vertrauensniveau steht vor dem Start da – nicht erst der Step-up beim Einreichen. *@
@{
    ViewData["Title"] = L["Title"];
    var aktuelle = Model.Aktuelle.ToList();
    var entwuerfe = Model.Entwuerfe.ToList();
    var niveauName = LK[$"Niveau_{Model.Niveau}"].Value;
}
@functions {
    private string GebuehrKurz(LeistungInfo l)
    {
        if (l.Typ == Leistungen.Reisepass && Model.Geburtsdatum is { } geburt)
        {
            var betrag = Leistungen.ReisepassGebuehr(geburt, DateOnly.FromDateTime(DateTime.Today), express: false);
            // .Value mit Argumenten liefert den unformatierten Text (P-024) – deshalb string.Format
            return string.Format(L["Fee_ForYou"].Value, Leistungen.Euro(betrag, CultureInfo.CurrentUICulture));
        }
        return LK[$"{l.Schluessel}_GebuehrKurz"].Value;
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite py-4">
    <header class="ap-kopf ap-farbe-primary">
        <span class="ap-symbol" aria-hidden="true"><i class="bi bi-folder2-open"></i></span>
        <div>
            <h1 class="h3 fw-bold">@L["Heading"]</h1>
            <p class="text-body-secondary mb-2">@L["Intro"]</p>
            <span class="ap-chip"><i class="bi bi-shield-check" aria-hidden="true"></i> @L["LoggedInLevel", niveauName]</span>
        </div>
    </header>

    @if (aktuelle.Count > 0)
    {
        <section class="mb-4" aria-labelledby="hAktuell">
            <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2">
                <h2 id="hAktuell" class="h5 fw-bold mb-0">@L["Current_Heading"]</h2>
                <a asp-action="Status" class="small" id="alleAntraege">@L["Current_All", aktuelle.Count]</a>
            </div>
            <div class="ap-karte">
                @foreach (var a in aktuelle.Take(3))
                {
                    <partial name="_AntragZeile" model="a" />
                }
            </div>
        </section>
    }

    @if (entwuerfe.Count > 0)
    {
        <section class="mb-4" aria-labelledby="hEntwurf">
            <div class="d-flex justify-content-between align-items-baseline gap-2 mb-1">
                <h2 id="hEntwurf" class="h5 fw-bold mb-0">@L["Drafts_Heading"]</h2>
                @if (entwuerfe.Count > 3)
                {
                    <a asp-action="Status" asp-route-filter="entwuerfe" class="small">@L["Current_All", entwuerfe.Count]</a>
                }
            </div>
            <p class="small text-body-secondary mb-2">@L["Drafts_Text"]</p>
            <div class="ap-karte" id="entwuerfe">
                @foreach (var a in entwuerfe.Take(3))
                {
                    <partial name="_AntragZeile" model="a" />
                }
            </div>
        </section>
    }

    <section class="mb-4" aria-labelledby="hNeu">
        <h2 id="hNeu" class="h5 fw-bold mb-2">@L["New_Heading"]</h2>
        <div class="row g-3">
            @foreach (var l in Leistungen.Alle)
            {
                var reicht = Leistungen.NiveauReicht(Model.Niveau, l.Niveau);
                var noetig = LK[$"Niveau_{l.Niveau}"].Value;
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="ap-karte ap-karte-klickbar ap-leistung ap-farbe-@l.Farbe" aria-labelledby="l-@l.Schluessel">
                        <span class="ap-symbol" aria-hidden="true"><i class="bi @l.Icon"></i></span>
                        <h3 id="l-@l.Schluessel">@LK[$"{l.Schluessel}_Titel"]</h3>
                        <p class="text-body-secondary mb-0">@LK[$"{l.Schluessel}_Kurz"]</p>
                        <ul class="ap-chips" aria-label="@L["Facts"]">
                            <li class="ap-chip"><i class="bi bi-clock" aria-hidden="true"></i> @L["Minutes", l.DauerMinuten]</li>
                            <li class="ap-chip @(reicht ? "ap-chip-ok" : "ap-chip-hinweis")">
                                <i class="bi @(reicht ? "bi-shield-check" : "bi-shield-lock")" aria-hidden="true"></i> @L["Level", noetig]
                            </li>
                            <li class="ap-chip"><i class="bi bi-cash-coin" aria-hidden="true"></i> @GebuehrKurz(l)</li>
                        </ul>
                        <p class="small mb-2">@(reicht ? L["Level_Ok"] : L["Level_StepUp", noetig, niveauName])</p>
                        <details>
                            <summary>@L["Needs"]</summary>
                            <ul class="mt-2 mb-1 ps-3">
                                @foreach (var punkt in LK[$"{l.Schluessel}_Unterlagen"].Value.Split('|'))
                                {
                                    <li>@punkt</li>
                                }
                            </ul>
                            <p class="small text-body-secondary mb-0">@LK[$"{l.Schluessel}_Gebuehr"]</p>
                        </details>
                        <a class="btn btn-@l.Farbe ap-start align-self-start" id="start-@l.Schluessel"
                           asp-controller="@l.Controller" asp-action="@l.Action">
                            @L["Start"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </article>
                </div>
            }
        </div>
    </section>

    <section class="ap-karte p-3 p-md-4" aria-labelledby="hSo">
        <h2 id="hSo" class="h6 fw-bold mb-3">@L["How_Heading"]</h2>
        <ol class="row g-3 list-unstyled mb-0">
            <li class="col-12 col-md-4 d-flex gap-3">
                <span class="ap-symbol ap-symbol-klein ap-farbe-primary" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                <span><strong>@L["How1_Title"]</strong><br /><span class="small text-body-secondary">@L["How1_Text"]</span></span>
            </li>
            <li class="col-12 col-md-4 d-flex gap-3">
                <span class="ap-symbol ap-symbol-klein ap-farbe-primary" aria-hidden="true"><i class="bi bi-card-checklist"></i></span>
                <span><strong>@L["How2_Title"]</strong><br /><span class="small text-body-secondary">@L["How2_Text"]</span></span>
            </li>
            <li class="col-12 col-md-4 d-flex gap-3">
                <span class="ap-symbol ap-symbol-klein ap-farbe-primary" aria-hidden="true"><i class="bi bi-envelope-paper"></i></span>
                <span><strong>@L["How3_Title"]</strong><br /><span class="small text-body-secondary">@L["How3_Text"]</span></span>
            </li>
        </ol>
    </section>
</div>

@section Scripts {
    <script src="~/js/antraege.js" asp-append-version="true"></script>
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Applications_Title"];
}

<div class="container py-4 antraege-overview">

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 p-1">
                
                <div class="d-flex align-items-center gap-3 text-center text-md-start flex-column flex-md-row">
                    <div class="bg-warning bg-opacity-25 text-warning-emphasis rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading h6 fw-bold mb-1 text-warning-emphasis">
                            @L["Alert_LoginRequired_Title"]
                        </h5>
                        <p class="mb-0 small text-muted">
                            @L["Alert_LoginRequired_Text"]
                        </p>
                    </div>
                </div>

                <div class="w-100 w-md-auto">
                    <a class="btn btn-primary d-block d-md-inline-block rounded-pill px-4 fw-semibold shadow-sm" 
                       asp-controller="Account" 
                       asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-2"></i> @L["Login"]
                    </a>
                </div>

            </div>
        </div>
    }
    <div class="row g-4">

        <!-- Row 1: Antragsstatus (volle Breite) -->
        <div class="col-12">
            <a style="height: 10vh"
               class="card card-link stretched-link shadow-sm status-card"
               href="@Url.Action("Status", "Antraege")"
               aria-label="@L["Applications_Status_Aria"]">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <span class="app-icon app-icon-status" aria-hidden="true">
                            <!-- Inline SVG: Clipboard/Checklist -->
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M9 2h6a2 2 0 0 1 2 2h1a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6
                                         a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1a2 2 0 0 1 2-2zm0 2v2h6V4H9zM8 10h6v2H8v-2zm0 4h8v2H8v-2z" />
                            </svg>
                        </span>
                        <div>
                            <h2 class="h5 mb-1">@L["Applications_Status_Title"]</h2>
                            <p class="mb-0 text-secondary">@L["Applications_Status_Text"]</p>
                        </div>
                    </div>
                    <span class="app-chevron" aria-hidden="true">›</span>
                </div>
            </a>
        </div>

        <!-- Row 2: zwei Cards nebeneinander auf md+ -->
        <div class="col-12 col-md-6">
            <a class="card card-link stretched-link shadow-sm create-card"
               href="@Url.Action("NeuerReisepass", "ReisepassAntraege")"
               aria-label="@L["Applications_Pass_Aria"]">
                <div class="card-body d-flex align-items-start gap-3">
                    <span class="app-icon" aria-hidden="true">
                        <!-- Passport Icon -->
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M7 2h10a2 2 0 0 1 2 2v16H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm9 14H7v2h9v-2zM12 6
                                     a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 2c-.6 0-1.14.22-1.56.59.21.86.77 1.61 1.56 2.02.79-.41 1.35-1.16 1.56-2.02A2.5 2.5 0 0 0 12 8z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 mb-1">@L["Applications_Pass_Title"]</h3>
                        <p class="mb-2 text-secondary">@L["Applications_Pass_Text"]</p>
                        <span class="badge rounded-pill text-bg-primary-subtle">
                            @L["Applications_Pass_Badge"]
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a class="card card-link stretched-link shadow-sm create-card"
               href="@Url.Action("NeuerSperrmuell", "SperrmuellAntraege")"
               aria-label="@L["Applications_Bulk_Aria"]">
                <div class="card-body d-flex align-items-start gap-3">
                    <span class="app-icon" aria-hidden="true">
                        <!-- Truck / Waste Icon -->
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3 6h10v8H3V6zm10 0h4l4 4v4h-8V6zM5 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4
                                     2 2 0 0 0 0-4z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 mb-1">@L["Applications_Bulk_Title"]</h3>
                        <p class="mb-2 text-secondary">@L["Applications_Bulk_Text"]</p>
                        <span class="badge rounded-pill text-bg-success-subtle">
                            @L["Applications_Bulk_Badge"]
                        </span>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    .antraege-overview .card-link {
        border: 1px solid var(--bs-border-color);
        transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease, background-color .12s ease;
        text-decoration: none;
    }

        .antraege-overview .card-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08);
            border-color: var(--bs-primary);
            background: var(--bs-body-bg);
        }

    .antraege-overview .status-card {
        background-image: linear-gradient(180deg, color-mix(in oklab, var(--bs-primary) 16%, transparent), transparent);
    }

    .antraege-overview .app-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: .75rem;
        background: color-mix(in oklab, var(--bs-primary), var(--bs-body-bg) 80%);
        color: var(--bs-primary);
    }

    .antraege-overview .app-icon-status {
        background: color-mix(in oklab, var(--bs-info), var(--bs-body-bg) 80%);
        color: var(--bs-info);
    }

    .antraege-overview .app-chevron {
        font-size: 28px;
        line-height: 1;
        color: var(--bs-secondary-color);
        margin-left: 1rem;
    }

    @@media (prefers-reduced-motion: reduce) {
        .antraege-overview .card-link {
            transition: none;
        }
    }
</style>

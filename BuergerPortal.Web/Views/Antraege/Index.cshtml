@{
    ViewData["Title"] = "Anträge";
}

<div class="container py-4 antraege-overview">
    <div class="row g-4">

        <!-- Row 1: Antragsstatus (volle Breite) -->
        <div class="col-12">
            <a class="card card-link stretched-link shadow-sm status-card" href="@Url.Action("Status", "Antraege")" aria-label="Zu meinen Antragsstatus">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <span class="app-icon app-icon-status" aria-hidden="true">
                            <!-- Inline SVG: Clipboard/Checklist -->
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M9 2h6a2 2 0 0 1 2 2h1a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6
                                         a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1a2 2 0 0 1 2-2zm0 2v2h6V4H9zM8 10h6v2H8v-2zm0 4h8v2H8v-2z" />
                            </svg>
                        </span>
                        <div>
                            <h2 class="h5 mb-1">Meine Antragsstatus</h2>
                            <p class="mb-0 text-secondary">Übersicht aller laufenden und abgeschlossenen Anträge</p>
                        </div>
                    </div>
                    <span class="app-chevron" aria-hidden="true">›</span>
                </div>
            </a>
        </div>

        <!-- Row 2: zwei Cards nebeneinander auf md+ -->
        <div class="col-12 col-md-6">
            <a class="card card-link stretched-link shadow-sm create-card" href="@Url.Action("NeuerReisepass", "Antraege")" aria-label="Neuen Reisepass-Antrag starten">
                <div class="card-body d-flex align-items-start gap-3">
                    <span class="app-icon" aria-hidden="true">
                        <!-- Passport Icon -->
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M7 2h10a2 2 0 0 1 2 2v16H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm9 14H7v2h9v-2zM12 6
                                     a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 2c-.6 0-1.14.22-1.56.59.21.86.77 1.61 1.56 2.02.79-.41 1.35-1.16 1.56-2.02A2.5 2.5 0 0 0 12 8z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 mb-1">Neuer Antrag: Reisepass</h3>
                        <p class="mb-2 text-secondary">Daten eingeben, Termin für Antragstellung optional direkt mitbuchen.</p>
                        <span class="badge rounded-pill text-bg-primary-subtle">ca. 5–10&nbsp;Min.</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a class="card card-link stretched-link shadow-sm create-card" href="@Url.Action("NeuerSperrmuell", "Antraege")" aria-label="Neuen Sperrmüll-Antrag starten">
                <div class="card-body d-flex align-items-start gap-3">
                    <span class="app-icon" aria-hidden="true">
                        <!-- Truck / Waste Icon -->
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3 6h10v8H3V6zm10 0h4l4 4v4h-8V6zM5 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4
                                     2 2 0 0 0 0-4z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 mb-1">Neuer Antrag: Sperrmüll</h3>
                        <p class="mb-2 text-secondary">Abholadresse & Gegenstände erfassen, Wunsch-Abholtermin vorschlagen.</p>
                        <span class="badge rounded-pill text-bg-success-subtle">max. 5&nbsp;Min.</span>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>
<style>
    .antraege-overview .card-link {
        border: 1px solid var(--bs-border-color);
        transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease, background-color .12s ease;
        text-decoration: none;
    }

        .antraege-overview .card-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08);
            border-color: var(--bs-primary);
            background: var(--bs-body-bg);
        }

    .antraege-overview .status-card {
        /* sanfter Verlauf je nach Theme */
        background-image: linear-gradient(180deg, color-mix(in oklab, var(--bs-primary) 16%, transparent), transparent);
    }

    .antraege-overview .app-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: .75rem;
        background: color-mix(in oklab, var(--bs-primary), var(--bs-body-bg) 80%);
        color: var(--bs-primary);
    }

    .antraege-overview .app-icon-status {
        background: color-mix(in oklab, var(--bs-info), var(--bs-body-bg) 80%);
        color: var(--bs-info);
    }

    .antraege-overview .app-chevron {
        font-size: 28px;
        line-height: 1;
        color: var(--bs-secondary-color);
        margin-left: 1rem;
    }

    @@media (prefers-reduced-motion: reduce) {
        .antraege-overview .card-link

    {
        transition: none;
    }

    }
</style>
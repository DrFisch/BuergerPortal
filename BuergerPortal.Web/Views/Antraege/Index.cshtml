@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Applications_Title"];
}

<div class="container py-5 antraege-overview">
    @if (User?.Identity?.IsAuthenticated != true)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-5 p-4" role="alert">
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <div class="alert-icon-circle bg-warning bg-opacity-25 text-warning">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                </div>
                <div class="flex-grow-1">
                    <h5 class="alert-heading fw-bold mb-1">@L["Alert_LoginRequired_Title"]</h5>
                    <p class="mb-0 opacity-75">@L["Alert_LoginRequired_Text"]</p>
                </div>
                <a class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>@L["Login"]
                </a>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-12">
            <a href="@Url.Action("Status", "Antraege")" class="card main-card status-card">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="icon-box status-icon me-4">
                        <i class="bi bi-clipboard2-check fs-3"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-1">@L["Applications_Status_Title"]</h2>
                        <p class="text-secondary mb-0">@L["Applications_Status_Text"]</p>
                    </div>
                    <i class="bi bi-chevron-right ms-auto fs-4 text-secondary opacity-50"></i>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a href="@Url.Action("NeuerReisepass", "ReisepassAntraege")" class="card application-card h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="icon-box pass-icon">
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                        <span class="badge badge-modern bg-primary-subtle text-primary-emphasis">@L["Applications_Pass_Badge"]</span>
                    </div>
                    <h3 class="h5 fw-bold">@L["Applications_Pass_Title"]</h3>
                    <p class="text-secondary flex-grow-1">@L["Applications_Pass_Text"]</p>
                    <div class="mt-3 text-primary fw-semibold small">@L["Start_Application"] <i class="bi bi-arrow-right ms-1"></i></div>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a href="@Url.Action("NeuerSperrmuell", "SperrmuellAntraege")" class="card application-card h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="icon-box bulk-icon">
                            <i class="bi bi-truck fs-3"></i>
                        </div>
                        <span class="badge badge-modern bg-success-subtle text-success-emphasis">@L["Applications_Bulk_Badge"]</span>
                    </div>
                    <h3 class="h5 fw-bold">@L["Applications_Bulk_Title"]</h3>
                    <p class="text-secondary flex-grow-1">@L["Applications_Bulk_Text"]</p>
                    <div class="mt-3 text-success fw-semibold small">@L["Schedule_Pickup"] <i class="bi bi-arrow-right ms-1"></i></div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    /* Allgemeine Karten-Struktur */
    .antraege-overview .card {
        border: 1px solid var(--bs-border-color);
        border-radius: 1.25rem;
        background-color: var(--bs-card-bg); /* Nutzt Bootstrap Card-Hintergrund */
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
    }

        /* Hover-Effekt: Etwas heller im Darkmode, Schatten im Lightmode */
        .antraege-overview .card:hover {
            transform: translateY(-4px);
            border-color: var(--bs-primary-border-subtle);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            background-color: var(--bs-tertiary-bg);
        }

    /* Status Card sanfter Verlauf */
    .status-card {
        background-image: linear-gradient(135deg, var(--bs-primary-bg-subtle) 0%, var(--bs-card-bg) 100%);
    }

    /* Icon Boxen */
    .icon-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 12px;
        transition: transform 0.3s ease;
    }

    .antraege-overview .card:hover .icon-box {
        transform: scale(1.1);
    }

    /* Farbschemata für Icons */
    .status-icon {
        background-color: var(--bs-info-bg-subtle);
        color: var(--bs-info-text-emphasis);
    }

    .pass-icon {
        background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-primary-text-emphasis);
    }

    .bulk-icon {
        background-color: var(--bs-success-bg-subtle);
        color: var(--bs-success-text-emphasis);
    }

    /* Badges */
    .badge-modern {
        padding: 0.5rem 0.85rem;
        border-radius: 50rem;
        font-weight: 600;
        font-size: 0.75rem;
        letter-spacing: 0.02em;
    }

    /* Login Alert Circle */
    .alert-icon-circle {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Fix für gleiche Höhe der h3/p Elemente */
    .application-card .card-body {
        height: 100%;
    }

    /* Reduzierte Animationen für User-Präferenz */
    @@media (prefers-reduced-motion: reduce) {
        .antraege-overview .card {
            transition: none;
        }
    }
</style>
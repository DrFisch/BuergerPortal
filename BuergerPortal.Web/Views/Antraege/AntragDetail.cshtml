@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.AntragDetailVm
@using BuergerPortal.Web.Features.Termine.ViewModels
@{
    ViewData["Title"] = "Antrag – Details";
}
<div class="container py-4">
    @if (TempData["AntragTerminOk"] is string bookedMsg)
    {
        <div class="alert alert-success">@bookedMsg</div>
    }

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <h1 class="h4 mb-0">Reisepassantrag</h1>
        <span class="badge @Model.BadgeClass">@Model.StatusText</span>
    </div>

    <div class="progress mb-3" role="progressbar" aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width:@Model.ProgressPercent%"></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Antragsdaten</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Antragsteller</dt>
                        <dd class="col-sm-8">@Model.Antragsteller</dd>

                        <dt class="col-sm-4">Geburtsdatum</dt>
                        <dd class="col-sm-8">@Model.Geburtsdatum:dd.MM.yyyy</dd>

                        <dt class="col-sm-4">Express</dt>
                        <dd class="col-sm-8">@((Model.Express ? "Ja" : "Nein"))</dd>

                        <dt class="col-sm-4">Alter Pass vorhanden</dt>
                        <dd class="col-sm-8">@((Model.AltpassVorhanden ? "Ja" : "Nein"))</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Hinweis))
                        {
                            <dt class="col-sm-4">Hinweis</dt>
                            <dd class="col-sm-8">@Model.Hinweis</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>Verlauf</span>
                    <span class="badge @Model.BadgeClass">@Model.StatusText</span>
                </div>
                <div class="card-body">
                    <ol class="timeline-vertical list-unstyled mb-0">
                        <li class="tl-item @(Model.CreatedUtc != default ? "done" : "")">
                            <div class="tl-dot"></div>
                            <div class="tl-content">
                                <div class="tl-title">Angelegt</div>
                                <div class="tl-meta">@Model.CreatedUtc:dd.MM.yyyy HH:mm</div>
                            </div>
                        </li>

                        <li class="tl-item @(Model.SubmittedUtc.HasValue ? "done" : "")">
                            <div class="tl-dot"></div>
                            <div class="tl-content">
                                <div class="tl-title">Eingereicht</div>
                                @if (Model.SubmittedUtc.HasValue)
                                {
                                    <div class="tl-meta">@Model.SubmittedUtc:dd.MM.yyyy HH:mm</div>
                                }
                                else
                                {
                                    <div class="tl-meta text-secondary">noch nicht erfolgt</div>
                                }
                            </div>
                        </li>

                        <li class="tl-item @((Model.ProgressPercent >= 70) ? "done" : "")">
                            <div class="tl-dot"></div>
                            <div class="tl-content">
                                <div class="tl-title">Prüfung</div>
                                <div class="tl-meta @(Model.ProgressPercent >= 70 ? "" : "text-secondary")">
                                    @(Model.ProgressPercent >= 70 ? "läuft/abgeschlossen" : "ausstehend")
                                </div>
                            </div>
                        </li>

                        <li class="tl-item @((Model.ProgressPercent >= 100) ? "done" : "")">
                            <div class="tl-dot"></div>
                            <div class="tl-content">
                                <div class="tl-title">Abschluss</div>
                                <div class="tl-meta @(Model.ProgressPercent >= 100 ? "" : "text-secondary")">
                                    @(Model.ProgressPercent >= 100 ? "abgeschlossen" : "ausstehend")
                                </div>
                            </div>
                        </li>
                    </ol>
                </div>
            </div>

        </div>
        

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Kontakt & Aktionen</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <div class="mb-2"><span class="text-secondary small d-block">E-Mail</span>@Model.Email</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Telefon))
                    {
                        <div class="mb-3"><span class="text-secondary small d-block">Telefon</span>@Model.Telefon</div>
                    }

                    <a class="btn btn-outline-primary w-100"
                       asp-controller="Termine"
                       asp-action="Buchen"
                       asp-route-service="@(ServiceType.AntragRueckfrage)"
                       asp-route-antragId="@Model.Id">
                        Termin zur Klärung buchen
                    </a>


                    <div class="text-secondary small mt-2">
                        Du wirst zur Terminbuchung weitergeleitet (Dienst vorbelegt: „Antrag Rückfrage“).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline li::marker {
            content: "• "
        }
        /* --- Timeline --- */
        .timeline-vertical {
            position: relative;
            margin: 0;
            padding-left: 1.25rem;
        }

            .timeline-vertical::before {
                content: "";
                position: absolute;
                left: .5rem;
                top: .25rem;
                bottom: .25rem;
                width: 2px;
                background: var(--bs-border-color);
                opacity: .7;
            }

        .tl-item {
            position: relative;
            padding-left: 1.25rem;
            margin-bottom: .75rem;
        }

            .tl-item:last-child {
                margin-bottom: 0;
            }

        .tl-dot {
            position: absolute;
            left: -.1rem;
            top: .25rem;
            width: .75rem;
            height: .75rem;
            border-radius: 50%;
            background: var(--bs-secondary-bg);
            border: 2px solid var(--bs-border-color);
            box-shadow: 0 0 0 2px var(--bs-body-bg);
        }

        .tl-item.done .tl-dot {
            background: var(--bs-success);
            border-color: var(--bs-success);
            box-shadow: 0 0 0 3px color-mix(in oklab, var(--bs-success) 20%, transparent);
        }

        .tl-content {
            margin-left: .25rem;
        }

        .tl-title {
            font-weight: 600;
        }

        .tl-meta {
            font-size: .875rem;
            color: var(--bs-secondary-color);
        }

        /* Optional: Fortschritts-Header sauberer */
        .progress {
            height: .6rem;
        }
    </style>
}

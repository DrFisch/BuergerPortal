@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.AntragDetailVm
@using BuergerPortal.Web.Features.Termine.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["ApplicationDetails_Title"];
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 fw-bold mb-0">@L["ApplicationDetails_Heading"]</h1>
    </div>

    @if (TempData["AntragTerminOk"] is string bookedMsg)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-3">
            <i class="bi bi-check-circle-fill fs-4"></i>
            <div>@bookedMsg</div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-uppercase tracking-wider small fw-bold text-secondary">@L["CurrentStatus"]</span>
                <span class="badge badge-modern @Model.BadgeClass">@Model.StatusText</span>
            </div>
            <div class="progress rounded-pill mb-2" style="height: 12px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width:@Model.ProgressPercent%"
                     aria-valuenow="@Model.ProgressPercent"
                     aria-valuemin="0"
                     aria-valuemax="100"></div>
            </div>
            <div class="d-flex justify-content-between small text-muted">
                <span>@L["Started"]</span>
                <span>@Model.ProgressPercent% @L["Completed"]</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">@L["ApplicationDetails_DataCardTitle"]</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <label class="text-secondary small fw-bold text-uppercase">@L["ApplicationDetails_Field_Applicant"]</label>
                            <p class="fs-5 mb-0 fw-medium">@Model.Antragsteller</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-secondary small fw-bold text-uppercase">@L["ApplicationDetails_Field_BirthDate"]</label>
                            <p class="fs-5 mb-0 fw-medium">@Model.Geburtsdatum.ToString("dd.MM.yyyy")</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-secondary small fw-bold text-uppercase">@L["ApplicationDetails_Field_Express"]</label>
                            <p class="mb-0">
                                @if (Model.Express)
                                {
                                    <span class="text-danger fw-bold"><i class="bi bi-lightning-fill me-1"></i>@L["Yes"]</span>
                                }
                                else
                                {
                                    <span>@L["No"]</span>
                                }
                            </p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-secondary small fw-bold text-uppercase">@L["ApplicationDetails_Field_OldPass"]</label>
                            <p class="mb-0">@((Model.AltpassVorhanden ? L["Yes"] : L["No"]))</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Hinweis))
                        {
                            <div class="col-12">
                                <label class="text-secondary small fw-bold text-uppercase">@L["ApplicationDetails_Field_Note"]</label>
                                <div class="p-3 bg-body-tertiary rounded-3 mt-1 small">@Model.Hinweis</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">@L["ApplicationDetails_Timeline_Title"]</h5>
                </div>
                <div class="card-body p-4">
                    <div class="modern-timeline">
                        <div class="tl-item @(Model.CreatedUtc != default ? "active" : "")">
                            <div class="tl-icon"><i class="bi bi-file-earmark-plus"></i></div>
                            <div class="tl-content">
                                <div class="fw-bold">@L["ApplicationDetails_Timeline_Created"]</div>
                                <div class="small text-muted">@Model.CreatedUtc.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="tl-item @(Model.SubmittedUtc.HasValue ? "active" : "")">
                            <div class="tl-icon"><i class="bi bi-send"></i></div>
                            <div class="tl-content">
                                <div class="fw-bold">@L["ApplicationDetails_Timeline_Submitted"]</div>
                                <div class="small text-muted">
                                    @(Model.SubmittedUtc.HasValue? Model.SubmittedUtc.Value.ToString("dd.MM.yyyy HH:mm") : L["ApplicationDetails_Timeline_Submitted_NotYet"])
                                </div>
                            </div>
                        </div>

                        <div class="tl-item @((Model.ProgressPercent >= 70) ? "active" : "")">
                            <div class="tl-icon"><i class="bi bi-search"></i></div>
                            <div class="tl-content">
                                <div class="fw-bold">@L["ApplicationDetails_Timeline_Review"]</div>
                                <div class="small text-muted">
                                    @(Model.ProgressPercent >= 70 ? L["ApplicationDetails_Timeline_Review_InProgressOrDone"] : L["ApplicationDetails_Timeline_Pending"])
                                </div>
                            </div>
                        </div>

                        <div class="tl-item @((Model.ProgressPercent >= 100) ? "active" : "")">
                            <div class="tl-icon"><i class="bi bi-check2-all"></i></div>
                            <div class="tl-content">
                                <div class="fw-bold">@L["ApplicationDetails_Timeline_Completed"]</div>
                                <div class="small text-muted">
                                    @(Model.ProgressPercent >= 100 ? L["ApplicationDetails_Timeline_Completed_Done"] : L["ApplicationDetails_Timeline_Pending"])
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">@L["ApplicationDetails_ContactCardTitle"]</h5>

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="icon-circle bg-primary-subtle text-primary">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div class="overflow-hidden">
                            <span class="text-secondary x-small d-block fw-bold text-uppercase">@L["ApplicationDetails_Email_Label"]</span>
                            <span class="text-truncate d-block">@Model.Email</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="icon-circle bg-success-subtle text-success">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div>
                            <span class="text-secondary x-small d-block fw-bold text-uppercase">@L["ApplicationDetails_Phone_Label"]</span>
                            <span>@Model.Telefon</span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-50">

                    <a class="btn btn-primary btn-sm rounded-pill w-100 fw-bold shadow-sm mb-3 text-nowrap"
                       asp-controller="Termine"
                       asp-action="Buchen"
                       asp-route-service="@(ServiceType.AntragRueckfrage)"
                       asp-route-antragId="@Model.Id">
                        @L["ApplicationDetails_Appointment_Button"]
                    </a>

                    <p class="text-secondary x-small text-center mb-0 px-2">
                        @L["ApplicationDetails_Appointment_Info"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: var(--bs-tertiary-bg);
        }

        .badge-modern {
            padding: 0.6em 1.2em;
            border-radius: 50rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .modern-timeline {
            position: relative;
            padding-left: 20px;
        }

            .modern-timeline::before {
                content: '';
                position: absolute;
                left: 39px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: var(--bs-border-color);
                opacity: 0.5;
            }

        .tl-item {
            position: relative;
            display: flex;
            gap: 25px;
            padding-bottom: 30px;
            z-index: 1;
        }

            .tl-item:last-child {
                padding-bottom: 0;
            }

        .tl-icon {
            width: 40px;
            height: 40px;
            background: var(--bs-body-bg);
            border: 2px solid var(--bs-border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--bs-secondary-color);
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .tl-item.active .tl-icon {
            background: var(--bs-success);
            border-color: var(--bs-success);
            color: white;
            box-shadow: 0 0 0 5px var(--bs-success-bg-subtle);
        }

        .tl-item.active .tl-content .fw-bold {
            color: var(--bs-emphasis-color);
        }

        .x-small {
            font-size: 0.7rem;
        }

        .tracking-wider {
            letter-spacing: 0.08em;
        }

        [data-bs-theme="dark"] .card {
            background-color: var(--bs-body-bg);
        }
    </style>
}
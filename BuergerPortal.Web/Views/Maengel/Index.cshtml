@using BuergerPortal.Web.Helper
@model IReadOnlyList<BuergerPortal.Web.Features.Maengel.Contracts.MaengelmeldungResponse>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

@{
    ViewData["Title"] = T["Title"];
}

<div class="container py-4" style="max-width: 850px;">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h3 fw-bold mb-0">@T["Title"]</h1>
            <p class="text-muted small mb-0">@T["Lead"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T["New"]</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info border-0 rounded-4" role="status">@T["Empty"]</div>
    }

    <div class="vstack gap-3" id="meineMeldungen">
        @foreach (var m in Model)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex gap-3 align-items-start">
                    @if (m.HatFoto)
                    {
                        <img src="@Url.Action("Foto", new { id = m.Id })" alt="@T["PhotoAlt", m.Titel]" class="rounded-3 border flex-shrink-0"
                             style="width: 96px; height: 96px; object-fit: cover;" loading="lazy" />
                    }
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between gap-2 flex-wrap">
                            <h2 class="h6 fw-bold mb-1">@m.Titel</h2>
                            @{ var status = T[$"Status_{m.Status}"]; }
                            <span class="badge text-bg-secondary">@(status.IsResourceNotFound ? m.Status : status.Value)</span>
                        </div>
                        <div class="small text-muted mb-1">@T["ReportedAt", m.CreatedUtc.ToBerlin().ToString("dd.MM.yyyy"), m.CreatedUtc.ToBerlin().ToString("HH:mm")]</div>
                        <p class="small mb-0">@m.Beschreibung</p>
                        @if (!string.IsNullOrWhiteSpace(m.AddressHint))
                        {
                            <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@m.AddressHint</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

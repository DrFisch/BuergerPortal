@model BuergerPortal.Web.Features.Maengel.ViewModels.CreateMangelVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

@{
    ViewData["Title"] = T["Title"];
}

<div class="container py-4" style="max-width: 850px;">
    @* Kopf wie bei der Terminbuchung: zurück zur Startseite, Titel, kurzer Hinweis *@
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm" aria-label="@T["Back"]">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">@T["Heading"]</h1>
            <p class="text-muted small mb-0">@T["Lead"]</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill ms-auto" id="meineMeldungenLink">
            <i class="bi bi-list-check me-1" aria-hidden="true"></i>@T["MyReports"]
        </a>
    </div>

    @if (TempData["Meldung"] is string info)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
            <div class="fw-medium">@info</div>
        </div>
    }

    <form asp-action="Create" method="post" id="mangelForm" class="vstack gap-4" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 mb-4 d-flex align-items-start gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                        <div asp-validation-summary="All" class="small fw-medium"></div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Titel" class="form-label fw-bold text-secondary small text-uppercase tracking-wider">@T["Label_Title"]</label>
                        <input asp-for="Titel" class="form-control" placeholder="@T["Placeholder_Title"]" />
                        <span asp-validation-for="Titel" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Beschreibung" class="form-label fw-bold text-secondary small text-uppercase tracking-wider">@T["Label_Description"]</label>
                        <textarea asp-for="Beschreibung" rows="4" class="form-control form-control-lg rounded-3"
                                  placeholder="@T["Placeholder_Description"]"></textarea>
                        <span asp-validation-for="Beschreibung" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="AddressHint" class="form-label fw-bold text-secondary small text-uppercase tracking-wider">@T["Label_AddressHint"]</label>
                        <input asp-for="AddressHint" class="form-control" placeholder="@T["Placeholder_AddressHint"]" />
                        <div class="form-text x-small mt-1 text-muted">@T["Help_AddressHint"]</div>
                    </div>

                    @* Foto (optional): wird im Browser verkleinert, die Kamera-Metadaten (z. B. GPS) fallen dabei weg – wwwroot/js/mangel-foto.js *@
                    <div class="col-12">
                        <span class="form-label fw-bold text-secondary small text-uppercase tracking-wider d-block">@T["Label_Photo"]</span>
                        <div class="d-flex flex-wrap gap-2">
                            <label class="btn btn-outline-primary rounded-pill mb-0">
                                <i class="bi bi-camera me-1" aria-hidden="true"></i>@T["Photo_Take"]
                                <input type="file" accept="image/*" capture="environment" data-foto-quelle hidden />
                            </label>
                            <label class="btn btn-outline-secondary rounded-pill mb-0">
                                <i class="bi bi-image me-1" aria-hidden="true"></i>@T["Photo_Choose"]
                                <input type="file" accept="image/*" data-foto-quelle hidden />
                            </label>
                        </div>
                        <input type="file" name="Foto" id="fotoUpload" accept="image/jpeg,image/png,image/webp" hidden />
                        <div id="fotoVorschauBox" class="mt-3" hidden>
                            <img id="fotoVorschau" alt="@T["Photo_PreviewAlt"]" class="rounded-3 border" style="max-width: 240px; max-height: 240px;" />
                            <button type="button" id="fotoEntfernen" class="btn btn-link btn-sm text-danger">@T["Photo_Remove"]</button>
                        </div>
                        @* Meldungen von wwwroot/js/mangel-foto.js – übersetzt über data-t-* (Plan A9) *@
                        <div id="fotoStatus" class="form-text x-small mt-1 text-muted" role="status"
                             data-t-auswahl="@T["Photo_Status_Choose"]" data-t-verkleinern="@T["Photo_Status_Resizing"]"
                             data-t-angehaengt="@T["Photo_Status_Attached"].Value" data-t-fehler="@T["Photo_Status_Error"]"></div>
                        @* .Value: Rohtext mit Platzhalter {0} – die Zahl setzt mangel-foto.js ein (sonst FormatException beim Ausgeben) *@
                        <span asp-validation-for="Foto" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 mt-5">
                        <div class="location-picker-card rounded-4 p-4 border border-primary-subtle d-flex align-items-center justify-content-between flex-wrap gap-4 shadow-sm"
                             style="background: var(--bs-primary-bg-subtle);">

                            <div class="d-flex align-items-center gap-3">
                                <div class="location-icon-box bg-primary text-white rounded-3 shadow-sm">
                                    <i class="bi bi-geo-alt-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-primary-emphasis">@T["Location_Heading"]</div>
                                    <div id="coordSummary" class="text-secondary small fw-medium">@T["Location_None"]</div>
                                </div>
                            </div>

                            <div>
                                <input asp-for="Latitude" type="hidden" />
                                <input asp-for="Longitude" type="hidden" />
                                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold hover-lift"
                                        data-bs-toggle="modal" data-bs-target="#mapModal">
                                    <i class="bi bi-map me-2"></i> @T["Map_Open"]
                                </button>
                            </div>
                        </div>
                        <div id="locStatusSummary" class="x-small text-success fw-bold mt-2 ms-2"></div>
                    </div>
                </div>
            </div>

            <div class="p-4 d-flex justify-content-between align-items-center bg-body border-top border-light-subtle rounded-bottom-4">
                <div class="text-secondary small d-none d-md-flex align-items-center gap-2">
                    
                </div>

                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm fw-bold hover-lift d-inline-flex align-items-center">
                    <span>@T["Submit"]</span>
                </button>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="mapModal" tabindex="-1" aria-labelledby="mapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header p-4">
                <h5 class="modal-title fw-bold" id="mapModalLabel">
                    <i class="bi bi-pin-map text-primary me-2"></i>@T["Map_Title"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="row g-2 mb-4">
                    <div class="col-md-8">
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                            <input type="text" id="mapSearchInput" class="form-control border-start-0 ps-0" placeholder="@T["Map_SearchPlaceholder"]" aria-label="@T["Map_SearchPlaceholder"]" />
                            <button class="btn btn-primary px-4 fw-bold" type="button" id="mapSearchBtn">@T["Map_Search"]</button>
                        </div>
                        <div id="searchStatus" class="x-small text-muted mt-1 ps-2"></div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 fw-bold h-100 shadow-sm" id="btnLocate">
                            <i class="bi bi-crosshair me-2"></i> @T["Map_UseGps"]
                        </button>
                    </div>
                </div>

                <div id="map" class="mangel-map-modal border rounded-4"></div>

                <div class="d-flex justify-content-between align-items-center mt-3 px-1 flex-wrap gap-2">
                    <div id="locStatusModal" class="small text-primary fw-bold"></div>
                    <div class="x-small text-secondary fw-medium">
                        <i class="bi bi-info-circle me-1"></i> @T["Map_Hint"]
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-4 rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">@T["Cancel"]</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-dismiss="modal">
                    @T["Map_Apply"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body {
            background-color: var(--bs-tertiary-bg);
        }

        .location-picker-card {
            border: 2px dashed var(--bs-primary-border-subtle) !important;
            transition: all 0.3s ease;
        }

        .location-icon-box {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mangel-map-modal {
            height: 550px;
            max-height: 65vh;
            z-index: 1;
        }

        .x-small {
            font-size: 0.75rem;
        }

        .tracking-wider {
            letter-spacing: 0.05em;
        }

        .form-control-lg, .form-select-lg {
            font-size: 1rem;
            padding: 0.75rem 1rem;
        }

        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .hover-lift:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(var(--bs-primary-rgb), 0.2) !important;
            }

        /* Leaflet Darkmode Tweak */
        [data-bs-theme="dark"] .leaflet-tile {
            filter: brightness(0.6) invert(1) contrast(3) hue-rotate(200deg) saturate(0.3);
        }

        [data-bs-theme="dark"] .leaflet-container {
            background: #2b3035;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/mangel-foto.js" asp-append-version="true"></script>

    <script>
        (function () {
            // Texte des Skripts aus den Ressourcen (Deutsch/Englisch, Plan A9)
            const TX = @Json.Serialize(new Dictionary<string, string>
            {
                ["none"] = T["Location_None"].Value, ["captured"] = T["Js_Captured"].Value, ["dragged"] = T["Js_Dragged"].Value,
                ["clicked"] = T["Js_Clicked"].Value, ["noGps"] = T["Js_NoGps"].Value, ["locating"] = T["Js_Locating"].Value,
                ["located"] = T["Js_Located"].Value, ["gpsError"] = T["Js_GpsError"].Value, ["searching"] = T["Js_Searching"].Value,
                ["notFound"] = T["Js_NotFound"].Value, ["found"] = T["Js_Found"].Value, ["searchFailed"] = T["Js_SearchFailed"].Value,
            });
            const latInput = document.querySelector('[name="Latitude"]');
            const lngInput = document.querySelector('[name="Longitude"]');
            const coordSummary = document.getElementById('coordSummary');
            const locStatusSummary = document.getElementById('locStatusSummary');
            const btnLocate = document.getElementById('btnLocate');
            const mapModalEl = document.getElementById('mapModal');
            const searchInput = document.getElementById('mapSearchInput');
            const searchBtn = document.getElementById('mapSearchBtn');
            const searchStatus = document.getElementById('searchStatus');
            const locStatusModal = document.getElementById('locStatusModal');

            const defaultLat = 49.0;
            const defaultLng = 11.0;

            let map, marker, mapInitialized = false;

            function updateSummary(lat, lng) {
                if (!lat || !lng) {
                    coordSummary.textContent = TX.none;
                    locStatusSummary.textContent = "";
                    return;
                }
                coordSummary.innerHTML = `<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">Lat: ${lat.toFixed(5)}</span>
                                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Lng: ${lng.toFixed(5)}</span>`;
                locStatusSummary.textContent = "✓ " + TX.captured;
            }

            function updateInputsAndSummary(lat, lng) {
                latInput.value = lat;
                lngInput.value = lng;
                updateSummary(lat, lng);
            }

            function initMap() {
                map = L.map('map').setView([defaultLat, defaultLng], 14);
                L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);

                let startLat = parseFloat(latInput.value) || defaultLat;
                let startLng = parseFloat(lngInput.value) || defaultLng;

                marker = L.marker([startLat, startLng], { draggable: true }).addTo(map);
                map.setView([startLat, startLng], 14);

                marker.on('dragend', () => {
                    const pos = marker.getLatLng();
                    updateInputsAndSummary(pos.lat, pos.lng);
                    locStatusModal.textContent = TX.dragged;
                });

                map.on('click', (e) => {
                    marker.setLatLng(e.latlng);
                    updateInputsAndSummary(e.latlng.lat, e.latlng.lng);
                    locStatusModal.textContent = TX.clicked;
                });
            }

            mapModalEl.addEventListener('shown.bs.modal', () => {
                if (!mapInitialized) {
                    initMap();
                    mapInitialized = true;
                } else {
                    map.invalidateSize();
                }
            });

            btnLocate.addEventListener('click', () => {
                if (!navigator.geolocation) {
                    locStatusModal.textContent = TX.noGps;
                    return;
                }
                locStatusModal.textContent = TX.locating;
                navigator.geolocation.getCurrentPosition((pos) => {
                    const { latitude: lat, longitude: lng } = pos.coords;
                    map.setView([lat, lng], 17);
                    marker.setLatLng([lat, lng]);
                    updateInputsAndSummary(lat, lng);
                    locStatusModal.textContent = TX.located;
                }, () => {
                    locStatusModal.textContent = TX.gpsError;
                }, { enableHighAccuracy: true });
            });

            function searchLocation() {
                const query = searchInput.value.trim();
                if (!query) return;
                searchStatus.textContent = TX.searching;
                fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`)
                    .then(r => r.json())
                    .then(results => {
                        if (!results.length) { searchStatus.textContent = TX.notFound; return; }
                        const { lat, lon, display_name } = results[0];
                        const l = parseFloat(lat), n = parseFloat(lon);
                        map.setView([l, n], 16);
                        marker.setLatLng([l, n]);
                        updateInputsAndSummary(l, n);
                        searchStatus.textContent = display_name;
                        locStatusModal.textContent = TX.found;
                    }).catch(() => searchStatus.textContent = TX.searchFailed);
            }

            searchBtn.addEventListener('click', searchLocation);
            searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); searchLocation(); } });

            // Initiales Summary
            const initLat = parseFloat(latInput.value), initLng = parseFloat(lngInput.value);
            updateSummary(isNaN(initLat) ? null : initLat, isNaN(initLng) ? null : initLng);
        })();
    </script>
}
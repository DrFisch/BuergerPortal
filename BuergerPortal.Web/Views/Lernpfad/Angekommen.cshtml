@model BuergerPortal.Web.Features.Lernpfad.LernpfadAngekommenVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    ViewData["Title"] = T["Title"];
    // Lernpfad Schritt 5: Code gegen Tokens getauscht, ID-Token geprüft, Sitzung angelegt (Controllers/LernpfadController.cs)
    var info = Model.Info;
    var zeit = (DateTime? utc) => utc is { } u
        ? TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.SpecifyKind(u, DateTimeKind.Utc), "Europe/Berlin").ToString("dd.MM.yyyy, HH:mm:ss")
        : "–";
}
<div class="container py-4" style="max-width: 980px;">
    <partial name="_LernpfadSchritte" model="5" />

    <h1 class="h3 fw-bold">@T["Heading"]</h1>
    <p class="lead fs-6">@T["Lead"]</p>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold">@T["Flow_Title"]</h2>
            <ol class="mb-0">
                <li>@T["Flow_Callback"]</li>
                <li>@T["Flow_Token"]</li>
                <li>@T["Flow_Validate"]</li>
                <li>@T["Flow_Session"]</li>
            </ol>
        </div>
    </div>

    @if (info != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">@T["Token_Title"]</h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-4">@T["Token_Received"]</dt>
                    <dd class="col-sm-8">@string.Join(", ", info.Tokens)@(info.AccessTokenSekunden is { } s ? $" · access_token {s / 60} min" : "")</dd>
                    <dt class="col-sm-4">@T["Token_Alg"]</dt>
                    <dd class="col-sm-8"><code>@(info.Algorithmus ?? "–")</code> · kid <code>@(info.Schluessel ?? "–")</code></dd>
                    <dt class="col-sm-4">@T["Token_Iss"]</dt>
                    <dd class="col-sm-8 text-break"><code>@(info.Aussteller ?? "–")</code></dd>
                    <dt class="col-sm-4">@T["Token_Aud"]</dt>
                    <dd class="col-sm-8"><code>@(info.Zielgruppe ?? "–")</code></dd>
                    <dt class="col-sm-4">@T["Token_Time"]</dt>
                    <dd class="col-sm-8">@zeit(info.AusgestelltUtc) → @zeit(info.GueltigBisUtc)</dd>
                    <dt class="col-sm-4">@T["Token_Nonce"]</dt>
                    <dd class="col-sm-8">@(info.NonceGeprueft ? T["Yes"] : T["No"])</dd>
                    <dt class="col-sm-4">@T["Token_Level"]</dt>
                    <dd class="col-sm-8"><code>@(info.Niveau ?? "–")</code> · <code>@(info.Mittel ?? "–")</code></dd>
                    @if (!string.IsNullOrEmpty(info.Scope))
                    {
                        <dt class="col-sm-4">scope</dt>
                        <dd class="col-sm-8 text-break"><code>@info.Scope</code></dd>
                    }
                </dl>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold">@T["Claims_Title"]</h2>
            <p class="small text-body-secondary">@T["Claims_Intro"]</p>
            <div class="table-responsive" tabindex="0" role="region" aria-labelledby="lernClaims">
                <table class="table table-sm align-top mb-0">
                    <caption class="visually-hidden" id="lernClaims">@T["Claims_Title"]</caption>
                    <thead><tr><th scope="col">Claim</th><th scope="col">@T["Col_Value"]</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Claims)
                        {
                            <tr><th scope="row"><code>@c.Name</code></th><td class="small text-break">@c.Wert</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 bg-primary-subtle rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold">@T["Recap_Title"]</h2>
            <p class="mb-0">@T["Recap_Text"]</p>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a class="btn btn-primary btn-lg rounded-pill px-4" href="@Model.Ziel" id="lernFertig">
            @T["Done"] <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
        </a>
        <a class="btn btn-outline-primary rounded-pill" asp-controller="MeineDaten" asp-action="SamlInspektor">
            <i class="bi bi-code-square me-1" aria-hidden="true"></i>@T["Inspector"]
        </a>
        <a class="btn btn-outline-primary rounded-pill" asp-controller="Termine" asp-action="Buchen">
            <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>@T["BookNext"]
        </a>
    </div>
</div>

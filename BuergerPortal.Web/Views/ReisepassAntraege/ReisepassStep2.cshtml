@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.ReisepassStep2Vm
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["PassportStep2_Title"];
}

<div class="container py-4">
    <nav aria-label="@L["PassportStep2_Progress_Aria"]" class="mb-4">
        <ol class="progress-steps">
            <li>@L["PassportStep2_Step1"]</li>
            <li class="active">@L["PassportStep2_Step2"]</li>
        </ol>
        <div class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width:100%">
                @L["PassportStep2_ProgressLabel"]
            </div>
        </div>
    </nav>

    <h1 class="h4 mb-3">@L["PassportStep2_Heading"]</h1>

    @if (TempData["AntragInfo"] is string info)
    {
        <div class="alert alert-info">@info</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <strong>@L["PassportStep2_Applicant"]</strong>
                    <div>@Model.AntragstellerName</div>
                    @if (Model.Geburtsdatum.HasValue)
                    {
                        <div>
                            <small>@L["PassportStep2_Birthdate"]: @Model.Geburtsdatum.Value.ToString("dd.MM.yyyy")</small>
                        </div>
                    }
                </div>
                <span class="badge text-bg-secondary">@L["PassportStep2_Id"]: @Model.Id</span>
            </div>
        </div>
    </div>

    <form asp-action="ReisepassStep2" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12">
            <div class="form-check form-switch">
                <input class="form-check-input" asp-for="Express" />
                <label class="form-check-label" asp-for="Express"></label>
            </div>
        </div>

        <div class="col-12">
            <div class="form-check form-switch">
                <input class="form-check-input" asp-for="AltpassVorhanden" />
                <label class="form-check-label" asp-for="AltpassVorhanden"></label>
            </div>
        </div>

        <div class="col-12">
            <label asp-for="Hinweis" class="form-label"></label>
            <textarea asp-for="Hinweis" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Hinweis" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                @L["PassportStep2_Cancel"]
            </a>

            <button type="submit" name="submitAction" value="save" class="btn btn-secondary">
                @L["PassportStep2_Save"]
            </button>

            <button type="submit" name="submitAction" value="submit" class="btn btn-primary">
                @L["PassportStep2_Submit"]
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .progress-steps {
            list-style: none;
            padding-left: 0;
            display: flex;
            gap: 1rem;
            margin-bottom: .5rem
        }

            .progress-steps li {
                padding: .25rem .75rem;
                border-radius: 999px;
                background: var(--bs-secondary-bg);
                color: var(--bs-secondary-color);
            }

                .progress-steps li.active {
                    background: var(--bs-primary);
                    color: var(--bs-primary-contrast,#fff);
                }
    </style>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

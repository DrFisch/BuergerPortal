@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.ReisepassStep2Vm
@using BuergerPortal.Web.Features.Antraege
@using BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IViewLocalizer L
@inject IStringLocalizer<Leistungen> LK
@* Reisepass, Schritt 2 von 3 (2026-10-18): Optionen mit der Gebühr nach § 27 PassV (live beim Umschalten von Express,
   antraege.js), als Entwurf speichern oder weiter zur Prüfung. "submit" (direkt einreichen) nimmt der Controller weiter
   an – für Mitschnitt und Skripte. *@
@{
    ViewData["Title"] = L["Title"];
    var leistung = Leistungen.Von(Leistungen.Reisepass)!;
    var schritte = new AntragSchritteVm([L["Step_Person"].Value, L["Step_Options"].Value, L["Step_Review"].Value], 2);
    var betrag = Model.GebuehrBasis + (Model.Express ? ReisepassStep2Vm.ExpressZuschlag : 0m);
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite ap-seite-schmal py-4 ap-farbe-primary">
    <header class="ap-kopf">
        <span class="ap-symbol" aria-hidden="true"><i class="bi @leistung.Icon"></i></span>
        <div>
            <h1 class="h3 fw-bold">@LK["Reisepass_Titel"]</h1>
            <p class="text-body-secondary mb-0">
                @Model.AntragstellerName
                @if (Model.Geburtsdatum.HasValue)
                {
                    <span>· @L["BornOn", Model.Geburtsdatum.Value.ToString("d")]</span>
                }
                · @L["Number"] @Model.Id.ToString("N")[..8].ToUpperInvariant()
            </p>
        </div>
    </header>

    <partial name="_AntragSchritte" model="schritte" />

    @if (TempData["AntragInfo"] is string info)
    {
        <div class="alert alert-success d-flex gap-2" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><div>@info</div></div>
    }

    <form asp-action="ReisepassStep2" method="post" class="ap-karte p-3 p-md-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="AntragstellerName" value="@Model.AntragstellerName" />
        <input type="hidden" name="Geburtsdatum" value="@Model.Geburtsdatum?.ToString("yyyy-MM-dd")" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <fieldset class="mb-4">
            <legend class="h6 fw-bold mb-3">@L["Section_Options"]</legend>

            <div class="ap-karte p-3 mb-2">
                <div class="form-check form-switch d-flex gap-3 align-items-start ps-0 mb-0">
                    <input class="form-check-input ms-0 mt-1 flex-shrink-0" type="checkbox" role="switch" asp-for="Express" data-ap-express />
                    <label class="form-check-label flex-grow-1" asp-for="Express">
                        <span class="fw-semibold d-block">@L["Express"] <span class="ap-chip ms-1">+ @Leistungen.Euro(ReisepassStep2Vm.ExpressZuschlag, CultureInfo.CurrentUICulture)</span></span>
                        <span class="small text-body-secondary">@L["Express_Hint"]</span>
                    </label>
                </div>
            </div>

            <div class="ap-karte p-3">
                <div class="form-check form-switch d-flex gap-3 align-items-start ps-0 mb-0">
                    <input class="form-check-input ms-0 mt-1 flex-shrink-0" type="checkbox" role="switch" asp-for="AltpassVorhanden" />
                    <label class="form-check-label flex-grow-1" asp-for="AltpassVorhanden">
                        <span class="fw-semibold d-block">@L["OldPassport"]</span>
                        <span class="small text-body-secondary">@L["OldPassport_Hint"]</span>
                    </label>
                </div>
            </div>
        </fieldset>

        <div class="mb-4">
            <label asp-for="Hinweis" class="form-label fw-semibold">@L["Note"]</label>
            <textarea asp-for="Hinweis" rows="3" class="form-control" placeholder="@L["Note_Placeholder"]"></textarea>
            <span asp-validation-for="Hinweis" class="text-danger small"></span>
        </div>

        <div class="ap-hinweis align-items-center">
            <i class="bi bi-cash-coin" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <div class="small text-body-secondary">@L["Fee_Label"]</div>
                <div class="ap-betrag" aria-live="polite" data-ap-gebuehr data-schalter="Express"
                     data-basis="@Model.GebuehrBasis.ToString(CultureInfo.InvariantCulture)"
                     data-express="@ReisepassStep2Vm.ExpressZuschlag.ToString(CultureInfo.InvariantCulture)">@Leistungen.Euro(betrag, CultureInfo.CurrentUICulture)</div>
                <div class="small text-body-secondary">@L["Fee_Hint"]</div>
            </div>
        </div>

        <div class="ap-aktionen">
            <button type="submit" name="submitAction" value="entwurf" class="btn btn-outline-secondary me-auto" id="entwurfSpeichern">
                <i class="bi bi-floppy" aria-hidden="true"></i> @L["SaveDraft"]
            </button>
            <button type="submit" name="submitAction" value="pruefen" class="btn btn-primary btn-lg" id="weiter">
                @L["Next"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/antraege.js" asp-append-version="true"></script>
}

@model BuergerPortal.Web.Features.Antraege.Reisepass.ViewModels.ReisepassStep1Vm
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["PassportStep1_Title"];

    if (string.IsNullOrEmpty(Model.Email) && User.Identity?.IsAuthenticated == true)
    {
        Model.Email = User.Identity.Name;
    }
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="wizard-steps mb-5">
                <div class="step active">
                    <div class="step-icon">1</div>
                    <div class="step-label">@L["PassportStep1_Step1"]</div>
                </div>
                <div class="step-line"></div>
                <div class="step">
                    <div class="step-icon">2</div>
                    <div class="step-label">@L["PassportStep1_Step2"]</div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary bg-opacity-10 border-0 p-4 text-center text-md-start">
                    <h1 class="h4 fw-bold mb-1">@L["PassportStep1_Heading"]</h1>
                    <p class="text-muted small mb-0">@L["PassportStep1_Info"]</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="ReisepassStep1" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Vorname" class="form-control shadow-none border-secondary-subtle" placeholder="@L["Vorname"]" />
                                <label asp-for="Vorname"></label>
                                <span asp-validation-for="Vorname" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Nachname" class="form-control shadow-none border-secondary-subtle" placeholder="@L["Nachname"]" />
                                <label asp-for="Nachname"></label>
                                <span asp-validation-for="Nachname" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-floating">
                                <input asp-for="Geburtsdatum" class="form-control shadow-none border-secondary-subtle" type="date" placeholder="DD.MM.YYYY" />
                                <label asp-for="Geburtsdatum"></label>
                                <span asp-validation-for="Geburtsdatum" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control shadow-none border-secondary-subtle" placeholder="name@@example.com" />
                                <label asp-for="Email"></label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="form-floating">
                                <input asp-for="Telefon" class="form-control shadow-none border-secondary-subtle" placeholder="+49..." />
                                <label asp-for="Telefon"></label>
                                <span asp-validation-for="Telefon" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 mt-5 d-flex flex-column flex-md-row justify-content-between gap-3">
                            <a asp-controller="Antraege" asp-action="Index" class="btn btn-link text-muted text-decoration-none fw-bold order-2 order-md-1">
                                <i class="bi bi-x-lg me-1"></i> @L["PassportStep1_Cancel"]
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm py-2 fw-bold order-1 order-md-2">
                                @L["PassportStep1_Next"] <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .wizard-steps {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 80px;
        }

        .step-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--bs-secondary-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--bs-secondary-color);
            margin-bottom: 0.5rem;
        }

        .step.active .step-icon {
            background: var(--bs-primary);
            color: white;
            box-shadow: 0 0 0 5px var(--bs-primary-bg-subtle);
        }

        .step-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--bs-secondary-color);
        }

        .step.active .step-label {
            color: var(--bs-primary);
        }

        .step-line {
            flex: 0 1 100px;
            height: 2px;
            background: var(--bs-secondary-bg);
            margin-bottom: 1.5rem;
        }

        .form-floating > .form-control:focus {
            border-color: var(--bs-primary);
            box-shadow: 0 0 0 0.25rem var(--bs-primary-bg-subtle);
        }

        [data-bs-theme="dark"] .card {
            background-color: var(--bs-tertiary-bg);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
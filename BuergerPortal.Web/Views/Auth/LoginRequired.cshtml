@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["Title"];
    var returnUrl = (string?)ViewData["ReturnUrl"] ?? Url.Content("~/");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">@L["Title"]</h1>
                    <p>@L["Text"]</p>
                    <p class="small text-muted mb-4">@L["WhatIsBundId"]</p>

                    <form asp-action="Login" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@L["SignIn"]
                        </button>
                        <a href="~/" class="btn btn-link ms-2">@L["Home"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

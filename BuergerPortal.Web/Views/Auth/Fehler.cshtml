@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@{
    // grund: abgebrochen = Abbruch bei der BundID, nicht-erreichbar = Anmeldedienst aus, sonst allgemeiner Fehler
    var key = (string?)ViewData["Grund"] switch
    {
        "abgebrochen" => "Cancelled",
        "nicht-erreichbar" => "Unavailable",
        _ => "Error",
    };
    ViewData["Title"] = L[$"{key}_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">@L[$"{key}_Title"]</h1>
                    <p class="mb-4">@L[$"{key}_Text"]</p>

                    <form asp-action="Login" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Url.Content("~/")" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@L["SignIn"]
                        </button>
                        <a href="~/" class="btn btn-link ms-2">@L["Home"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

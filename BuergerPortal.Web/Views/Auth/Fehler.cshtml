@{
    var grund = (string?)ViewData["Grund"] ?? "fehler";
    var (titel, text) = grund switch
    {
        "abgebrochen" => ("Anmeldung abgebrochen",
            "Die Anmeldung über die BundID wurde abgebrochen. Sie sind nicht angemeldet. " +
            "Sie können es jederzeit erneut versuchen."),
        "nicht-erreichbar" => ("Anmeldedienst nicht erreichbar",
            "Der Anmeldedienst ist derzeit nicht erreichbar. Bitte versuchen Sie es in einigen Minuten erneut."),
        _ => ("Anmeldung nicht möglich",
            "Bei der Anmeldung ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut."),
    };
    ViewData["Title"] = titel;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">@titel</h1>
                    <p class="mb-4">@text</p>

                    <form asp-action="Login" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Url.Content("~/")" />
                        <button type="submit" class="btn btn-primary">Mit BundID anmelden</button>
                        <a href="~/" class="btn btn-link ms-2">Zur Startseite</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

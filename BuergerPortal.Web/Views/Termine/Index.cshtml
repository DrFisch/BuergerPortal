@using BuergerPortal.Web.Extensions
@using BuergerPortal.Web.Features.Termine.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@model TermineIndexVm
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Termine_Title"];
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5">
        <div>
            <h1 class="h3 mb-1 fw-bold text-gradient">@L["Termine_Heading"]</h1>
            <p class="text-secondary mb-0 small opacity-75">@L["Termine_IntroText"]</p>
        </div>

        <div class="d-flex align-items-center gap-4 flex-wrap">
            <div class="form-check form-switch custom-switch d-flex align-items-center gap-2 m-0 p-0">
                <input class="form-check-input ms-0" type="checkbox" id="showCancelledToggle" style="cursor:pointer;">
                <label class="form-check-label small fw-semibold text-secondary" for="showCancelledToggle" style="cursor:pointer;">
                    @L["Termine_ShowCancelled_Label"]
                </label>
            </div>

            <a asp-action="Buchen" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center justify-content-center">
                <i class="bi bi-calendar-plus me-2 fs-6"></i>
                <span class="small">@L["Termine_NewAppointment_Button"]</span>
            </a>
        </div>
    </div>

    @if (Model?.Termine is null || !Model.Termine.Any())
    {
    }
    else
    {
        <div class="row g-4" id="appointmentGrid">
            @foreach (var t in Model.Termine.OrderByDescending(x => x.Datum))
            {
                // IsPast Logik
                TimeSpan timeSpan;
                var parsed = TimeSpan.TryParse(t.Uhrzeit, out timeSpan);
                var appointmentDateTime = parsed ? t.Datum.Date.Add(timeSpan) : t.Datum;
                var isPast = !t.Storniert && appointmentDateTime < DateTime.Now;

                @* Daten-Attribute für JS-Filterung hinzufügen *@
                <div class="col-12 col-xl-6 appointment-container @(t.Storniert ? "is-cancelled d-none" : "")">
                    <div class="card h-100 border-0 shadow-sm rounded-4 appointment-card @(t.Storniert ? "cancelled-style" : "")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="date-badge text-center p-2 rounded-3 @(t.Storniert ? "bg-secondary bg-opacity-10 text-secondary" : "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25")">
                                    <div class="small fw-bold text-uppercase" style="font-size: 0.7rem;">@t.Datum.ToString("MMM")</div>
                                    <div class="h4 mb-0 fw-bold">@t.Datum.ToString("dd")</div>
                                </div>

                                <div>
                                    @if (t.Storniert)
                                    {
                                        @* NEU: Offensichtlicheres Storniert-Badge *@
                                        <span class="badge rounded-pill bg-danger text-white px-3 shadow-sm">
                                            <i class="bi bi-x-octagon-fill me-1"></i> @L["Termine_Status_Cancelled"]
                                        </span>
                                    }
                                    else if (isPast)
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-3">@L["Termine_Status_Past"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 pulsate-dot">
                                            <i class="bi bi-circle-fill me-1 small"></i> @L["Termine_Status_Active"]
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-bold mb-1 @(t.Storniert ? "text-decoration-line-through text-muted" : "")">
                                    @t.Service.ToDisplayName()
                                </h5>
                                <div class="d-flex flex-wrap gap-3 text-muted small">
                                    <span><i class="bi bi-clock me-1"></i> @t.Uhrzeit</span>
                                    <span><i class="bi bi-geo-alt me-1"></i> @t.Location.ToDisplay()</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-light-subtle">
                                @if (t.AntragId.HasValue)
                                {
                                    <a asp-controller="Antraege" asp-action="Antrag" asp-route-id="@t.AntragId"
                                       class="text-decoration-none small fw-semibold text-secondary">
                                        <i class="bi bi-file-earmark-text me-1"></i>
                                        Antrag #@t.AntragId.Value.ToString().Substring(0, 8)
                                    </a>
                                }
                                else
                                {

                                    <span></span>
                                }

                                @if (!t.Storniert && !isPast)
                                {
                                    <form method="post" asp-action="Stornieren" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold p-0">
                                            @L["Termine_Action_Cancel"]
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('showCancelledToggle').addEventListener('change', function() {
            const cancelledItems = document.querySelectorAll('.is-cancelled');
            cancelledItems.forEach(item => {
                if (this.checked) {
                    item.classList.remove('d-none');
                    // Kleiner Fade-In Effekt
                    item.style.opacity = 0;
                    setTimeout(() => item.style.opacity = 1, 10);
                } else {
                    item.classList.add('d-none');
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .appointment-card {
            transition: all 0.3s ease;
        }

        .appointment-container {
            transition: opacity 0.3s ease;
        }

        /* NEU: Spezieller Style für stornierte Karten */
        .cancelled-style {
            background-color: var(--bs-tertiary-bg) !important;
            border: 1px dashed var(--bs-border-color) !important;
            filter: grayscale(0.5);
        }

        .pulsate-dot i {
            animation: pulsate 2s infinite;
        }

        @@keyframes pulsate {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }

            100% {
                opacity: 1;
            }
        }

        [data-bs-theme="dark"] .appointment-card {
            background-color: var(--bs-tertiary-bg);
            border: 1px solid var(--bs-border-color);
        }
    </style>
}
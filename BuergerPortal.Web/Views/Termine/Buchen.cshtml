@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@using BuergerPortal.Web.Features.Termine
@using BuergerPortal.Web.Features.Termine.ViewModels
@model BuchenVm
@{
    ViewData["Title"] = T["Title"];
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" asp-controller="Termine" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 fw-bold mb-0">@T["Title"]</h1>
    </div>

    <form asp-action="Buchen" method="post" id="appointmentForm" class="vstack gap-4">
        @Html.AntiForgeryToken()
        <input asp-for="RelatedAntragId" type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                <div asp-validation-summary="All" class="mb-0 small"></div>
            </div>
        }

        @if (Model.RelatedAntragId.HasValue)
        {
            <div class="card border-0 bg-primary-subtle rounded-4 shadow-sm mb-2">
                <div class="card-body d-flex align-items-center justify-content-between p-3 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white rounded-3 p-2 d-flex">
                            <i class="bi bi-link-45deg fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-primary-emphasis">@T["LinkedToApplication"]</div>
                            <div class="small opacity-75">@T["ApplicationId"]: <code class="bg-white bg-opacity-50 px-1 rounded">@Model.RelatedAntragId.Value.ToString().Substring(0, 8)</code></div>
                        </div>
                    </div>
                    <div class="readonly-pill shadow-sm bg-body">
                        <i class="bi bi-shield-check text-primary me-1"></i> @T["RelatedService"]
                    </div>
                </div>
            </div>
            <input asp-for="Service" type="hidden" />
        }

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="row g-4">

                    @if (!Model.RelatedAntragId.HasValue)
                    {
                        <div class="col-12">
                            <label class="form-label fw-semibold">@T["Service"]</label>
                            <select asp-for="Service" class="form-select form-select-lg rounded-3" asp-items="Html.GetEnumSelectList<ServiceType>()">
                                <option value="">@T["SelectPlaceholder"]</option>
                            </select>
                            <span asp-validation-for="Service" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-12">
                        <label class="form-label fw-semibold">@T["Location"]</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-body text-secondary border-end-0"><i class="bi bi-geo-alt"></i></span>
                            <select asp-for="Location" class="form-select border-start-0" asp-items="Html.GetEnumSelectList<LocationType>()"></select>
                        </div>
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@T["Date"]</label>
                        <input asp-for="LocalDate" type="date" class="form-control form-control-lg rounded-3" id="dateInput" />
                        <span id="weekendNote" class="text-danger small mt-1 d-block fw-medium"></span>
                        <span asp-validation-for="LocalDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@T["Time"]</label>
                        <div class="input-group input-group-lg">
                            <select asp-for="LocalTime" class="form-select rounded-start-3" id="timeSelect"></select>
                            <button type="button" class="btn btn-primary px-3" data-bs-toggle="modal" data-bs-target="#kalenderModal">
                                <i class="bi bi-calendar3"></i>
                            </button>
                        </div>
                        <small class="text-muted mt-1 d-block">@T["CalendarHint"]</small>
                        <span asp-validation-for="LocalTime" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">@T["Duration"]</label>
                        <select asp-for="Duration" class="form-select form-select-lg rounded-3" id="durationSelect" asp-items="Html.GetEnumSelectList<DurationOption>()"></select>
                        <div id="clientErrorMsg" class="text-danger small mt-2 fw-bold"></div>
                        <span asp-validation-for="Duration" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-4 mt-5 mb-0 d-flex gap-3 align-items-center">
                    <i class="bi bi-info-circle-fill fs-4 opacity-50"></i>
                    <div class="small">
                        <div class="fw-bold">@T["OpeningHoursLabel"]</div>
                        <div>@T["OpeningHoursDetail"]</div>
                    </div>
                </div>
            </div>

            <div class="p-4 d-flex justify-content-between align-items-center bg-body border-top border-light-subtle">
                <div class="text-muted small d-none d-md-block">
                   
                </div>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow fw-bold transition-all hover-lift">
                    @T["BookAppointment"] <i class="bi bi-arrow-right-short ms-2"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="kalenderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">@T["ModalTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <div class="flex-grow-1" style="min-width: 200px;">
                        <label class="form-label small fw-bold">@T["ModalDate"]</label>
                        <input type="date" id="kalenderDate" class="form-control">
                    </div>
                    <button class="btn btn-outline-primary mt-4" id="kalenderReload">
                        <i class="bi bi-arrow-clockwise"></i> @T["Reload"]
                    </button>
                </div>
                <div class="d-flex gap-3 mb-3 small fw-medium">
                    <span class="d-flex align-items-center gap-1">
                        <span class="badge bg-danger p-2 rounded-1"> </span> @T["Busy"]
                    </span>
                </div>
                <div id="dpCalendar" class="rounded-3 shadow-sm"></div>
            </div>
            <div class="modal-footer bg-light border-top-0 rounded-bottom-4">
                <button class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">@T["Close"]</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: var(--bs-tertiary-bg);
        }

        .readonly-pill {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: 50rem;
            border: 1px solid var(--bs-border-color);
            font-weight: 600;
            font-size: 0.875rem;
        }

        #dpCalendar {
            background: var(--bs-body-bg);
            border: 1px solid var(--bs-border-color);
            min-height: 400px;
        }

        .form-control-lg, .form-select-lg {
            font-size: 1rem;
            padding: 0.75rem 1rem;
        }

        /* DayPilot Overrides für Darkmode */
        [data-bs-theme="dark"] .calendar_default_main {
            background-color: #2b3035;
            color: #dee2e6;
            border-color: #495057;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/daypilot/daypilot-javascript.min.js" asp-append-version="true"></script>

    <script>
        const START_HOUR = 8;
        const END_HOUR = 12;
        const STEP_MIN = 15;

        const dateInput = document.getElementById('dateInput');
        const timeSelect = document.getElementById('timeSelect');
        const durationSelect = document.getElementById('durationSelect');
        const form = document.getElementById('appointmentForm');
        const clientErrorMsg = document.getElementById('clientErrorMsg');
        const weekendNote = document.getElementById('weekendNote');

        function isWeekendDateStr(yyyyMmDd) {
            const d = new Date(yyyyMmDd + "T00:00:00");
            const dow = d.getDay();
            return dow === 0 || dow === 6;
        }

        function buildOptions() {
            const currentVal = timeSelect.value;
            timeSelect.innerHTML = "";
            const chosen = new Date(dateInput.value + "T00:00:00");
            const now = new Date();
            const isToday = chosen.toDateString() === now.toDateString();

            for (let h = START_HOUR; h < END_HOUR; h++) {
                for (let m = 0; m < 60; m += STEP_MIN) {
                    const t = new Date(chosen);
                    t.setHours(h, m, 0, 0);
                    if (isToday && t <= now) continue;

                    const hh = String(h).padStart(2, '0');
                    const mm = String(m).padStart(2, '0');
                    const label = `${hh}:${mm}`;

                    const opt = document.createElement('option');
                    opt.value = label;
                    opt.textContent = label;
                    timeSelect.appendChild(opt);
                }
            }
            if (currentVal) timeSelect.value = currentVal;
            showOrHideClientError();
        }

        function validateBusinessEnd() {
            if (!timeSelect.value) return false;
            const [hh, mm] = timeSelect.value.split(':').map(Number);
            const dur = parseInt(durationSelect.value) || 15;

            const endMin = (hh * 60) + mm + dur;
            return endMin > (END_HOUR * 60);
        }

        function showOrHideClientError() {
            if (validateBusinessEnd()) {
                clientErrorMsg.textContent = `⚠️ Der Termin endet nach ${END_HOUR}:00 Uhr. Bitte Startzeit oder Dauer anpassen.`;
            } else {
                clientErrorMsg.textContent = "";
            }
        }

        // Init
        (function init() {
            const today = new Date().toISOString().split('T')[0];
            dateInput.min = today;
            if (!dateInput.value) dateInput.value = today;
            buildOptions();
        })();

        dateInput.addEventListener('change', () => {
            if (isWeekendDateStr(dateInput.value)) {
                weekendNote.textContent = "Wochenende nicht möglich. Datum wurde angepasst.";
                const dt = new Date(dateInput.value + "T00:00:00");
                dt.setDate(dt.getDate() + (dt.getDay() === 6 ? 2 : 1));
                dateInput.value = dt.toISOString().split('T')[0];
            } else {
                weekendNote.textContent = "";
            }
            buildOptions();
        });

        timeSelect.addEventListener('change', showOrHideClientError);
        durationSelect.addEventListener('change', showOrHideClientError);

        form.addEventListener('submit', (e) => {
            if (validateBusinessEnd()) {
                e.preventDefault();
                showOrHideClientError();
                window.scrollTo({ top: clientErrorMsg.offsetTop - 100, behavior: 'smooth' });
            }
        });

        // --- DayPilot Kalender ---
        (function initCalendar() {
            const dp = new DayPilot.Calendar("dpCalendar");
            dp.viewType = "Day";
            dp.locale = "de-de";
            dp.cellDuration = 15;
            dp.businessBeginsHour = 8;
            dp.businessEndsHour = 12;
            dp.showNonBusiness = false;
            dp.heightSpec = "BusinessHoursNoScroll";

            dp.onTimeRangeSelected = (args) => {
                const datePart = args.start.toString("yyyy-MM-dd");
                const timePart = args.start.toString("HH:mm");

                dateInput.value = datePart;
                buildOptions();
                timeSelect.value = timePart;

                bootstrap.Modal.getInstance(document.getElementById('kalenderModal')).hide();
                dp.clearSelection();
            };

            dp.init();

            const modalEl = document.getElementById('kalenderModal');
            modalEl.addEventListener('shown.bs.modal', async () => {
                const calDate = document.getElementById('kalenderDate');
                calDate.value = dateInput.value;
                dp.startDate = calDate.value;
                dp.update();
                await loadBusyData(calDate.value);
            });

            async function loadBusyData(date) {
                try {
                    const res = await fetch(`/Termine/Busy?date=${date}`);
                    const data = await res.json();
                    const events = data.map((e, i) => ({
                        id: i,
                        text: "Belegt",
                        start: e.startUtc || e.StartUtc,
                        end: e.endUtc || e.EndUtc,
                        backColor: "#f8d7da",
                        borderColor: "#f5c2c7",
                        fontColor: "#842029"
                    }));
                    dp.update({ events });
                } catch (e) { console.error("Busy-Daten Fehler", e); }
            }

            document.getElementById('kalenderReload').addEventListener('click', () => {
                dp.startDate = document.getElementById('kalenderDate').value;
                dp.update();
                loadBusyData(dp.startDate);
            });
        })();
    </script>
}
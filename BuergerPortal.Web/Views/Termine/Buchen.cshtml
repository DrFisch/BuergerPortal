@using BuergerPortal.Web.Features.Termine
@using BuergerPortal.Web.Features.Termine.ViewModels
@model BuchenVm
@{
    ViewData["Title"] = "Termin buchen";
}
<h1 class="h4">Termin buchen</h1>

<form asp-action="Buchen" method="post" class="vstack gap-3">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <div>
        <label class="form-label">Dienst</label>
        <!-- Enum-Items rendern -->
        <select asp-for="Service"
                class="form-select"
                asp-items="Html.GetEnumSelectList<ServiceType>()">
        </select>
        <span asp-validation-for="Service" class="text-danger"></span>
    </div>

    <div>
        <label class="form-label">Standort</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">Datum</label>
            <input asp-for="LocalDate" type="date" class="form-control" id="dateInput" />
            <span asp-validation-for="LocalDate" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label class="form-label">Uhrzeit</label>
            <div class="input-group">
                <select asp-for="LocalTime" class="form-select" id="timeSelect"></select>
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#kalenderModal">
                    Verfügbarkeit
                </button>
            </div>
            <small class="text-muted">Kalender zeigt 08:00–12:00 im 15-Minuten-Raster.</small>
            <span asp-validation-for="LocalTime" class="text-danger"></span>
        </div>
    </div>

    <div>
        <label class="form-label">Dauer (Min.)</label>
        <input asp-for="DurationMinutes" type="number" min="15" step="15" class="form-control" />
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Termin buchen</button>
</form>

<!-- Kalender-Modal (DayPilot) -->
<div class="modal fade" id="kalenderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Verfügbarkeit (08:00–12:00)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <label class="form-label mb-0">Datum:</label>
                    <input type="date" id="kalenderDate" class="form-control" style="max-width: 220px;">
                    <button class="btn btn-sm btn-outline-primary" id="kalenderReload" type="button">Aktualisieren</button>
                </div>

                <div class="mb-2">
                    <span class="badge bg-success">&nbsp;</span> frei
                    <span class="badge bg-danger ms-2">&nbsp;</span> belegt
                </div>

                <div id="dpCalendar" style="height: 480px;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Konfig: Öffnungszeiten (anpassen, falls nötig)
        const START_HOUR = 8;   // 08:00
        const END_HOUR   = 18;  // 18:00 (inkl.)
        const STEP_MIN   = 15;  // 15-Minuten-Raster

        const dateInput  = document.getElementById('dateInput');
        const timeSelect = document.getElementById('timeSelect');

        // min=heute
        (function setMinToday() {
            const d = new Date();
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            dateInput.min = `${yyyy}-${mm}-${dd}`;
            if (!dateInput.value) dateInput.value = dateInput.min;
        })();

        function toHHMM(v) {
            const h = String(v.getHours()).padStart(2,'0');
            const m = String(v.getMinutes()).padStart(2,'0');
            return `${h}:${m}`;
        }

        function buildOptions() {
            const selected = timeSelect.value; // merken
            timeSelect.innerHTML = "";

            const chosen = new Date(dateInput.value + "T00:00:00");
            const now    = new Date();
            const isToday = chosen.toDateString() === now.toDateString();

            // Start bei :00 oder :15 etc. (runden)
            const start = new Date(chosen);
            start.setHours(START_HOUR, 0, 0, 0);

            const end = new Date(chosen);
            end.setHours(END_HOUR, 0, 0, 0);

            for (let t = new Date(start); t <= end; t.setMinutes(t.getMinutes() + STEP_MIN)) {
                // heute: Vergangenes ausblenden
                if (isToday && t <= now) continue;

                const label = toHHMM(t);
                const opt = document.createElement('option');
                opt.value = label; // ModelBinder versteht "HH:mm" für TimeSpan
                opt.textContent = label;
                timeSelect.appendChild(opt);
            }

            // Vorbelegen: falls der vormals gewählte Wert noch vorhanden ist
            if (selected) {
                const found = Array.from(timeSelect.options).some(o => o.value === selected);
                if (found) timeSelect.value = selected;
            }
            // sonst: erste Option wählen
            if (!timeSelect.value && timeSelect.options.length > 0) {
                timeSelect.selectedIndex = 0;
            }
        }

        // Initial befüllen & bei Datum-Änderung neu berechnen
        buildOptions();
        dateInput.addEventListener('change', buildOptions);
    </script>
    <!-- DayPilot Kalender Script -->
    <script src="~/lib/daypilot/daypilot-javascript.min.js" asp-append-version="true"></script>
    <script>
        (function () {
          const modalEl = document.getElementById('kalenderModal');
          const dateEl  = document.getElementById('kalenderDate');
          const reload  = document.getElementById('kalenderReload');
          const hostEl  = document.getElementById('dpCalendar');

          // Form-Felder
          const dateInput  = document.getElementById('dateInput');
          const timeSelect = document.getElementById('timeSelect');

          if (!hostEl || !modalEl || !dateInput || !timeSelect) return;

          // ---- Hilfsfunktion: ISO-String (+60 Minuten) -> lokales ISO "yyyy-MM-ddTHH:mm:ss"
          function addMinutesToIso(isoString, minutes) {
            // isoString kann "Z" enthalten (UTC) oder nicht; JS Date normalisiert das
            const d = new Date(isoString);
            d.setMinutes(d.getMinutes() + minutes);
            const y  = d.getFullYear();
            const mo = String(d.getMonth() + 1).padStart(2, '0');
            const da = String(d.getDate()).padStart(2, '0');
            const hh = String(d.getHours()).padStart(2, '0');
            const mi = String(d.getMinutes()).padStart(2, '0');
            const ss = String(d.getSeconds()).padStart(2, '0');
            // ohne "Z" zurückgeben, damit DayPilot es als lokale Zeit rendert
            return `${y}-${mo}-${da}T${hh}:${mi}:${ss}`;
          }

          // DayPilot init
          const dp = new DayPilot.Calendar(hostEl);
          dp.viewType = "Day";
          dp.locale = "de-de";
          dp.cellDuration = 15;

          // Nur 08:00–12:00 sichtbar/auswählbar
          dp.businessBeginsHour = 8;
          dp.businessEndsHour = 12;
          dp.showNonBusiness = false;
          dp.heightSpec = "BusinessHours";
          dp.scrollLabelsVisible = false;

          dp.timeRangeSelectedHandling = "Enabled";
          dp.eventMoveHandling = "Disabled";
          dp.eventResizeHandling = "Disabled";
          dp.allowEventOverlap = true;

          // Auswahl außerhalb blocken
          dp.onTimeRangeSelecting = (args) => {
            const h = args.start.hour();
            if (h < 8 || h >= 12) args.allowed = false;
          };

          // Klick auf freien Slot -> exakt diese Uhrzeit ins Dropdown (ohne Offset)
          dp.onTimeRangeSelected = (args) => {
            const formDate = args.start.toString("yyyy-MM-dd");
            const hhmm     = args.start.toString("HH:mm");

            if (dateInput.value !== formDate) {
              dateInput.value = formDate;
              if (typeof buildOptions === "function") buildOptions();
            }
            if (!Array.from(timeSelect.options).some(o => o.value === hhmm)) {
              if (typeof buildOptions === "function") buildOptions();
            }
            timeSelect.value = hhmm;

            dp.clearSelection();
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.hide();
          };

          dp.init();

          // Busy-Slots laden (und +60 Min verschoben anzeigen)
          async function loadBusy(dateStr) {
            const res = await fetch(`/Termine/Busy?date=${dateStr}`, { credentials: 'same-origin' });
            if (!res.ok) {
              dp.update({ events: [] });
              return;
            }
            const items = await res.json(); // [{ startUtc, endUtc }]

            // Anzeige bewusst +60 Minuten verschieben (nur Darstellung im Kalender)
            const events = items.map((x, i) => ({
              id: `busy-${i}`,
              text: "Belegt",
              start: addMinutesToIso(x.startUtc ?? x.StartUtc, 0),
              end:   addMinutesToIso(x.endUtc   ?? x.EndUtc,   0),
              backColor: "#f8d7da",
              borderColor: "#f5c2c7",
              barHidden: true,
              moveDisabled: true,
              resizeDisabled: true
            }));

            dp.update({ events });
          }

          // Datum in DayPilot synchronisieren
          function syncDatePicker() {
            if (!dateEl.value) {
              dateEl.value = dateInput.value; // Formular-Datum als Default
            }
            dp.startDate = dateEl.value;      // YYYY-MM-DD
            dp.update();
          }

          // Modal geöffnet -> initial laden
          modalEl.addEventListener('shown.bs.modal', async () => {
            if (!dateEl.value) dateEl.value = dateInput.value;
            syncDatePicker();
            await loadBusy(dateEl.value);
          });

          // Reload-Button
          reload?.addEventListener('click', async () => {
            syncDatePicker();
            await loadBusy(dateEl.value);
          });

          // Datum im Modal geändert
          dateEl.addEventListener('change', async () => {
            syncDatePicker();
            await loadBusy(dateEl.value);
          });

          // Formular-Datum geändert, Modal offen -> synchronisieren
          dateInput.addEventListener('change', async () => {
            if (modalEl.classList.contains('show')) {
              dateEl.value = dateInput.value;
              syncDatePicker();
              await loadBusy(dateEl.value);
            }
          });
        })();
    </script>

}

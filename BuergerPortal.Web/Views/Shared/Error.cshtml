@model ErrorViewModel
@{
    // Fehlerseite (UseExceptionHandler) und Statusseiten (404, 403 …): verständlicher Text, keine technischen Details.
    var code = ViewData["StatusCode"] as int?;
    var (titel, text, icon) = code switch
    {
        404 => ("Seite nicht gefunden", "Die aufgerufene Adresse gibt es im BürgerPortal nicht (mehr).", "bi-signpost-split"),
        403 => ("Kein Zugriff", "Für diese Seite fehlt Ihnen die Berechtigung.", "bi-shield-lock"),
        _ => ("Es ist ein Fehler aufgetreten", "Bitte versuchen Sie es in einem Moment erneut.", "bi-exclamation-triangle")
    };
    ViewData["Title"] = titel;
}

<div class="container py-5 text-center" style="max-width: 640px;">
    <i class="bi @icon display-4 text-secondary" aria-hidden="true"></i>
    <h1 class="h3 fw-bold mt-3">@titel</h1>
    <p class="text-muted">@text</p>
    <a class="btn btn-primary rounded-pill px-4" href="/">Zur Startseite</a>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted mt-4 mb-0">Fehlerkennung für Rückfragen: <code>@Model.RequestId</code></p>
    }
</div>

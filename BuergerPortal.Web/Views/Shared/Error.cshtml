@model ErrorViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    // Fehlerseite (UseExceptionHandler) und Statusseiten (404, 403 …): verständlicher Text, keine technischen Details.
    var code = ViewData["StatusCode"] as int?;
    var (titel, text, icon) = code switch
    {
        404 => (T["NotFound_Title"].Value, T["NotFound_Text"].Value, "bi-signpost-split"),
        403 => (T["Forbidden_Title"].Value, T["Forbidden_Text"].Value, "bi-shield-lock"),
        _ => (T["Error_Title"].Value, T["Error_Text"].Value, "bi-exclamation-triangle")
    };
    ViewData["Title"] = titel;
}

<div class="container py-5 text-center" style="max-width: 640px;">
    <i class="bi @icon display-4 text-secondary" aria-hidden="true"></i>
    <h1 class="h3 fw-bold mt-3">@titel</h1>
    <p class="text-muted">@text</p>
    <a class="btn btn-primary rounded-pill px-4" href="/">@T["ToStart"]</a>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted mt-4 mb-0">@T["RequestId"] <code>@Model.RequestId</code></p>
    }
</div>

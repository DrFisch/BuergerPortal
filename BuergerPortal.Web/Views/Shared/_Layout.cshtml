@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@using Microsoft.AspNetCore.Authentication
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] – BürgerPortal</title>
    <meta name="app-env" content="@Env.EnvironmentName" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Restzeit bis zum automatischen Abmelden (dieser Aufruf hat die Sitzung gerade verlängert), für sitzung.js *@
        var anmeldung = (await Context.AuthenticateAsync()).Properties is { } sitzung
            ? BuergerPortal.Web.Services.PortalSession.LoginTime(sitzung) : null;
        <meta name="bpsim-sitzung" content="@((int)BuergerPortal.Web.Services.PortalSession.Remaining(DateTimeOffset.UtcNow, anmeldung).TotalSeconds)" />
    }

    <script>
        (function () {
          function readCookie(n){
            return document.cookie.split('; ').find(x=>x.startsWith(n+'='))?.split('=')[1];
          }
          const cookieTheme = readCookie('theme');
          const lsTheme     = localStorage.getItem('theme');
          const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;

          const theme = cookieTheme || lsTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-bs-theme', theme);
          window.__initialTheme = theme;

          if (cookieTheme && cookieTheme !== lsTheme) {
            localStorage.setItem('theme', cookieTheme);
          }
        })();
    </script>

    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0d6efd" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#212529" media="(prefers-color-scheme: dark)">
    <link rel="icon" sizes="128x128" href="/icons/portal-128.png">
    @* Als App auf dem Startbildschirm (iOS liest das Manifest nur teilweise) *@
    <link rel="apple-touch-icon" href="/icons/portal-192.png">
    <meta name="apple-mobile-web-app-title" content="BürgerPortal">
    <meta name="mobile-web-app-capable" content="yes">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuergerPortal.Web.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "has-tabbar" : null)">
    @await Html.PartialAsync("_Navbar")

    <main class="container py-4">
        @await Html.PartialAsync("_Meldungen")
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3 border-top">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>© @DateTime.UtcNow.Year Bürgerportal</span>
            <div class="d-flex align-items-center gap-3">
                <a class="link-secondary link-underline-opacity-0" asp-controller="Home" asp-action="Impressum">Impressum</a>
                <a class="link-secondary link-underline-opacity-0" asp-controller="Home" asp-action="Datenschutz">Datenschutz</a>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_TabLeiste" />
    }

    @* Hinweis vor dem Wechsel zur BundID-Simulation (Anmeldung, Postfach) *@
    <partial name="_SimulationsHinweis" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Warnung kurz vor dem automatischen Abmelden *@
        <partial name="_SitzungsWarnung" />
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/bundid-hinweis.js" asp-append-version="true"></script>
    <script src="~/js/sitzung.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/pwa-install.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BuergerPortal.Web</title>
    <meta name="app-env" content="@Env.EnvironmentName" />

    <!-- Theme-Init (vor CSS) -->
    <script>
        (function () {
          function readCookie(n){
            return document.cookie.split('; ').find(x=>x.startsWith(n+'='))?.split('=')[1];
          }
          const cookieTheme = readCookie('theme');               // von Server gesetzt (DB-Quelle)
          const lsTheme     = localStorage.getItem('theme');     // letzte Clientwahl
          const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;

          const theme = cookieTheme || lsTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-bs-theme', theme);
          window.__initialTheme = theme;

          // einmalige Harmonisierung: wenn Cookie existiert und abweicht → LocalStorage angleichen
          if (cookieTheme && cookieTheme !== lsTheme) {
            localStorage.setItem('theme', cookieTheme);
          }
        })();
    </script>


     <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0d6efd">
    <link rel="icon" sizes="128x128" href="/icons/portal-128.png"> 

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuergerPortal.Web.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="navbar navbar-expand-lg bg-body-tertiary sticky-top border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Bürgerportal</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                    aria-controls="nav" aria-expanded="false" aria-label="Navigation umschalten">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="nav" class="collapse navbar-collapse">
                <!-- Linkbereich links (optional frei für spätere Menüpunkte) -->
                <ul class="navbar-nav me-auto">
                    <!-- Beispiel:
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointments" asp-action="Index">Termine</a>
                    </li>
                    -->
                </ul>

                <!-- Rechts ausgerichteter Bereich -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <!-- Theme Toggle (immer sichtbar) -->
                    

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- Begrüßung: Desktop sichtbar, mobil als Menüpunkt unten -->
                        <li class="nav-item d-none d-lg-inline ms-lg-2">
                            <span class="navbar-text">Hallo, @User.Identity!.Name</span>
                        </li>

                        <!-- Profil / Logout -->
                        <li class="nav-item dropdown ms-lg-2">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i> Konto
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Settings" asp-action="">
                                        <i class="bi bi-gear me-2"></i> Profil & Einstellungen
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Mobile: Begrüßung als eigener Eintrag -->
                        <li class="nav-item d-lg-none mt-2">
                            <span class="nav-link disabled text-muted">Hallo, @User.Identity!.Name</span>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary d-flex align-items-center js-theme-toggle"
                                aria-pressed="false" aria-label="Theme umschalten">
                            <i class="bi bi-moon-stars me-2 js-theme-icon"></i>
                            <span class="js-theme-text">Light</span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </header>


    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3 border-top">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>© @DateTime.UtcNow.Year Bürgerportal</span>
            <div class="d-flex align-items-center gap-3">
                <a class="link-secondary link-underline-opacity-0" asp-controller="Home" asp-action="Impressum">Impressum</a>
                <a class="link-secondary link-underline-opacity-0" asp-controller="Home" asp-action="Datenschutz">Datenschutz</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

     <script src="~/pwa-install.js" asp-append-version="true"></script>
 

    

    @RenderSection("Scripts", required: false)

     <script>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
          });
        }
    </script> 
</body>
</html>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@inject BuergerPortal.Web.Services.HttpCurrentUserService CurrentUser
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // Angemeldete Person mit BundID-Angaben (Name, Vertrauensniveau); null ohne Anmeldung.
    var bundIdUser = CurrentUser.GetBundIdUser();
    var postfachUrl = Config["Postkorb:PostfachUrl"];
    var levelBadge = bundIdUser is { TrustLevel: >= 3 } ? "text-bg-success" : "text-bg-secondary";
    // Hervorhebung des aktuellen Bereichs im Hauptmenü
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    string Aktiv(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active fw-semibold" : "";
    string? AriaAktiv(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "page" : null;
}

@* Sprunglink: erstes Element für Tastatur und Screenreader, springt über die Navigation zum Inhalt (BITV 2.0, WCAG 2.4.1) *@
<a class="visually-hidden-focusable bp-sprunglink" href="#hauptinhalt">@T["SkipToContent"]</a>

@if (bundIdUser == null)
{
    @* Ohne Anmeldung gibt es nur die Einstiegsseite – deshalb keine Links zu Leistungen, nur Anmelden und Theme.
       Auf dem Handy eine Zeile (Plan A4): kurzer Anmelde-Text; Farbschema folgt dort dem Gerät (Knopf ab 576 px). *@
    <header class="navbar bg-body-tertiary sticky-top border-bottom shadow-sm">
        <div class="container flex-nowrap">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">@T["BrandTitle"]</a>
            <div class="d-flex align-items-center gap-2">
                <partial name="_Sprachwahl" />
                <button type="button"
                        class="btn btn-sm btn-outline-secondary d-none d-sm-flex align-items-center js-theme-toggle"
                        aria-pressed="false"
                        aria-label="@T["ThemeToggleAria"]">
                    <i class="bi bi-moon-stars js-theme-icon"></i>
                    <span class="js-theme-text d-none d-sm-inline ms-2">@T["ThemeLight"]</span>
                </button>
                <a class="btn btn-sm bundid-login-btn d-flex align-items-center gap-2 text-nowrap"
                   asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(ViewData["ReturnUrl"] as string ?? "/")">
                    @await Html.PartialAsync("_BundIdSymbol", new ViewDataDictionary(ViewData) { ["Size"] = 20 })
                    <span class="d-none d-sm-inline">@T["Login"]</span><span class="d-sm-none">@T["LoginShort"]</span>
                </a>
            </div>
        </div>
    </header>
}
else
{
<header class="navbar navbar-expand-lg bg-body-tertiary sticky-top border-bottom shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            @T["BrandTitle"]
        </a>

        @* Handy: eine Zeile – Marke, Sprachwahl (immer sichtbar, Wunsch Lukas 2026-10-10) und erreichtes Niveau. Name,
           Menü und Abmelden liegen im Tab „Konto“ der Tab-Leiste (_TabLeiste.cshtml, Plan A4/A10, E-022). *@
        <div class="d-flex align-items-center gap-2 ms-auto d-lg-none">
            <partial name="_Sprachwahl" />
            @if (bundIdUser.TrustLevel > 0)
            {
                <span class="badge @levelBadge" title="@T["SignedInWithBundId"]">
                    <i class="bi bi-shield-check me-1" aria-hidden="true"></i>@T[$"Level_{bundIdUser.TrustLevel}_Name"]
                </span>
            }
        </div>

        @* Am Desktop immer ausgeklappt (navbar-expand-lg); auf dem Handy ersetzt die Tab-Leiste dieses Menü *@
        <div id="mainNav" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                @* Leistungen: Hauptmenü am Desktop *@
                <li class="nav-item">
                    <a class="nav-link @Aktiv("Termine")" aria-current="@AriaAktiv("Termine")" asp-controller="Termine" asp-action="Index">
                        <i class="bi bi-calendar3-range me-1"></i> @T["Card_Appointments"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Aktiv("Antraege", "ReisepassAntraege", "SperrmuellAntraege")" aria-current="@AriaAktiv("Antraege", "ReisepassAntraege", "SperrmuellAntraege")" asp-controller="Antraege" asp-action="Index">
                        <i class="bi bi-file-earmark-text me-1"></i> @T["Card_Applications"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Aktiv("Maengel")" aria-current="@AriaAktiv("Maengel")" asp-controller="Maengel" asp-action="Create">
                        <i class="bi bi-exclamation-octagon me-1"></i> @T["Card_ReportIssue"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Aktiv("Entdecken")" aria-current="@AriaAktiv("Entdecken")" asp-controller="Entdecken" asp-action="Index">
                        <i class="bi bi-compass me-1"></i> @T["Discover"]
                    </a>
                </li>

                @* immer sichtbar (außer in der installierten App): Browser-Dialog oder Anleitung je Gerät, wwwroot/pwa-install.js *@
                <li class="nav-item" data-pwa-install-item>
                    <button type="button" class="nav-link btn btn-link w-100 text-start" data-pwa-install>
                        <i class="bi bi-download me-1"></i> @T["InstallAppLink"]
                    </button>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                @if (bundIdUser != null)
                {
                    <li class="nav-item d-none d-lg-inline ms-lg-2">
                        <span class="navbar-text">
                            @T["HelloUser", bundIdUser.DisplayName]
                        </span>
                    </li>

                    <li class="nav-item dropdown ms-lg-2 d-none d-lg-block">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @T["Account"]
                            @if (bundIdUser.TrustLevel > 0)
                            {
                                <span class="badge @levelBadge ms-2">@T[$"Level_{bundIdUser.TrustLevel}_Name"]</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (bundIdUser.IsBundIdLogin)
                            {
                                <li>
                                    <span class="dropdown-item-text small text-muted">
                                        <i class="bi bi-shield-check me-1"></i>@T["SignedInWithBundId"]
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <a class="dropdown-item" asp-controller="MeineDaten" asp-action="Index">
                                    <i class="bi bi-person-vcard me-2"></i> @T["MyData"]
                                </a>
                            </li>
                            @if (!string.IsNullOrWhiteSpace(postfachUrl))
                            {
                                <li>
                                    <a class="dropdown-item" href="@postfachUrl" data-sim-hinweis="postfach">
                                        <i class="bi bi-envelope-paper me-2"></i> @T["MyMailbox"]
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear me-2"></i> @T["ProfileSettings"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> @T["Logout"]
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <!-- Desktop-Login-Button -->
                    <li class="nav-item ms-lg-2 d-none d-lg-block">
                        <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-shield-lock me-1"></i> @T["Login"]
                        </a>
                    </li>
                }

                <li class="nav-item d-none d-lg-block">
                    <partial name="_Sprachwahl" />
                </li>

                <li class="nav-item d-none d-lg-block">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center js-theme-toggle"
                            aria-pressed="false"
                            aria-label="@T["ThemeToggleAria"]">
                        <i class="bi bi-moon-stars me-2 js-theme-icon"></i>
                        <span class="js-theme-text">@T["ThemeLight"]</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</header>
}

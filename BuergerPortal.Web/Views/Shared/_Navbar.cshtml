@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T

<header class="navbar navbar-expand-lg bg-body-tertiary sticky-top border-bottom shadow-sm">
    <div class="container">
        <!-- Brand / Startseite-Link -->
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            @T["BrandTitle"]
        </a>

        <!-- Rechte Seite: Mobile Quick-Actions + Toggler -->
        <div class="d-flex align-items-center ms-auto d-lg-none">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <span class="small text-muted me-2">
                    @User.Identity!.Name  @* z.B. "Hi, {0}" *@
                </span>
            }
            else
            {
                <a class="btn btn-sm btn-outline-primary me-2"
                   asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> @T["Login"]
                </a>
            }

            <!-- Burger-Toggler (nur mobil sichtbar) -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false"
                    aria-label="@T["NavbarToggleAria"]">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <!-- Desktop: Toggler verstecken, falls du magst -->
        <button class="navbar-toggler d-none" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false"
                aria-label="@T["NavbarToggleAria"]">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="mainNav" class="collapse navbar-collapse">
            <!-- Linkbereich links (gemeinsame Links) -->
            <ul class="navbar-nav me-auto">
                <!-- Startseite im Burger-Menü (mobil) -->
                <li class="nav-item d-lg-none">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-1"></i> @T["Home"]
                    </a>
                </li>

                <!-- Settings im Burger-Menü (mobil) -->
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <li class="nav-item d-lg-none">
                        <a class="nav-link" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear me-1"></i> @T["ProfileSettings"]
                        </a>
                    </li>

                }
                <!-- Trennstrich vor Leistungen (nur mobil) -->
                <li class="nav-item d-lg-none">
                    <hr class="dropdown-divider my-2" />
                </li>

                <!-- Leistungen-Header (nur mobil) -->
                <li class="nav-item d-lg-none">
                    <span class="nav-link text-uppercase text-muted small">
                        @T["Services"] @* z.B. "Leistungen" *@
                    </span>
                </li>

                <!-- Terminbuchung -->
                <li class="nav-item d-lg-none">
                    <a class="nav-link" asp-controller="Termine" asp-action="Index">
                        <i class="bi bi-calendar3-range me-1"></i>
                        @T["Card_Appointments"]
                    </a>
                </li>

                <!-- Anträge -->
                <li class="nav-item d-lg-none">
                    <a class="nav-link" asp-controller="Antraege" asp-action="Index">
                        <i class="bi bi-file-earmark-text me-1"></i>
                        @T["Card_Applications"]
                    </a>
                </li>

                <!-- Mängelmelder -->
                <li class="nav-item d-lg-none">
                    <a class="nav-link" asp-controller="Maengel" asp-action="Create">
                        <i class="bi bi-exclamation-octagon me-1"></i>
                        @T["Card_ReportIssue"]
                    </a>
                </li>

                <!-- App-Link im Burger-Menü (mobil) - hidden by default; shown by pwa-install.js when install is available -->
                <li class="nav-item d-none d-lg-none" id="appInstallMenuItem">
                    <button type="button" id="btnInstall" class="nav-link btn btn-link w-100 text-start" onclick="installApp()">
                        <i class="bi bi-download me-1"></i> @T["InstallAppLink"]
                    </button>
                </li>
                
            </ul>

            <!-- Rechts ausgerichteter Bereich -->
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                @* Desktop-Bereich für eingeloggte User *@
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <!-- Begrüßung: nur Desktop -->
                    <li class="nav-item d-none d-lg-inline ms-lg-2">
                        <span class="navbar-text">
                            @T["HelloUser", User.Identity!.Name]
                        </span>
                    </li>

                    <!-- Account-Dropdown: nur Desktop -->
                    <li class="nav-item dropdown ms-lg-2 d-none d-lg-block">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @T["Account"]
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear me-2"></i> @T["ProfileSettings"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> @T["Logout"]
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Logout im Burger-Menü (mobil) -->
                    <li class="nav-item d-lg-none mt-2">
                        <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i> @T["Logout"]
                        </a>
                    </li>
                }
                else
                {
                    <!-- Desktop-Login-Button -->
                    <li class="nav-item ms-lg-2 d-none d-lg-block">
                        <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> @T["Login"]
                        </a>
                    </li>

                    <!-- Im Burger-Menü (mobil) nochmal als einfacher Link -->
                    <li class="nav-item d-lg-none mt-2">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> @T["Login"]
                        </a>
                    </li>
                }

                <!-- Theme Toggle: Desktop sichtbar rechts als Button -->
                <li class="nav-item d-none d-lg-block">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center js-theme-toggle"
                            aria-pressed="false"
                            aria-label="@T["ThemeToggleAria"]">
                        <i class="bi bi-moon-stars me-2 js-theme-icon"></i>
                        <span class="js-theme-text">@T["ThemeLight"]</span>
                    </button>
                </li>

                <!-- Theme Toggle: im Burger-Menü als Nav-Link-Style -->
                <li class="nav-item d-lg-none mt-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary w-100 d-flex align-items-center justify-content-center js-theme-toggle"
                            aria-pressed="false"
                            aria-label="@T["ThemeToggleAria"]">
                        <i class="bi bi-moon-stars me-2 js-theme-icon"></i>
                        <span class="js-theme-text">@T["ThemeLight"]</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</header>

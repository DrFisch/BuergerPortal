@model BuergerPortal.Web.Features.Antraege.Sperrmuell.ViewModels.SperrmuellStep2Vm
@using BuergerPortal.Web.Features.Antraege
@using BuergerPortal.Web.Features.Antraege.Sperrmuell.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer L
@inject IStringLocalizer<Leistungen> LK
@* Sperrmüll, Schritt 2 von 3 (2026-10-18): Abholadresse (aus der BundID vorgeschlagen), Mengen mit Stepper, Abholtag als
   Tages-Chips (nächste Werktage) oder freies Datum; als Entwurf speichern oder weiter zur Prüfung. Feldnamen wie bisher;
   "submit" (direkt einreichen) nimmt der Controller weiter an. *@
@{
    ViewData["Title"] = L["Title"];
    var leistung = Leistungen.Von(Leistungen.Sperrmuell)!;
    var schritte = new AntragSchritteVm([L["Step_Person"].Value, L["Step_Pickup"].Value, L["Step_Review"].Value], 2);
    var tage = SperrmuellStep2Vm.NaechsteWerktage(DateOnly.FromDateTime(DateTime.Today), 8);
    var ausBundId = ViewData["AusBundId"] is true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite ap-seite-schmal py-4 ap-farbe-success">
    <header class="ap-kopf">
        <span class="ap-symbol" aria-hidden="true"><i class="bi @leistung.Icon"></i></span>
        <div>
            <h1 class="h3 fw-bold">@LK["Sperrmuell_Titel"]</h1>
            <p class="text-body-secondary mb-0">@Model.AntragstellerName · @L["Number"] @Model.Id.ToString("N")[..8].ToUpperInvariant()</p>
        </div>
    </header>

    <partial name="_AntragSchritte" model="schritte" />

    <form asp-action="SperrmuellStep2" method="post" class="ap-karte p-3 p-md-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="AntragstellerName" value="@Model.AntragstellerName" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <fieldset class="mb-4">
            <legend class="h6 fw-bold mb-3">
                @L["Section_Address"]
                @if (ausBundId) { <span class="ap-bundid ms-1"><i class="bi bi-shield-check" aria-hidden="true"></i>BundID</span> }
            </legend>
            @if (ausBundId)
            {
                <p class="small text-body-secondary">@L["AddressFromBundId"]</p>
            }
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Strasse" class="form-label"></label>
                    <input asp-for="Strasse" class="form-control form-control-lg" autocomplete="street-address" />
                    <span asp-validation-for="Strasse" class="text-danger small"></span>
                </div>
                <div class="col-4">
                    <label asp-for="PLZ" class="form-label"></label>
                    <input asp-for="PLZ" class="form-control form-control-lg" inputmode="numeric" maxlength="5" autocomplete="postal-code" />
                    <span asp-validation-for="PLZ" class="text-danger small"></span>
                </div>
                <div class="col-8">
                    <label asp-for="Ort" class="form-label"></label>
                    <input asp-for="Ort" class="form-control form-control-lg" autocomplete="address-level2" />
                    <span asp-validation-for="Ort" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h6 fw-bold mb-1">@L["Section_Items"]</legend>
            <p class="small text-body-secondary mb-3">@L["Items_Hint"]</p>
            @foreach (var (feld, einheit, hilfe) in new[] { ("HolzKubikmeter", "m³", "Wood_Hint"), ("SonstigesKubikmeter", "m³", "Other_Hint"), ("Matratzen", L["Pieces"].Value, "Mattress_Hint") })
            {
                var wert = feld switch { "HolzKubikmeter" => Model.HolzKubikmeter, "SonstigesKubikmeter" => Model.SonstigesKubikmeter, _ => Model.Matratzen };
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 border-bottom">
                    <div>
                        <label for="@feld" class="fw-semibold d-block">@L[$"Label_{feld}"]</label>
                        <span class="small text-body-secondary">@L[hilfe]</span>
                    </div>
                    <div class="ap-stepper">
                        <button type="button" class="btn btn-outline-secondary" data-ap-minus data-ziel="@feld" aria-label="@L["Less", L[$"Label_{feld}"].Value]"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                        <input type="number" class="form-control" id="@feld" name="@feld" min="0" max="20" inputmode="numeric" value="@wert" />
                        <button type="button" class="btn btn-outline-secondary" data-ap-plus data-ziel="@feld" aria-label="@L["More", L[$"Label_{feld}"].Value]"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                        <span class="small text-body-secondary" style="min-width: 2.5rem;">@einheit</span>
                    </div>
                </div>
            }
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h6 fw-bold mb-1">@L["Section_Day"]</legend>
            <p class="small text-body-secondary mb-2">@L["Day_Hint"]</p>
            <div class="ap-tage" role="group" aria-label="@L["Day_Chips"]">
                @foreach (var tag in tage)
                {
                    var iso = tag.ToString("yyyy-MM-dd");
                    <button type="button" data-ap-tag="@iso" data-ziel="Wunschzeit"
                            aria-pressed="@(Model.Wunschzeit?.ToString("yyyy-MM-dd") == iso ? "true" : "false")">
                        <small>@tag.ToString("ddd")</small><strong>@tag.ToString("dd.MM.")</strong>
                    </button>
                }
            </div>
            <label for="Wunschzeit" class="form-label small">@L["Day_Other"]</label>
            <input type="date" class="form-control form-control-lg" id="Wunschzeit" name="Wunschzeit" style="max-width: 16rem;"
                   value="@Model.Wunschzeit?.ToString("yyyy-MM-dd")" min="@tage[0].ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Wunschzeit" class="text-danger small"></span>
        </fieldset>

        <div class="mb-4">
            <label asp-for="Hinweis" class="form-label fw-semibold"></label>
            <textarea asp-for="Hinweis" rows="3" class="form-control" placeholder="@L["Note_Placeholder"]"></textarea>
            <span asp-validation-for="Hinweis" class="text-danger small"></span>
        </div>

        <div class="ap-hinweis align-items-center">
            <i class="bi bi-cash-coin" aria-hidden="true"></i>
            <div>
                <div class="small text-body-secondary">@L["Fee_Label"]</div>
                <div class="fw-bold">@LK["Sperrmuell_Gebuehr"]</div>
            </div>
        </div>

        <div class="ap-aktionen">
            <button type="submit" name="submitAction" value="entwurf" class="btn btn-outline-secondary me-auto" id="entwurfSpeichern">
                <i class="bi bi-floppy" aria-hidden="true"></i> @L["SaveDraft"]
            </button>
            <button type="submit" name="submitAction" value="pruefen" class="btn btn-success btn-lg" id="weiter">
                @L["Next"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/antraege.js" asp-append-version="true"></script>
}

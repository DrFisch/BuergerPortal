@model BuergerPortal.Web.Features.Antraege.Sperrmuell.ViewModels.SperrmuellStep2Vm
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["SperrmuellStep2_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="wizard-steps mb-5">
                <div class="step done">
                    <div class="step-icon"><i class="bi bi-check-lg"></i></div>
                    <div class="step-label">@L["Sperrmuell_Step1_Label"]</div>
                </div>
                <div class="step-line active"></div>
                <div class="step active">
                    <div class="step-icon">2</div>
                    <div class="step-label">@L["Sperrmuell_Step2_Label"]</div>
                </div>
            </div>

            @if (TempData["AntragInfo"] is string info)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> @info
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-body-tertiary">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted small text-uppercase fw-bold mb-0" style="font-size: 0.65rem;">@L["SperrmuellStep2_Applicant"]</h6>
                            <div class="h5 mb-0 fw-bold">@Model.AntragstellerName</div>
                            <span class="text-secondary small">ID: #@Model.Id.ToString().Substring(0, 8)</span>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="SperrmuellStep2" method="post" class="vstack gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4"><i class="bi bi-geo-alt me-2 text-success"></i>Abholadresse</h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Strasse" class="form-control" placeholder="Straße" />
                                <label asp-for="Strasse"></label>
                                <span asp-validation-for="Strasse" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="PLZ" class="form-control" placeholder="PLZ" />
                                <label asp-for="PLZ"></label>
                                <span asp-validation-for="PLZ" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="Ort" class="form-control" placeholder="Ort" />
                                <label asp-for="Ort"></label>
                                <span asp-validation-for="Ort" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4"><i class="bi bi-box-seam me-2 text-success"></i>Mengen & Termin</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="HolzKubikmeter" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="HolzKubikmeter" class="form-control" type="number" min="0" />
                                <span class="input-group-text">m³</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SonstigesKubikmeter" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="SonstigesKubikmeter" class="form-control" type="number" min="0" />
                                <span class="input-group-text">m³</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Matratzen" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="Matratzen" class="form-control" type="number" min="0" />
                                <span class="input-group-text">Stk.</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Wunschzeit" class="form-label fw-bold small text-muted text-uppercase" style="font-size:0.7rem">@L["Sperrmuell_Date_Label"]</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-event text-success"></i></span>
                            <input asp-for="Wunschzeit" class="form-control border-start-0 ps-0" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        </div>
                        <div id="weekendNote" class="alert alert-warning mt-2 small py-2 d-none">
                            <i class="bi bi-info-circle me-2"></i> @L["Sperrmuell_Weekend_Hint"]
                        </div>
                        <span asp-validation-for="Wunschzeit" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Hinweis" class="form-label fw-bold small text-muted text-uppercase" style="font-size:0.7rem">@L["Sperrmuell_Note_Label"]</label>
                        <textarea asp-for="Hinweis" rows="3" class="form-control rounded-3" placeholder="@L["Sperrmuell_Note_Placeholder"]"></textarea>
                        <span asp-validation-for="Hinweis" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-2">
                    <a asp-action="Index" class="btn btn-link text-muted text-decoration-none fw-bold order-2 order-md-1">
                        <i class="bi bi-arrow-left me-1"></i> @L["Cancel"]
                    </a>

                    <button type="submit" name="submitAction" value="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm fw-bold order-1 order-md-2">
                        <i class="bi bi-truck me-2"></i> @L["Sperrmuell_Submit_Button"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .wizard-steps {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 80px;
        }

        .step-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--bs-secondary-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--bs-secondary-color);
            margin-bottom: 0.5rem;
        }

        .step.active .step-icon {
            background: var(--bs-success);
            color: white;
            box-shadow: 0 0 0 5px var(--bs-success-bg-subtle);
        }

        .step.done .step-icon {
            background: var(--bs-success);
            color: white;
        }

        .step-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--bs-secondary-color);
        }

        .step-line {
            flex: 0 1 100px;
            height: 2px;
            background: var(--bs-secondary-bg);
            margin-bottom: 1.5rem;
        }

            .step-line.active {
                background: var(--bs-success);
            }

        .form-floating > .form-control:focus {
            border-color: var(--bs-success);
            box-shadow: 0 0 0 0.25rem var(--bs-success-bg-subtle);
        }

        [data-bs-theme="dark"] .card {
            background-color: var(--bs-tertiary-bg);
        }

        .input-group-text {
            border-color: var(--bs-border-color);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            const dateInput = document.querySelector('input[name="Wunschzeit"]');
            const note = document.getElementById('weekendNote');

            if (dateInput) {
                dateInput.addEventListener('change', function() {
                    const date = new Date(this.value + 'T00:00:00');
                    const day = date.getDay();
                    if (day === 0 || day === 6) { // Sa oder So
                        note.classList.remove('d-none');
                        // Verschieben auf Montag
                        const nextMon = new Date(date);
                        nextMon.setDate(date.getDate() + (day === 0 ? 1 : 2));
                        this.value = nextMon.toISOString().split('T')[0];
                        setTimeout(() => note.classList.add('d-none'), 5000);
                    } else {
                        note.classList.add('d-none');
                    }
                });
            }
        })();
    </script>
}
@model BuergerPortal.Web.Features.Antraege.Sperrmuell.ViewModels.SperrmuellStep1Vm
@using BuergerPortal.Web.Features.Antraege
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer L
@inject IStringLocalizer<Leistungen> LK
@* Sperrmüll, Schritt 1 von 3 (2026-10-18): wer meldet an – aus der BundID vorbefüllt und so markiert. Feldnamen wie
   bisher (t_buerger, sperrmuell-einreichen.sh). *@
@{
    ViewData["Title"] = L["Title"];
    var leistung = Leistungen.Von(Leistungen.Sperrmuell)!;
    var ausBundId = ViewData["AusBundId"] is true;
    var schritte = new AntragSchritteVm([L["Step_Person"].Value, L["Step_Pickup"].Value, L["Step_Review"].Value], 1);
}
@section Styles {
    <link rel="stylesheet" href="~/css/antraege.css" asp-append-version="true" />
}

<div class="container ap-seite ap-seite-schmal py-4 ap-farbe-success">
    <header class="ap-kopf">
        <span class="ap-symbol" aria-hidden="true"><i class="bi @leistung.Icon"></i></span>
        <div>
            <h1 class="h3 fw-bold">@LK["Sperrmuell_Titel"]</h1>
            <ul class="ap-chips" aria-label="@L["Facts"]">
                <li class="ap-chip"><i class="bi bi-clock" aria-hidden="true"></i> @L["Minutes", leistung.DauerMinuten]</li>
                <li class="ap-chip ap-chip-ok"><i class="bi bi-shield-check" aria-hidden="true"></i> @L["Level", LK[$"Niveau_{leistung.Niveau}"]]</li>
                <li class="ap-chip"><i class="bi bi-cash-coin" aria-hidden="true"></i> @LK["Sperrmuell_GebuehrKurz"]</li>
            </ul>
        </div>
    </header>

    <partial name="_AntragSchritte" model="schritte" />

    @if (ausBundId)
    {
        <div class="ap-hinweis mb-3" role="status">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            <div>@L["PrefilledFromBundId"]</div>
        </div>
    }

    <form asp-action="SperrmuellStep1" method="post" class="ap-karte p-3 p-md-4" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <fieldset class="mb-4">
            <legend class="h6 fw-bold mb-3">@L["Section_Person"]</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Vorname" class="form-label"></label>
                    @if (ausBundId) { <span class="ap-bundid ms-1"><i class="bi bi-shield-check" aria-hidden="true"></i>BundID</span> }
                    <input asp-for="Vorname" class="form-control form-control-lg" autocomplete="given-name" />
                    <span asp-validation-for="Vorname" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Nachname" class="form-label"></label>
                    @if (ausBundId) { <span class="ap-bundid ms-1"><i class="bi bi-shield-check" aria-hidden="true"></i>BundID</span> }
                    <input asp-for="Nachname" class="form-control form-control-lg" autocomplete="family-name" />
                    <span asp-validation-for="Nachname" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Geburtsdatum" class="form-label"></label>
                    @if (ausBundId && Model.Geburtsdatum is not null) { <span class="ap-bundid ms-1"><i class="bi bi-shield-check" aria-hidden="true"></i>BundID</span> }
                    <input asp-for="Geburtsdatum" class="form-control form-control-lg" type="date" autocomplete="bday" />
                    <span asp-validation-for="Geburtsdatum" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend class="h6 fw-bold mb-1">@L["Section_Contact"]</legend>
            <p class="small text-body-secondary mb-3">@L["Contact_Hint"]</p>
            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="Email" class="form-label"></label>
                    @if (ausBundId && !string.IsNullOrEmpty(Model.Email)) { <span class="ap-bundid ms-1"><i class="bi bi-shield-check" aria-hidden="true"></i>BundID</span> }
                    <input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control form-control-lg" type="tel" inputmode="tel" autocomplete="tel" />
                    <span asp-validation-for="Telefon" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <div class="ap-aktionen">
            <a asp-controller="Antraege" asp-action="Index" class="btn btn-link me-auto">@L["Cancel"]</a>
            <button type="submit" class="btn btn-success btn-lg" id="weiter">
                @L["Next"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
